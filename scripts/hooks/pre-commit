#!/usr/bin/env bash
# fathomdb-tracked-hook: scripts/hooks (managed by scripts/install-hooks.sh)
# pre-commit: fast format/lint checks on staged files only.
# Heavy gates (clippy, typecheck, tests) run in pre-push via agent-verify.sh.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# TC-88 — a ledger and its `.seq` sidecar cannot be committed apart.
#
# FIRST, and deliberately not behind the `-z "$STAGED"` early exit below: this
# gate reasons about the INDEX, and it must run before any formatter touches
# anything. It exits 0 immediately when the commit stages no ledger path, so it
# costs unrelated commits nothing.
#
# WHY IT IS HERE AT ALL. `ledgerwrite.py` writes `<ledger>.jsonl` AND a sibling
# `<ledger>.jsonl.seq`; `git add <ledger>.jsonl` does not imply the sidecar, and
# nothing warned. Two commits in one session (41a81c17, 3e660f95) stranded it,
# which breaks `preflight --landing` on main FOR THE NEXT AGENT while the author
# sees nothing wrong — the worktree on their machine is consistent, and that is
# exactly why the existing worktree-reading gates could not catch it. TC-88 rules
# out fixing this with a "remember the sidecar" note.
if [ -x scripts/check-staged-ledger-sidecars.sh ]; then
  scripts/check-staged-ledger-sidecars.sh
elif [ -f scripts/check-staged-ledger-sidecars.sh ]; then
  bash scripts/check-staged-ledger-sidecars.sh
fi

# TC-92 — a requirement id must have DESIGN COVERAGE at the moment it is minted.
#
# Same shape as the TC-88 gate above, and for the same reason: it reasons about
# the INDEX, and `--staged-only` makes it exit 0 immediately unless the commit
# stages a `dev/plans/release-state-*.json` or a path under `dev/design/` — the
# two places an id gets minted or its design of record moves. Unrelated commits
# pay one `git diff --cached` and nothing else.
#
# WHY THE HOOK AND NOT THE LANDING GATE. `commission-manifest.sh 0.8.20 22`
# hard-failed with "ZERO design docs matched … (tokens: TC-67, TC-68, R-20-VC)"
# even though the design of record existed for every leg — the ids were minted
# long after those documents were written, so a token scan cannot see a
# dependency that runs backward in time. TC-92 names the remedy as a back-link
# "at exactly the moment the knowledge exists", and this commit is that moment.
# It is deliberately NOT in `preflight.sh --landing`: every check there is paired
# with a mirrored CI job, and this one has none.
if [ -x scripts/check-design-refs.sh ]; then
  scripts/check-design-refs.sh --staged-only
elif [ -f scripts/check-design-refs.sh ]; then
  bash scripts/check-design-refs.sh --staged-only
fi

# --diff-filter=ACMR excludes deletions so tools don't try to read missing files.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
  exit 0
fi

# Rust: cargo fmt --check (whole workspace; rustfmt is context-sensitive).
if echo "$STAGED" | grep -qE '\.rs$|Cargo\.toml$'; then
  echo "[pre-commit] cargo fmt --check"
  cargo fmt --all --check
fi

# Python: ruff check on staged .py files. Prefer .venv/bin/ruff.
if echo "$STAGED" | grep -qE '\.py$'; then
  ruff_bin=""
  if [ -x .venv/bin/ruff ]; then
    ruff_bin=".venv/bin/ruff"
  elif command -v ruff >/dev/null 2>&1; then
    ruff_bin="$(command -v ruff)"
  fi
  if [ -n "$ruff_bin" ]; then
    echo "[pre-commit] ruff check (staged)"
    # shellcheck disable=SC2086
    PYFILES=$(echo "$STAGED" | grep '\.py$' | tr '\n' ' ')
    $ruff_bin check $PYFILES
  else
    echo "[pre-commit] skipping ruff (not installed; run scripts/bootstrap.sh)"
  fi
fi

# Markdown: AST-guarded auto-fix on staged *.md, then enforce markdownlint-clean.
# scripts/md-safe-fix.sh runs `markdownlint-cli2 --fix` but reverts (and blocks) any fix that
# changes meaning — see dev/tools/md-fix-corruption-ledger.md. prettier is intentionally not used.
if echo "$STAGED" | grep -qE '\.md$'; then
  echo "[pre-commit] md-safe-fix (AST-guarded markdownlint --fix on staged .md)"
  scripts/md-safe-fix.sh
  # Enforce structural cleanliness of the staged markdown (catches non-auto-fixable findings
  # like MD040 bare fences). markdownlint-cli2 ignores file args (it globs the whole repo from
  # its config), so run it once and match its findings against the staged .md set.
  for c in ./node_modules/.bin/markdownlint-cli2 \
           /home/coreyt/projects/fathomdb/node_modules/.bin/markdownlint-cli2; do
    [ -x "$c" ] || continue
    ml_out="$("$c" 2>&1 || true)"
    bad=""
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if printf '%s\n' "$ml_out" | grep -qE "^$f:[0-9]"; then bad="$bad $f"; fi
    done < <(echo "$STAGED" | grep '\.md$')
    if [ -n "$bad" ]; then
      echo "[pre-commit] markdownlint findings in staged markdown:$bad" >&2
      echo "[pre-commit] resolve via scripts/md-safe-fix.sh (auto) or by hand, then re-stage." >&2
      exit 1
    fi
    break
  done
fi
