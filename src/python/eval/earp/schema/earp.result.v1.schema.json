{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "earp.result.v1",
  "title": "EARP run sidecar (earp.result.v1)",
  "description": "The versioned EARP sidecar. experiments/_lib owns record.json / config.resolved.yaml / metrics.json and its Record schema is closed (unknown AND missing keys raise), so EARP state lives here rather than overloading the shared record. Staged and validated BEFORE the shared record is materialized and the index appended last.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "campaign",
    "verdict",
    "scenario",
    "witnesses",
    "blockers"
  ],
  "properties": {
    "schema_version": {
      "const": "earp.result.v1"
    },
    "run_id": {
      "type": "string",
      "description": "Derived via _lib.make_run_id BEFORE staging, so write_record recomputes the identical id. Minute-resolution, so a collision with a differing sidecar is refused."
    },
    "campaign": {
      "enum": [
        "characterization",
        "comparison",
        "sweep",
        "replay",
        "diagnostic"
      ]
    },
    "verdict": {
      "enum": [
        "complete",
        "blocked",
        "failed"
      ],
      "description": "Pinned tokens. Record.verdict is an untyped str, so the vocabulary is fixed here to stop 'blocked' being spelled three ways."
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_sha256",
        "query_call"
      ],
      "properties": {
        "config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "query_call": {
          "type": "string"
        },
        "retrieval_mode": {
          "enum": [
            "fts_only",
            "vector_only",
            "hybrid"
          ]
        },
        "fanout_used": {
          "type": "integer",
          "description": "The public result limit in effect for the run (0.8.22 Slice 18), recorded with every number per IR-B (c); it bounds visible cardinality in every mode, while the engine's internal hybrid/vector fanout -- max(limit, TOP_K_BIT_CANDIDATES) -- is not caller-visible. Cutover (S6a): before S6a this recorded the engine default in effect (always 10); from S6a it records the requested public limit. A rename to result_limit was considered and declined to avoid a version bump; the two readings coincide on every pre-S6a sidecar, all of which used ladder (5, 10) with the default fanout of 10."
        },
        "engine": {
          "type": "object"
        },
        "projections": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "RETIRED IN PLACE (S7): never written by any slice. Projection state is owned by `projection_witnesses`; this slot is kept unwritten only so pre-S7 validators keep working -- removing it would be the sole breaking edit of the slice."
        },
        "projection_witnesses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "open_report"
          ],
          "description": "S7. The three projection-state signals, each from its OWN API under its own name; never interchangeable, never converted into an empty retrieval result. `configure_delta` and `readiness` are ABSENT (not empty) for a projection-less scenario, so a reader can distinguish 'not declared' from 'not captured'.",
          "properties": {
            "open_report": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dense_disabled",
                "dense_disabled_reason",
                "query_backend",
                "refusal_count"
              ],
              "description": "From open_report() at open time; refusal_count from Engine.vector_equivalence_refusal_count(), read by the runner at capture time.",
              "properties": {
                "dense_disabled": {
                  "type": "boolean"
                },
                "dense_disabled_reason": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "query_backend": {
                  "type": "string"
                },
                "refusal_count": {
                  "type": "integer"
                }
              }
            },
            "configure_delta": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "built",
                "dropped",
                "deferred",
                "unchanged",
                "vector_unsupported_kinds"
              ],
              "description": "The ProjectionDelta exactly as configure_projections returned it. built/deferred are NON-DISJOINT: a both-sub-target spec appears in both, so 'in built' must never be read as 'fully built' -- the dense portion keys on deferred.",
              "properties": {
                "built": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dropped": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "deferred": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "unchanged": {
                  "type": "boolean"
                },
                "vector_unsupported_kinds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "readiness": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "ready",
                  "embedding",
                  "not_declared"
                ]
              },
              "description": "Declared projection name -> readiness, from polling read.projections(). None never appears: not_declared is derived from the spec's own vector flag and occurs only for specs without a vector sub-target."
            }
          }
        }
      }
    },
    "corpus": {
      "$ref": "#/$defs/corpus_identity"
    },
    "gold": {
      "$ref": "#/$defs/gold_identity"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "per_k": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/k_aggregate"
          },
          "description": "Keyed by K as a string."
        },
        "document_metrics": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metric_value"
          }
        },
        "negative_class": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "n": {
              "type": "integer"
            },
            "abstention_correct": {
              "type": "integer"
            },
            "abstention_rate": {
              "$ref": "#/$defs/metric_value"
            }
          },
          "description": "Negative queries are scored by abstention correctness, never recall."
        }
      }
    },
    "decision_rule": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metric",
            "direction",
            "threshold",
            "result"
          ],
          "properties": {
            "metric": {
              "type": "string"
            },
            "direction": {
              "enum": [
                "greater",
                "less"
              ]
            },
            "threshold": {
              "type": "number"
            },
            "result": {
              "enum": [
                "pass",
                "fail",
                "withheld",
                "underpowered"
              ]
            }
          }
        }
      ]
    },
    "comparison": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "n",
            "effect",
            "ci_low",
            "ci_high",
            "ci_method",
            "seed"
          ],
          "properties": {
            "n": {
              "type": "integer"
            },
            "effect": {
              "type": "number"
            },
            "ci_low": {
              "type": "number"
            },
            "ci_high": {
              "type": "number"
            },
            "ci_method": {
              "enum": [
                "percentile_bootstrap",
                "paired_bootstrap"
              ]
            },
            "seed": {
              "type": "integer"
            },
            "changed_knobs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "underpowered": {
              "type": "boolean",
              "description": "n < min_n, exactly. Meaningful only against the declared power rule."
            },
            "metric": {
              "type": "string",
              "description": "S8. The paired effect metric, fixed before the first retrieval."
            },
            "exclusions": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              },
              "description": "S8. Reason -> count for gold queries excluded from the paired set (error, metric_inapplicable). n + sum(exclusions) reconciles exactly with the gold query count. Abstention correctness is a SCORED outcome, never an exclusion."
            }
          }
        }
      ]
    },
    "arms": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/arm_result"
      },
      "description": "S8. Per-arm record for comparison/sweep campaigns, keyed by arm name. When present it is the authoritative per-arm record; the top-level scenario/metrics blocks are written from the control arm (arms[0]). This is where sweep outcomes and a blocked comparison's surviving-arm partials live."
    },
    "witnesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/witness"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/blocker"
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_usd",
        "cumulative_spent_usd",
        "estimated_usd"
      ],
      "properties": {
        "authorized_usd": {
          "type": "number"
        },
        "cumulative_spent_usd": {
          "type": "number"
        },
        "estimated_usd": {
          "type": "number"
        },
        "actual_usd": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "open_report": {
          "type": "object"
        },
        "embedder_identity": {
          "type": [
            "object",
            "null"
          ]
        },
        "embedder_download_ms": {
          "type": [
            "integer",
            "null"
          ]
        },
        "embedder_events": {
          "type": "array"
        },
        "git_sha": {
          "type": "string"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "per_query_path": {
      "type": "string",
      "description": "Relative path to the earp.per-query.v1 JSONL sidecar."
    }
  },
  "$defs": {
    "arm_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_call",
        "retrieval_mode",
        "fanout_used",
        "arm_config_sha256",
        "blockers"
      ],
      "description": "One arm's identity, metrics, and blockers (S8).",
      "properties": {
        "query_call": {
          "type": "string"
        },
        "retrieval_mode": {
          "enum": [
            "fts_only",
            "vector_only",
            "hybrid"
          ]
        },
        "fanout_used": {
          "type": "integer",
          "description": "The arm's resolved public result limit."
        },
        "arm_config_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Hash of the arm's SYNTHESIZED single-scenario document -- a supplementary label, never the run identity. The run identity is the whole-document config_sha256 in the scenario block, which covers both arms."
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "per_k": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/k_aggregate"
              }
            },
            "document_metrics": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/metric_value"
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          }
        }
      }
    },
    "metric_value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "description": "A metric slot that can honestly be empty. value is null exactly when status is not_applicable; an inapplicable metric is never reported as zero.",
      "properties": {
        "status": {
          "enum": [
            "emitted",
            "not_applicable"
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "k_aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n",
        "strict_evidence_recall",
        "graded_evidence_recall"
      ],
      "properties": {
        "n": {
          "type": "integer"
        },
        "strict_evidence_recall": {
          "$ref": "#/$defs/metric_value"
        },
        "graded_evidence_recall": {
          "$ref": "#/$defs/metric_value"
        },
        "supporting_coverage": {
          "$ref": "#/$defs/metric_value",
          "description": "Ported faithfully: the reference returns Option<f64> and serialises the unavailable case as null, which maps to not_applicable."
        },
        "supporting_query_n": {
          "type": "integer",
          "description": "Denominator for supporting_coverage -- support-bearing queries only, not all queries. Carried so an empty denominator is never mistaken for a genuine zero."
        },
        "per_class": {
          "type": "object",
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "call_path",
        "status"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "enum": [
            "open_report",
            "read_projections",
            "projection_delta",
            "search_result",
            "store_query",
            "write_receipt",
            "filesystem"
          ],
          "description": "Not interchangeable: vector_dense_readiness comes only from read_projections, vector_unsupported_kinds only from projection_delta, dense_disabled only from open_report."
        },
        "call_path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "absent",
            "error"
          ]
        },
        "value": {},
        "captured_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "stage"
      ],
      "properties": {
        "code": {
          "enum": [
            "corpus_root_absent",
            "gold_missing",
            "gold_hash_mismatch",
            "gold_malformed",
            "snapshot_unreadable",
            "gold_corpus_mismatch",
            "gold_stale_qrels_version",
            "metric_not_measurable",
            "dense_readiness_timeout",
            "dense_disabled",
            "vector_unsupported_kinds",
            "embedder_fetched",
            "budget_exceeded",
            "run_id_collision",
            "config_unknown_key",
            "config_missing_key",
            "config_invalid_value",
            "config_inapplicable_knob",
            "config_unused_key",
            "config_campaign_inexpressible",
            "fixture_missing",
            "fixture_invalid"
          ]
        },
        "message": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "detail": {
          "type": "object"
        }
      }
    },
    "corpus_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_path",
        "snapshot_sha256"
      ],
      "properties": {
        "snapshot_path": {
          "type": "string"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manifest_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_root": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "gold_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "corpus_hash",
        "qrels_version",
        "query_count"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "corpus_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qrels_version": {
          "type": "string"
        },
        "query_count": {
          "type": "integer"
        },
        "tier": {
          "type": "string"
        }
      }
    }
  }
}
