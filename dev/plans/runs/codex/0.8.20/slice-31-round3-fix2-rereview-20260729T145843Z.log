   144	        "run_survey() did not honour the INJECTED tier map — these fixture"
   145	        f" manifests were not excluded: {missing}"
   146	    )
   147	
   148	    with pytest.raises(tiers.UntieredManifestError) as excinfo:
   149	        survey_mod.run_survey(
   150	            REPO_ROOT, published=registry.OfflineSource(), tier_map=stripped
   151	        )
   152	    assert any(path in str(excinfo.value) for path in fixtures), (
   153	        "run_survey() with the fixture rule REMOVED must fail loudly, naming a"
   154	        " fixture manifest (REQ-4). If it excluded them anyway, the exclusion"
   155	        " lives in CODE rather than in tiers.toml, which is exactly what REQ-5"
   156	        f" forbids. Error was: {excinfo.value}"
   157	    )
   158	
   159	
   160	def test_untiered_manifest_raises_untiered_manifest_error() -> None:
   161	    """AC-SBOM-07.
   162	
   163	    A tracked manifest matched by NO rule is a hard error naming the path.
   164	    There is deliberately no catch-all rule: a default would turn "somebody
   165	    added a manifest and nobody classified it" — the event this tool exists to
   166	    catch — into a silent mis-tag.
   167	    """
   168	    tiers = require(
   169	        "sbom_survey.tiers",
   170	        "AC-SBOM-07",
   171	        "TierMap.classify() must raise UntieredManifestError NAMING THE PATH for"
   172	        " a tracked manifest that matches no rule. It must never return a null"
   173	        " tier, never fall back to a default tier, and never drop the manifest.",
   174	    )
   175	
   176	    tier_map = tiers.TierMap(
   177	        [tiers.TierRule(prefix="src/rust/crates/", action="tier", tier="shipped")]
   178	    )
   179	    with pytest.raises(tiers.UntieredManifestError) as excinfo:
   180	        tier_map.classify("some/brand/new/Cargo.toml")
   181	    assert "some/brand/new/Cargo.toml" in str(excinfo.value), (
   182	        "the error must name the offending path so the fix is obvious; got: "
   183	        f"{excinfo.value}"
   184	    )
   185	
   186	
   187	def test_tier_map_covers_every_discovered_manifest() -> None:
   188	    """AC-SBOM-08.
   189	
   190	    The repository's own tiers.toml must classify every path discovery
   390	[[rule]]
   391	prefix = "scripts/sbom-survey/"
   392	action = "tier"
   393	tier   = "dev-tooling"
   394	note   = "this tool surveys itself"
   395	```
   396	
   397	**Matching is longest-prefix-wins, not first-match-wins.** File order is then irrelevant, so
   398	reordering the rules can never change the answer — a property worth having in a file that will be
   399	edited by whoever adds the next manifest. Duplicate prefixes are a load-time error.
   400	
   401	**There is deliberately NO catch-all / default rule.** A tracked manifest matched by no rule raises
   402	`UntieredManifestError(path)`; `run_survey` propagates it and the CLI exits `2` with the path on
   403	stderr. A default would convert "somebody added a manifest and nobody classified it" — the exact
   404	event this tool exists to catch — into a silent mis-tag. This is `AC-SBOM-07` (unit) and
   405	`AC-SBOM-21` (CLI), and it is the failure mode that gets its own named test per §5 item 3.

codex
The spec adds a concrete tiering invariant that the RED acceptance tests do not enforce, leaving an implementation path that violates the documented contract while passing the suite.

Review comment:

- [P2] Add an oracle for longest-prefix tier matching — /home/coreyt/projects/fathomdb-worktrees/slice-31-sbom-spec/dev/design/0.8.20-slice-31-sbom-survey-tool.md:397-399
  Because the spec freezes `TierMap` matching as longest-prefix-wins and order-independent, the acceptance suite needs to exercise an overlapping-rule case. As written, Slice 32 can implement first-match-wins and still pass whenever `tiers.toml` happens to list the more specific rule first, so reordering the tracked data file later can silently retier manifests despite this paragraph explicitly promising it cannot.
