 15489	    hash_fingerprint_field(&mut hasher, &VECTOR_EQUIVALENCE_P1_FLIP_FLOOR.to_le_bytes());
 15490	    hash_fingerprint_field(&mut hasher, &VECTOR_EQUIVALENCE_L2_EPSILON.to_le_bytes());
 15491	    hash_fingerprint_field(&mut hasher, &(stored.len() as u64).to_le_bytes());
 15492	    for (ordinal, probe_text, reference_vec, name, revision, dim) in stored {
 15493	        hash_fingerprint_field(&mut hasher, &ordinal.to_le_bytes());
 15494	        hash_fingerprint_field(&mut hasher, probe_text.as_bytes());
 15495	        hash_fingerprint_field(&mut hasher, reference_vec);
 15496	        hash_fingerprint_field(&mut hasher, name.as_bytes());
 15497	        hash_fingerprint_field(&mut hasher, revision.as_bytes());
 15498	        hash_fingerprint_field(&mut hasher, &dim.to_le_bytes());
 15499	    }
 15500	    hasher.finalize().iter().map(|b| format!("{b:02x}")).collect()
 15501	}
 15502	
 15503	/// 0.8.20 Slice 22 (TC-68) — is `fingerprint` the fingerprint under which the
 15504	/// probe last RAN and PASSED on this workspace?
 15505	///
 15506	/// Fail-SAFE by construction (R-VEQ-4): **every** failure mode answers `false`,
 15507	/// which means "run the probe". A missing `_fathomdb_open_state` table, an absent
 15508	/// row, a non-TEXT value, a truncated or garbled value, any SQL error — none of
 15509	/// them can be mistaken for a pass. The only `true` is an exact match against a
 15510	/// value this engine wrote after a verification it performed itself.
 15511	fn probe_verification_is_cached(connection: &Connection, fingerprint: &str) -> bool {
 15512	    connection
 15513	        .query_row(
 15514	            "SELECT value FROM _fathomdb_open_state WHERE key = ?1",
 15515	            [VECTOR_EQUIVALENCE_VERDICT_CACHE_KEY],
 15516	            |row| row.get::<_, String>(0),
 15517	        )
 15518	        .map(|cached| cached == fingerprint)
 15519	        .unwrap_or(false)
 15520	}
 15521	
 15522	/// 0.8.20 Slice 22 (TC-68) — record that the probe RAN and PASSED under
 15523	/// `fingerprint`.
 15524	///
 15525	/// A write failure is deliberately SWALLOWED rather than turned into a verdict
 15526	/// failure. The arm has just been verified, so refusing dense because a marker
 15527	/// could not be persisted (read-only file, disk full) would be a false refusal;
 15528	/// and the consequence of the missing marker is simply that the next open re-runs
 15529	/// the probe — more work, never less. That is the fail-safe direction.
 15530	fn record_probe_verification(connection: &Connection, fingerprint: &str) {
 15531	    let _ = connection.execute(
 15532	        "INSERT INTO _fathomdb_open_state(key, value) VALUES(?1, ?2)
 15533	         ON CONFLICT(key) DO UPDATE SET value = excluded.value",
 15534	        params![VECTOR_EQUIVALENCE_VERDICT_CACHE_KEY, fingerprint],
 15535	    );
 15536	}
 15537	
 15538	/// 0.8.20 Slice 22 (TC-68) — drop any cached verdict.
 15539	///
 15540	/// Called on EVERY failure path of the check, so a workspace that could not be
 15541	/// verified never carries a marker a later open might match. A failing verdict is
 15542	/// therefore never cached: the probe re-runs each open until it passes again.
 15543	fn clear_probe_verification(connection: &Connection) {
 15544	    let _ = connection.execute(
 15545	        "DELETE FROM _fathomdb_open_state WHERE key = ?1",
 15546	        [VECTOR_EQUIVALENCE_VERDICT_CACHE_KEY],
 15547	    );
 15548	}
 15549	
 15550	/// 0.8.18 Slice 5 — SUBSEQUENT open: re-embed the 45 probes and assert BOTH
 15551	/// dense-pipeline representations against the stored references — **(P1)** the
 15552	/// mean-centered `embedding_bin` sign-flip count (floor 0, exact) and **(P2)** the
 15553	/// un-centered Phase-2 L2 (within `VECTOR_EQUIVALENCE_L2_EPSILON`).
 15554	///
 15555	/// 0.8.20 Slice 22 (TC-68) — this wrapper adds the failure half of the verdict
 15556	/// cache: ANY `Err` from the inner check drops the cached marker, so a workspace
 15557	/// that could not be verified never leaves a stale "verified" marker behind for a
 15558	/// later open to match. (A failing verdict is never *written*; this also clears a
 15559	/// marker left by an earlier, passing open whose fingerprint has since changed.)
 15560	fn probe_check_against_baseline(
 15561	    connection: &Connection,
 15562	    embedder: &dyn Embedder,
 15563	    identity: &EmbedderIdentity,
 15564	    mean_pinned: bool,
 15565	    probes: &[&str],
 15566	) -> Result<(), String> {
 15567	    let outcome =
 15568	        probe_check_against_baseline_inner(connection, embedder, identity, mean_pinned, probes);
 15569	    if outcome.is_err() {
 15570	        clear_probe_verification(connection);
 15571	    }
 15572	    outcome
 15573	}
 15574	
 15575	/// 0.8.18 Slice 5 — the check proper. Fail-SAFE (fix-1 DEFECT #1): a probe embed
 15576	/// that panics/errors/returns wrong-dim, a malformed/missing reference row, an
 15577	/// unreadable pinned mean, or a `vec_quantize_binary`/L2 SQL failure each ⇒ `Err`
 15578	/// (cannot verify ⇒ refuse dense), never a silent skip-and-serve.
 15579	///
 15580	/// fix-2 (DEFECT #1 residual): BEFORE the divergence check, the STORED baseline is
 15581	/// validated to be EXACTLY the committed probe set — the expected row count, a
 15582	/// contiguous 0-based `probe_ordinal` per committed probe, each `probe_text` equal
 15583	/// to the committed fixture text at that ordinal, each `reference_vec` a well-formed
 15584	/// `4 * dim` f32 blob, and the stored embedder identity/dim matching the current
 15585	/// one. This closes the partial-baseline / external-tamper fail-open (a 44-of-45
 15586	/// table, or a re-attributed/mangled row, previously verified only the rows present
 15587	/// or re-embedded a tampered `probe_text` against itself). Any mismatch ⇒ `Err`.
 15588	///
 15589	/// 0.8.20 Slice 22 (TC-68) — the 45 re-embeds are CACHED against
 15590	/// [`probe_verification_fingerprint`]. Note WHERE the cache check sits: after the
 15591	/// mean resolution and after the fix-2 completeness validation, before the
 15592	/// re-embed loop. That split is deliberate — everything cheap keeps running on
 15593	/// EVERY open (so a short, re-attributed, mangled or fixture-mismatched baseline
 15594	/// still fails closed immediately), and only the expensive part, the 45 model
 15595	/// invocations, is skipped. The residual this buys is recorded in
 15596	/// `dev/design/0.8.20-tc68-equivalence-probe-fingerprint-cache.md`.
 15597	fn probe_check_against_baseline_inner(
 15598	    connection: &Connection,
 15599	    embedder: &dyn Embedder,
 15600	    identity: &EmbedderIdentity,
 15601	    mean_pinned: bool,
 15602	    probes: &[&str],
 15603	) -> Result<(), String> {
 15604	    let dimension = identity.dimension as usize;
 15605	
 15606	    // Resolve the live mean. Fail-SAFE: if centering is required + pinned but the
 15607	    // mean cannot be read, we cannot reproduce `embedding_bin` ⇒ refuse (P1
 15608	    // un-verifiable). NoopEmbedder / no-pin ⇒ un-centered on BOTH sides (R-VEQ-3c).
 15609	    let mean_vec = if identity_requires_mean_centering(identity) && mean_pinned {
 15610	        match read_pinned_mean_vec(connection, identity.dimension) {
 15611	            Ok(Some(mean)) => Some(mean),
 15612	            Ok(None) => {
 15613	                return Err("mean-centering is required and pinned but mean_vec is absent; \
 15614	                     cannot verify P1 (dense arm refused)"
 15615	                    .to_string());
 15616	            }
 15617	            Err(_) => {
 15618	                return Err(
 15619	                    "could not read the pinned mean_vec; cannot verify P1 (dense arm refused)"
 15620	                        .to_string(),
 15621	                );
 15622	            }
 15623	        }
 15624	    } else {
 15625	        None
 15626	    };
 15627	
 15628	    let mut stmt = connection
 15629	        .prepare(
 15630	            "SELECT probe_ordinal, probe_text, reference_vec, embedder_name, embedder_revision, dim \
 15631	             FROM _fathomdb_embed_probe ORDER BY probe_ordinal",
 15632	        )
 15633	        .map_err(|e| format!("could not read the stored probe references: {e}; cannot verify"))?;
 15634	    let stored: Vec<StoredProbeRow> = stmt
 15635	        .query_map([], |row| {
 15636	            Ok((
 15637	                row.get::<_, i64>(0)?,
 15638	                row.get::<_, String>(1)?,
 15639	                row.get::<_, Vec<u8>>(2)?,
 15640	                row.get::<_, String>(3)?,
 15641	                row.get::<_, String>(4)?,
 15642	                row.get::<_, i64>(5)?,
 15643	            ))
 15644	        })
 15645	        .and_then(|rows| rows.collect::<rusqlite::Result<Vec<_>>>())
 15646	        .map_err(|e| format!("could not read the stored probe references: {e}; cannot verify"))?;
 15647	
 15648	    // fix-2 (DEFECT #1 residual) — COMPLETENESS validation of the STORED baseline.
 15649	    // `COUNT(*) > 0` is NOT proof of a complete, trustworthy baseline: a partially
 15650	    // populated or externally-tampered probe table (44 of 45 rows, a gap/dupe in the
 15651	    // ordinals, a mangled reference blob, a mismatched probe_text, or a foreign
 15652	    // embedder identity) is UNVERIFIABLE stored state. The prior code re-embedded
 15653	    // the STORED probe_text and compared it to its OWN reference, so a tampered
 15654	    // probe_text verified against itself and a short table verified only the rows
 15655	    // present — both fail-OPEN. Atomic population stops the ENGINE from writing a
 15656	    // partial set; this closes external corruption, a manual edit, and a future
 15657	    // migration bug the engine did not author. Any mismatch ⇒ fail CLOSED (dense
 15658	    // refused); the text-only/FTS path still serves. The stored baseline must be
 15659	    // EXACTLY the committed probe set, in order, under the current identity.
 15660	    if stored.len() != probes.len() {
 15661	        return Err(format!(
 15662	            "the probe reference table has {} rows but the committed fixture defines {}; \
 15663	             the stored baseline is incomplete or corrupt — cannot verify the dense arm (refused)",
 15664	            stored.len(),
 15665	            probes.len()
 15666	        ));
 15667	    }
 15668	    for (idx, (ordinal, probe_text, ref_blob, name, revision, dim)) in stored.iter().enumerate() {
 15669	        // Contiguous 0-based ordinals, one per committed probe (no gaps/dupes).
 15670	        if *ordinal != idx as i64 {
 15671	            return Err(format!(
 15672	                "probe reference ordinals are non-contiguous (row {idx} carries ordinal {ordinal}); \
 15673	                 the stored baseline is corrupt — cannot verify the dense arm (refused)"
 15674	            ));
 15675	        }
 15676	        // The stored text MUST be the committed fixture text at this ordinal —
 15677	        // otherwise a tampered probe_text re-embeds and verifies against ITSELF,
 15678	        // masking drift (the exact fail-open this fix closes).
 15679	        if probe_text != probes[idx] {
 15680	            return Err(format!(
 15681	                "probe reference {ordinal} text does not match the committed fixture; \
 15682	                 the stored baseline is tampered or corrupt — cannot verify the dense arm (refused)"
 15683	            ));
 15684	        }
 15685	        // Well-formed f32[dim] reference (4*dim little-endian bytes).
 15686	        if ref_blob.len() != dimension * 4 {
 15687	            return Err(format!(
 15688	                "probe reference {ordinal} is malformed (len {} != {}); \
 15689	                 cannot verify the dense arm (refused)",
 15690	                ref_blob.len(),
 15691	                dimension * 4
 15692	            ));
 15693	        }
 15694	        // The stored embedder identity/dim must match the CURRENT expected identity
 15695	        // (defence-in-depth beyond `check_embedder_profile`: catches a baseline row
 15696	        // re-attributed to a foreign embedder by external edit/migration).
 15697	        if *dim != identity.dimension as i64
 15698	            || name != &identity.name
 15699	            || revision != &identity.revision
 15700	        {
 15701	            return Err(format!(
 15702	                "probe reference {ordinal} was captured under embedder {name}/{revision}/dim={dim} \
 15703	                 but the current embedder is {}/{}/dim={}; the stored baseline does not match — \
 15704	                 cannot verify the dense arm (refused)",
 15705	                identity.name, identity.revision, identity.dimension
 15706	            ));
 15707	        }
 15708	    }
 15709	
 15710	    // 0.8.20 Slice 22 (TC-68) — the CACHE gate. Everything above this line ran on
 15711	    // this open and still fails closed; everything below it is the 45 model
 15712	    // invocations that made `Engine::open` cost a flat 45 embeds FOREVER (measured
 15713	    // at `94bb33ef`: 0 with no enrolled kind, 90 on the one-time population open,
 15714	    // 45 on every open thereafter — independent of the enrolled-kind count, since
 15715	    // the probe gate is an `EXISTS` and the body never iterates kinds).
 15716	    //
 15717	    // If the probe already RAN and PASSED under this exact fingerprint, re-running
 15718	    // it is a pure re-computation of a known answer, so the verdict is reused.
 15719	    // Fail-SAFE: `probe_verification_is_cached` answers `false` for every failure
 15720	    // mode — missing table, absent row, garbled value, SQL error — so an
 15721	    // unreadable cache RUNS the probe, it never short-circuits to trusting it.
 15722	    let fingerprint = probe_verification_fingerprint(identity, mean_vec.as_deref(), &stored);
 15723	    if probe_verification_is_cached(connection, &fingerprint) {
 15724	        return Ok(());
 15725	    }
 15726	
 15727	    let mut total_flips: u64 = 0;
 15728	    let mut max_l2: f32 = 0.0;
 15729	    let mut worst_probe: Option<String> = None;
 15730	
 15731	    for (ordinal, probe_text, ref_blob, _, _, _) in &stored {
 15732	        let reference = decode_vector_blob(ref_blob);
 15733	        let reembed = probe_embed(embedder, probe_text, dimension).ok_or_else(|| {
 15734	            format!(
 15735	                "embedder failed/panicked re-embedding probe {ordinal}; \
 15736	                 cannot verify the dense arm (refused)"
 15737	            )
 15738	        })?;
 15739	
 15740	        // (P2) un-centered L2 — `vec_distance_l2(embedding, vec_f32(query))`.
 15741	        let l2 = l2_distance(&reembed, &reference);
 15742	        if l2 > max_l2 {
 15743	            max_l2 = l2;
 15744	            worst_probe = Some(probe_text.clone());
 15745	        }
 15746	
 15747	        // (P1) mean-centered Phase-1 flip count — same
 15748	        // `vec_quantize_binary(sign(x − mean_vec))` path as build_vector_phase1_sql.
 15749	        let (ref_c, reembed_c) = match &mean_vec {
 15750	            Some(mean) => (subtract_mean(&reference, mean), subtract_mean(&reembed, mean)),
 15751	            None => (reference.clone(), reembed.clone()),
 15752	        };
 15753	        let ref_bits = quantize_binary_via_sql(connection, &ref_c).ok_or_else(|| {
 15754	            format!("vec_quantize_binary SQL failed for probe {ordinal}; cannot verify P1")
 15755	        })?;
 15756	        let reembed_bits = quantize_binary_via_sql(connection, &reembed_c).ok_or_else(|| {
 15757	            format!("vec_quantize_binary SQL failed for probe {ordinal}; cannot verify P1")
 15758	        })?;
 15759	        total_flips = total_flips.saturating_add(hamming_bytes(&ref_bits, &reembed_bits));
 15760	    }
 15761	
 15762	    let p1_tripped = total_flips > VECTOR_EQUIVALENCE_P1_FLIP_FLOOR;
 15763	    let p2_tripped = max_l2 > VECTOR_EQUIVALENCE_L2_EPSILON;
 15764	    if p1_tripped || p2_tripped {
 15765	        let probe_hint = worst_probe.as_deref().unwrap_or("<unknown>");
 15766	        return Err(format!(
 15767	            "P1 mean-centered embedding_bin flips={total_flips} (floor={VECTOR_EQUIVALENCE_P1_FLIP_FLOOR}), \
 15768	             P2 max un-centered L2={max_l2:.3e} (epsilon={VECTOR_EQUIVALENCE_L2_EPSILON:.3e}); \
 15769	             worst probe {probe_hint:?}"
 15770	        ));
 15771	    }
 15772	
 15773	    // 0.8.20 Slice 22 (TC-68) — the probe RAN and PASSED; record the fingerprint
 15774	    // so the next open with identical inputs need not repeat it. Only a verdict
 15775	    // this engine reached itself is ever written (the failure paths above return
 15776	    // early, and the wrapper clears any prior marker on them).
 15777	    record_probe_verification(connection, &fingerprint);
 15778	    Ok(())
 15779	}
 15780	
 15781	/// 0.8.18 Slice 5 — un-centered Euclidean (L2) distance, matching the
 15782	/// `vec_distance_l2` semantics used by the Phase-2 rerank.
 15783	fn l2_distance(a: &[f32], b: &[f32]) -> f32 {
 15784	    a.iter().zip(b.iter()).map(|(x, y)| (x - y) * (x - y)).sum::<f32>().sqrt()
 15785	}
 15786	
 15787	/// 0.8.18 Slice 5 — produce the packed 1-bit `embedding_bin` blob for a (possibly
 15788	/// mean-centered) f32 vector via the SAME SQL `vec_quantize_binary` the production
 15789	/// Phase-1 path uses, so the probe's bits are byte-equal to the engine's
 15790	/// `embedding_bin` production. `None` on any SQL/serialization error.
 15791	fn quantize_binary_via_sql(connection: &Connection, vector: &[f32]) -> Option<Vec<u8>> {
 15792	    let json = serde_json::to_string(vector).ok()?;
 15793	    connection
 15794	        .query_row("SELECT vec_quantize_binary(vec_f32(?1))", [json], |row| {
 15795	            row.get::<_, Vec<u8>>(0)
 15796	        })
 15797	        .ok()
 15798	}
 15799	
 15800	/// 0.8.18 Slice 5 — Hamming distance (differing bit count) between two equal-length
 15990	/// channel, the bounded-recv timeout, and the negotiated handshake state
 15991	/// (`model` provenance + `max_docs_per_request`). One session serves one task
 15992	/// family; the `request`/framing is identical across tasks. `Drop` reaps the
 15993	/// child (sends stdin EOF via the writer field's own drop, then kill/wait),
 15994	/// replacing the prior explicit outer kill/wait.
 15995	struct ProviderSession {
 15996	    task: ProviderTask,
 15997	    child: std::process::Child,
 15998	    writer: std::io::BufWriter<std::process::ChildStdin>,
 15999	    line_rx: Receiver<std::io::Result<String>>,
 16000	    io_timeout: Duration,
 16001	    /// `ready.model`, recorded as output-row provenance (`extractor_model_id`).
 16002	    model: Option<String>,
 16003	    max_docs_per_request: usize,
 16004	}
 16005	
 16006	impl Drop for ProviderSession {
 16007	    fn drop(&mut self) {
 16008	        // The detached stdout-drain thread exits when the child's stdout closes;
 16009	        // kill() guarantees that even for a child that ignores stdin EOF. The
 16010	        // `writer` field drops after this (declaration order) sending EOF too.
 16011	        let _ = self.child.kill();
 16012	        let _ = self.child.wait();
 16013	    }
 16014	}
 16015	
 16016	impl ProviderSession {
 16017	    /// Run the `hello` → `ready` handshake and `supported_tasks` negotiation.
 16018	    /// Validates protocol + schema_version (fix-23 [P2]); rejects a zero
 16019	    /// `max_docs_per_request` (fix-1 [P2]); and, when the harness advertises
 16020	    /// `supported_tasks`, refuses to proceed unless this session's task is in it.
 16021	    /// When `supported_tasks` is absent, the harness is assumed to serve the
 16022	    /// requested task (back-compat: existing extract-only harnesses unchanged).
 16023	    fn handshake(&mut self) -> Result<(), EngineError> {
 16024	        let protocol = self.task.protocol();
 16025	        let hello = serde_json::json!({
 16026	            "protocol": protocol,
 16027	            "type": "hello",
 16028	            "schema_version": 1,
 16029	        });
 16030	        let hello_line = serde_json::to_string(&hello).map_err(|_| EngineError::Extractor)?;
 16031	        writeln!(self.writer, "{hello_line}").map_err(|_| EngineError::Extractor)?;
 16032	        self.writer.flush().map_err(|_| EngineError::Extractor)?;
 16033	
 16034	        let line = recv_extractor_line(&self.line_rx, self.io_timeout)?;
 16035	        let ready: Value = serde_json::from_str(line.trim()).map_err(|_| EngineError::Extractor)?;
 16036	        // fix-23 [P2]: validate protocol + schema_version in the ready message per ADR.
 16037	        if ready.get("type").and_then(|v| v.as_str()) != Some("ready")
 16038	            || ready.get("protocol").and_then(|v| v.as_str()) != Some(protocol)
 16039	            || ready.get("schema_version").and_then(|v| v.as_u64()) != Some(1)
 16040	        {
 16041	            return Err(EngineError::Extractor);
 16042	        }
 16043	
 16044	        // 0.8.6 Slice 5 (ADR-0.8.6 §2.2): additive, optional `supported_tasks`
 16045	        // negotiation. If present, the harness must advertise this session's task
 16046	        // or FathomDB refuses to dispatch it. If absent, default to "serves the
 16047	        // requested task" so extract-only harnesses keep working unchanged.
 16048	        if let Some(supported) = ready.get("supported_tasks").and_then(|v| v.as_array()) {
 16049	            let task_name = self.task.name();
 16050	            let advertised = supported.iter().any(|t| t.as_str() == Some(task_name));
 16051	            if !advertised {
 16052	                return Err(EngineError::Extractor);
 16053	            }
 16054	        }
 16055	
 16056	        self.model = ready.get("model").and_then(|v| v.as_str()).map(|s| s.to_string());
 16057	        let max_docs =
 16058	            ready.get("max_docs_per_request").and_then(|v| v.as_u64()).unwrap_or(8) as usize;
 16059	        // fix-1 [P2]: reject zero max_docs_per_request to prevent chunks(0) panic.
 16060	        if max_docs == 0 {
 16061	            return Err(EngineError::Extractor);
 16062	        }
 16063	        self.max_docs_per_request = max_docs;
 16064	        Ok(())
 16065	    }
 16066	
 16067	    /// Send one framed request for this session's task and receive its matching
 16068	    /// response. `payload` carries the task-specific fields; the envelope keys
 16069	    /// (`protocol`, `type`, `request_id`) are added here. The response must have
 16070	    /// `type == "result"` and a matching `request_id` (fix-24 [P2]); anything
 16071	    /// else (error, wrong id, missing type) is a protocol fault. For `Extract`
 16072	    /// the serialized request bytes are identical to the pre-0.8.6 path (serde_json
 16073	    /// serializes map keys sorted, independent of insertion order).
 16074	    fn request(
 16075	        &mut self,
 16076	        request_id: &str,
 16077	        payload: Vec<(String, Value)>,
 16078	    ) -> Result<Value, EngineError> {
 16079	        let mut req = serde_json::Map::new();
 16080	        req.insert("protocol".to_string(), Value::from(self.task.protocol()));
 16081	        req.insert("type".to_string(), Value::from(self.task.name()));
 16082	        req.insert("request_id".to_string(), Value::from(request_id));
 16083	        for (k, v) in payload {
 16084	            req.insert(k, v);
 16085	        }
 16086	        let req_line =
 16087	            serde_json::to_string(&Value::Object(req)).map_err(|_| EngineError::Extractor)?;
 16088	        writeln!(self.writer, "{req_line}").map_err(|_| EngineError::Extractor)?;
 16089	        self.writer.flush().map_err(|_| EngineError::Extractor)?;
 16090	
 16091	        let result_line = recv_extractor_line(&self.line_rx, self.io_timeout)?;
 16092	        let result: Value =
 16093	            serde_json::from_str(result_line.trim()).map_err(|_| EngineError::Extractor)?;
 16094	        let resp_type = result.get("type").and_then(|v| v.as_str());
 16095	        let resp_id = result.get("request_id").and_then(|v| v.as_str());
 16096	        if resp_type != Some("result") || resp_id != Some(request_id) {
 16097	            return Err(EngineError::Extractor);
 16098	        }
 16099	        Ok(result)
 16100	    }
 16101	}
 16102	
 16103	/// fix-35 [P2]: BYO-LLM extractor I/O timeout. Defaults to 300s to accommodate
 16104	/// slow LLM harnesses; override (in milliseconds) via
 16105	/// `FATHOMDB_EXTRACTOR_TIMEOUT_MS` (tests use this to exercise the hung-harness
 16106	/// path quickly).
 16107	fn extractor_io_timeout() -> Duration {
 16108	    std::env::var("FATHOMDB_EXTRACTOR_TIMEOUT_MS")
 16109	        .ok()
 16110	        .and_then(|s| s.parse::<u64>().ok())
 16111	        .map(Duration::from_millis)
 16112	        .unwrap_or_else(|| Duration::from_secs(300))
 16113	}
