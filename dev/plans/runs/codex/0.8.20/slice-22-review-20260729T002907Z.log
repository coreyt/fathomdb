 16144	fn check_embedder_profile(
 16145	    connection: &Connection,
 16146	    supplied: &EmbedderIdentity,
 16147	) -> Result<bool, EngineOpenError> {
 16148	    // Returns `true` iff `_fathomdb_embedder_profiles.mean_vec IS NOT NULL`
 16149	    // for the default profile (and its byte length matches `4 * dimension`
 16150	    // per `dev/design/embedder.md` §0.2). EU-5a2: column lands in step 10.
 16151	    let mut statement = match connection.prepare(
 16152	        "SELECT name, revision, dimension, mean_vec FROM _fathomdb_embedder_profiles WHERE profile = 'default'",
 16153	    ) {
 16154	        Ok(statement) => statement,
 16155	        Err(_) => return Ok(false),
 16156	    };
 16157	    let mut rows = statement.query([]).map_err(|_| {
 16158	        EngineOpenError::Corruption(CorruptionDetail {
 16159	            kind: CorruptionKind::EmbedderIdentityDrift,
 16160	            stage: OpenStage::EmbedderIdentity,
 16161	            locator: CorruptionLocator::OpaqueSqliteError { sqlite_extended_code: 0 },
 16162	            recovery_hint: RecoveryHint {
 16163	                code: "E_CORRUPT_EMBEDDER_IDENTITY",
 16164	                doc_anchor: "design/recovery.md#embedder-identity-drift",
 16165	            },
 16166	        })
 16167	    })?;
 16168	
 16169	    let Some(row) = rows.next().map_err(|_| {
 16170	        EngineOpenError::Corruption(CorruptionDetail {
 16171	            kind: CorruptionKind::EmbedderIdentityDrift,
 16172	            stage: OpenStage::EmbedderIdentity,
 16173	            locator: CorruptionLocator::OpaqueSqliteError { sqlite_extended_code: 0 },
 16174	            recovery_hint: RecoveryHint {
 16175	                code: "E_CORRUPT_EMBEDDER_IDENTITY",
 16176	                doc_anchor: "design/recovery.md#embedder-identity-drift",
 16177	            },
 16178	        })
 16179	    })?
 16180	    else {
 16181	        connection
 16182	            .execute(
 16183	                "INSERT INTO _fathomdb_embedder_profiles(profile, name, revision, dimension)
 16184	                 VALUES(?1, ?2, ?3, ?4)",
 16185	                params![
 16186	                    DEFAULT_VECTOR_PROFILE,
 16187	                    supplied.name,
 16188	                    supplied.revision,
 16189	                    supplied.dimension
 16190	                ],
 16191	            )
 16192	            .map_err(|_| EngineOpenError::Io {
 16193	                message: "could not persist embedder profile".to_string(),
 16194	            })?;
 16195	        return Ok(false);
 16196	    };
 16197	
 16198	    let stored_name = row.get::<_, String>(0).map_err(|_| {
 16199	        EngineOpenError::Corruption(CorruptionDetail {
 16200	            kind: CorruptionKind::EmbedderIdentityDrift,
 16201	            stage: OpenStage::EmbedderIdentity,
 16202	            locator: CorruptionLocator::TableRow { table: "_fathomdb_embedder_profiles", rowid: 0 },
 16203	            recovery_hint: RecoveryHint {
 16204	                code: "E_CORRUPT_EMBEDDER_IDENTITY",
 16205	                doc_anchor: "design/recovery.md#embedder-identity-drift",
 16206	            },
 16207	        })
 16208	    })?;
 16209	    let stored_revision = row.get::<_, String>(1).map_err(|_| {
 16210	        EngineOpenError::Corruption(CorruptionDetail {
 16211	            kind: CorruptionKind::EmbedderIdentityDrift,
 16212	            stage: OpenStage::EmbedderIdentity,
 16213	            locator: CorruptionLocator::TableRow { table: "_fathomdb_embedder_profiles", rowid: 0 },
 16214	            recovery_hint: RecoveryHint {
 16215	                code: "E_CORRUPT_EMBEDDER_IDENTITY",
 16216	                doc_anchor: "design/recovery.md#embedder-identity-drift",
 16217	            },
 16218	        })
 16219	    })?;
 16220	    let dimension = row.get::<_, u32>(2).map_err(|_| {
 16221	        EngineOpenError::Corruption(CorruptionDetail {
 16222	            kind: CorruptionKind::EmbedderIdentityDrift,
 16223	            stage: OpenStage::EmbedderIdentity,
 16224	            locator: CorruptionLocator::TableRow { table: "_fathomdb_embedder_profiles", rowid: 0 },
 16225	            recovery_hint: RecoveryHint {
 16226	                code: "E_CORRUPT_EMBEDDER_IDENTITY",
 16227	                doc_anchor: "design/recovery.md#embedder-identity-drift",
 16228	            },
 16229	        })
 16230	    })?;
 16231	
 16232	    let stored = EmbedderIdentity::new(stored_name, stored_revision, dimension);
 16233	
 16234	    if stored.name != supplied.name || stored.revision != supplied.revision {
 16235	        return Err(EngineOpenError::EmbedderIdentityMismatch {
 16236	            stored,
 16237	            supplied: supplied.clone(),
 16238	        });
 16239	    }
 16240	    if dimension != supplied.dimension {
 16241	        return Err(EngineOpenError::EmbedderDimensionMismatch {
 16242	            stored: dimension,
 16243	            supplied: supplied.dimension,
 16244	        });
 16245	    }
 16246	
 16247	    // EU-5a2 / `dev/design/embedder.md` §0.2 invariant: if `mean_vec` is
 16248	    // populated, byte length MUST equal `4 * dimension`. Debug builds
 16249	    // assert; release builds fail closed via EmbedderIdentityMismatch
 16250	    // (the same fail-closed channel the rest of profile drift takes).
 16251	    let mean_vec: Option<Vec<u8>> = row.get::<_, Option<Vec<u8>>>(3).map_err(|_| {
 16252	        EngineOpenError::Corruption(CorruptionDetail {
 16253	            kind: CorruptionKind::EmbedderIdentityDrift,
 16254	            stage: OpenStage::EmbedderIdentity,
 16255	            locator: CorruptionLocator::TableRow { table: "_fathomdb_embedder_profiles", rowid: 0 },
 16256	            recovery_hint: RecoveryHint {
 16257	                code: "E_CORRUPT_EMBEDDER_IDENTITY",
 16258	                doc_anchor: "design/recovery.md#embedder-identity-drift",
 16259	            },
 16260	        })
 16261	    })?;
 16262	    let pinned = match mean_vec {
 16263	        Some(bytes) => {
 16264	            let expected_len = (dimension as usize).saturating_mul(4);
 16265	            // `dev/design/embedder.md` §0.2 invariant: when populated,
 16266	            // `mean_vec` byte length MUST equal `4 * dimension`. Fail
 16267	            // closed via the existing identity-drift channel in both
 16268	            // debug and release builds — tests deliberately poke
 16269	            // malformed values to exercise this branch.
 16270	            if bytes.len() != expected_len {
 16271	                return Err(EngineOpenError::EmbedderIdentityMismatch {
 16272	                    stored,
 16273	                    supplied: supplied.clone(),
 16274	                });
 16275	            }
 16276	            true
 16277	        }
 16278	        None => false,
 16279	    };
 16280	
 16281	    Ok(pinned)
 16282	}
