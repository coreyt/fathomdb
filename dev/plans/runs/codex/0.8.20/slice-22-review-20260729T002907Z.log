 16293	fn validate_batch(
 16294	    connection: &Connection,
 16295	    batch: &[PreparedWrite],
 16296	) -> Result<Vec<WritePlan>, EngineError> {
 16297	    batch.iter().map(|write| validate_write(connection, write)).collect()
 16298	}
 16299	
 16300	fn collect_projection_jobs(
 16301	    connection: &Connection,
 16302	    batch: &[PreparedWrite],
 16303	) -> Result<Vec<ProjectionJob>, EngineError> {
 16304	    let mut jobs = Vec::new();
 16305	    for write in batch {
 16306	        if let PreparedWrite::Node { kind, body, .. } = write {
 16307	            // 0.8.20 Slice 20c — this probe decides whether `notify_new_work` is
 16308	            // called, so `Engine::enrol_batch_vector_kinds` MUST already have run
 16309	            // on this batch: a kind enrolled after this point would be enqueued in
 16310	            // the database with the dispatcher left asleep on
 16311	            // `pending_scan == false`, and because `drain` is a passive barrier
 16312	            // (C4 rider: never a trigger) the next `drain` would burn its ENTIRE
 16313	            // timeout and return `EngineError::Scheduler` on work ready to run.
 16314	            if kind_is_vector_indexed(connection, kind)? {
 16315	                jobs.push(ProjectionJob { cursor: 0, kind: kind.clone(), body: body.clone() });
 16316	            }
 16317	        }
 16318	    }
 16319	    Ok(jobs)
 16320	}
 16321	
 16322	fn validate_write(
 16323	    connection: &Connection,
 16324	    write: &PreparedWrite,
 16325	) -> Result<WritePlan, EngineError> {
 16326	    match write {
 16327	        PreparedWrite::Node { kind, body, logical_id, valid_from, valid_until, .. } => {
 16328	            if kind.trim().is_empty() || body.trim().is_empty() {
 16329	                return Err(EngineError::WriteValidation);
 16330	            }
 16331	            // 0.8.20 Slice 15b (TC-34) — the validity window is HALF-OPEN
 16332	            // `[valid_from, valid_until)`, so a pair with `from >= until` selects
 16333	            // no instant at all: the row would be written but no default read
 16334	            // could ever return it. Silently accepting that is a trap, so it is a
 16335	            // typed refusal.
 16336	            //
 16337	            // 0.8.20 Slice 22 (R-20-VC) — **decision #18, SETTLED: one family.**
 16338	            // This site used to return `EngineError::InvalidArgument { msg }`
 16339	            // carrying both bounds, which made `validate_write` — ONE function —
 16340	            // reject across TWO error families, so the same `write` call raised
 16341	            // `InvalidArgumentError` for an inverted window and
 16342	            // `WriteValidationError` for a non-integer bound. `dev/design/errors.md`
 16343	            // (status: locked) defines `WriteValidationError` as "malformed typed
 16344	            // write shape" / "the submitted typed write is malformed **before**
 16345	            // schema-sensitive payload checks run" — which is exactly this
 16346	            // boundary — so the code now agrees with the taxonomy of record.
 16347	            // `InvalidArgument` stays the family for caller-argument rejections
 16348	            // OUTSIDE this boundary (see the errors.md 2026-07-28 amendment).
 16349	            //
 16350	            // **The cost, stated:** `WriteValidation` is a UNIT variant and both
 16351	            // bindings map it to a fixed message-less string, so the offending
 16352	            // bounds are no longer recoverable from the error. That is a breaking
 16353	            // behaviour change on a published surface (CHANGELOG 0.8.20) and it is
 16354	            // the diagnostic the prior split existed to preserve. Restoring it
 16355	            // needs a message-carrying `WriteValidation { msg }`, which is a
 16356	            // cross-cutting change across every engine + binding raise site and
 16357	            // both binding payload shapes — its own slice, not this one.
 16358	            //
 16359	            // Only the PAIR can be empty. A one-sided window is unbounded on the
 16360	            // missing side and can never be empty, so it is never refused.
 16361	            if let (Some(from), Some(until)) = (valid_from, valid_until) {
 16362	                if from >= until {
 16363	                    return Err(EngineError::WriteValidation);
 16364	                }
 16365	            }
 16366	            // R-20-E3: `source_id` needs no emptiness check here — `SourceId`
 16367	            // cannot hold an empty or reserved id, so the check has moved from
 16368	            // this branch into the type's constructor.
 16369	            // G0 — an explicit logical_id must be non-empty (NULL/None is the
 16370	            // legacy default; an empty string is never a valid identity).
 16371	            // Also reject char(30) = \x1e (ASCII RS), which is the BFS cycle-guard
 16372	            // delimiter; allowing it would corrupt the visited-path substring test.
 16373	            if let Some(logical_id) = logical_id {
 16374	                if logical_id.is_empty() || logical_id.contains('\x1e') {
 16375	                    return Err(EngineError::WriteValidation);
 16376	                }
 16377	            }
 16378	            Ok(WritePlan::Node)
 16379	        }
 16380	        PreparedWrite::Edge { kind, from, to, logical_id, t_valid, t_invalid, .. } => {
 16381	            if kind.trim().is_empty() || from.trim().is_empty() || to.trim().is_empty() {
 16382	                return Err(EngineError::WriteValidation);
 16383	            }
 16384	            // Reject char(30) in from/to: these become from_id/to_id in canonical_edges
 16385	            // and appear in BFS visited strings — an \x1e there would corrupt the guard.
 16386	            if from.contains('\x1e') || to.contains('\x1e') {
 16387	                return Err(EngineError::WriteValidation);
 16388	            }
 16389	            // R-20-E3: see the Node branch — emptiness is a `SourceId` invariant.
 16390	            if let Some(logical_id) = logical_id {
 16391	                if logical_id.is_empty() || logical_id.contains('\x1e') {
 16392	                    return Err(EngineError::WriteValidation);
 16393	                }
 16394	            }
 16395	            // TC-33 fix-1 (codex §9 P2) — an epoch SQLite cannot render to
 16396	            // ISO-8601 must be UNSTORABLE. The governed integer surface is the
 16397	            // only way to reach one (inbound ISO normalisation maxes at year
 16398	            // 9999), so this write boundary is where it is stopped, before it
 16399	            // can render to a silent `null` on the consolidation wire and
 16400	            // resurrect an invalidated edge. Structural primary layer; the
 16401	            // render site keeps a defensive hard-assert as the backstop.
 16402	            reject_unrenderable_edge_epoch("t_valid", *t_valid)?;
 16403	            reject_unrenderable_edge_epoch("t_invalid", *t_invalid)?;
 16404	            Ok(WritePlan::Edge)
 16405	        }
 16406	        PreparedWrite::AdminSchema { name, kind, schema_json, retention_json } => {
 16407	            if name.trim().is_empty()
 16408	                || !matches!(kind.as_str(), "append_only_log" | "latest_state")
 16409	                || serde_json::from_str::<Value>(schema_json).is_err()
 16410	                || serde_json::from_str::<Value>(retention_json).is_err()
 16411	                || contains_external_ref(schema_json)
 16412	            {
 16413	                return Err(EngineError::SchemaValidation);
 16414	            }
 16415	            Ok(WritePlan::AdminSchema)
 16416	        }
 16417	        PreparedWrite::OpStore { collection, record_key, schema_id, body } => {
 16418	            if collection.trim().is_empty() || record_key.trim().is_empty() {
 16419	                return Err(EngineError::WriteValidation);
 16420	            }
 16421	            let (kind, schema_json) = collection_metadata(connection, collection)?;
 16422	            if let Some(schema_id) = schema_id {
 16423	                if schema_id != collection {
 16424	                    return Err(EngineError::SchemaValidation);
 16425	                }
 16426	                validate_payload(&schema_json, body)?;
 16427	            } else if serde_json::from_str::<Value>(body).is_err() {
 16428	                return Err(EngineError::SchemaValidation);
 16429	            }
 16430	
 16431	            match kind.as_str() {
 16432	                "append_only_log" => Ok(WritePlan::AppendOnlyLog),
 16433	                "latest_state" => Ok(WritePlan::LatestState),
 16434	                _ => Err(EngineError::OpStore),
 16435	            }
 16436	        }
 16437	    }
 16438	}
 16439	
 16440	fn collection_metadata(
 16441	    connection: &Connection,
 16442	    collection: &str,
 16443	) -> Result<(String, String), EngineError> {
 16444	    connection
 16445	        .query_row(
 16446	            "SELECT kind, schema_json FROM operational_collections WHERE name = ?1",
 16447	            [collection],
 16448	            |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)),
 16449	        )
 16450	        .map_err(|_| EngineError::OpStore)
 16451	}
 16452	
 16453	fn validate_payload(schema_json: &str, body: &str) -> Result<(), EngineError> {
 16454	    let schema =
 16455	        serde_json::from_str::<Value>(schema_json).map_err(|_| EngineError::SchemaValidation)?;
 16456	    let payload = serde_json::from_str::<Value>(body).map_err(|_| EngineError::SchemaValidation)?;
 16457	
 16458	    let compiled = JSONSchema::compile(&schema).map_err(|_| EngineError::SchemaValidation)?;
 16459	    compiled.validate(&payload).map_err(|_| EngineError::SchemaValidation)?;
 16460	
 16461	    Ok(())
 16462	}
 16463	
 16464	fn contains_external_ref(schema_json: &str) -> bool {
 16465	    let Ok(value) = serde_json::from_str::<Value>(schema_json) else {
 16466	        return false;
 16467	    };
 16468	    value_contains_external_ref(&value)
 16469	}
 16470	
 16471	fn value_contains_external_ref(value: &Value) -> bool {
 16472	    match value {
 16473	        Value::Object(object) => object.iter().any(|(key, value)| {
 16474	            if key == "$ref" {
 16475	                return value.as_str().is_some_and(|uri| !uri.starts_with('#'));
 16476	            }
 16477	            value_contains_external_ref(value)
 16478	        }),
 16479	        Value::Array(values) => values.iter().any(value_contains_external_ref),
 16480	        _ => false,
 16481	    }
 16482	}
