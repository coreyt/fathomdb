 16484	// fix-30 [P2]: helpers to collect active edge write_cursors BEFORE a supersession
 16485	// UPDATE so the callers can prune stale vector_default rows.
 16486	fn prior_edge_cursors_by_logical_id(
 16487	    tx: &rusqlite::Transaction<'_>,
 16488	    logical_id: &str,
 16489	) -> rusqlite::Result<Vec<i64>> {
 16490	    let mut s = tx.prepare_cached(
 16491	        "SELECT write_cursor FROM canonical_edges \
 16492	         WHERE logical_id = ?1 AND superseded_at IS NULL",
 16493	    )?;
 16494	    let rows = s.query_map(params![logical_id], |r| r.get(0))?;
 16495	    rows.collect()
 16496	}
