 16530	/// EXP-S (0.8.14 Slice 5, D2) — the set of coexisting indexes a `row_kind`
 16531	/// projects into. `fts` = the FTS index (`search_index`), written SYNCHRONOUSLY
 16532	/// in the write transaction; `vector` = the vec0 vector index, written
 16533	/// ASYNCHRONOUSLY by the projection worker pool (and additionally gated per
 16534	/// doc-type `kind` by [`kind_is_vector_indexed`]).
 16535	#[derive(Clone, Copy, Debug, Eq, PartialEq)]
 16536	struct IndexTargetSet {
 16537	    fts: bool,
 16538	    vector: bool,
 16539	}
 16540	
 16541	/// 0.8.20 Slice 5a (R-20-E1) — the class a row-owned projection table belongs
 16542	/// to, so the four maintenance sites can each truncate exactly the subset they
 16543	/// own without re-deriving a hand-rolled table list.
 16544	///
 16545	/// - `NodeFts` — same-txn lexical projection of a canonical NODE body.
 16546	/// - `EdgeFts` — same-txn lexical projection of a canonical EDGE body.
 16547	/// - `Vector` — the async vec0 materialization (written by the embed worker,
 16548	///   not by the write path — see [`project_canonical_node_row`]).
 16549	/// - `Readiness` — the terminal-cursor bookkeeping that lets
 16550	///   `advance_projection_cursor` walk past a row.
 16551	#[derive(Clone, Copy, Debug, Eq, PartialEq)]
 16552	enum ProjectionClass {
 16553	    NodeFts,
 16554	    EdgeFts,
 16555	    Vector,
 16556	    Readiness,
 16557	    /// 0.8.20 Slice 15d (R-20-EAV) — the EAV attribute store (`filterable` +
 16558	    /// the value-at-rest for `searchable`). Same-transaction, row-owned.
 16559	    Attribute,
 16560	    /// 0.8.20 Slice 15d (R-20-EAV) — the property-FTS5 shadow of attribute
 16561	    /// values (`searchable→FTS`). Same-transaction, row-owned.
 16562	    PropertyFts,
 16563	}
 16564	
 16565	/// 0.8.20 Slice 5a (R-20-E1) — one ROW-OWNED projection table: a shadow whose
 16566	/// rows are 1:1 with a canonical row's `write_cursor` and therefore MUST die
 16567	/// with that row.
 16568	#[derive(Clone, Copy, Debug)]
 16569	struct RowOwnedProjection {
 16570	    /// Table name. `'static` and never caller-derived: safe to interpolate.
 16571	    table: &'static str,
 16572	    /// The column carrying the owning canonical row's `write_cursor`. For the
 16573	    /// vec0 table this is `rowid` — vec0 rowid IS the write_cursor (see the
 16574	    /// `_fathomdb_vector_rows.write_cursor UNIQUE` identity).
 16575	    cursor_column: &'static str,
 16576	    class: ProjectionClass,
 16577	}
 16578	
 16579	/// 0.8.20 Slice 5a (R-20-E1) — **the** registry of row-owned projections.
 16580	///
 16581	/// Every table here is 1:1 with a canonical `write_cursor` and is erased by
 16582	/// [`erase_row_projections`] whenever that canonical row is erased. Adding a
 16583	/// projection table WITHOUT registering it here re-opens the defect this slice
 16584	/// closes (`search_index_v2` was written by one site and deleted by one site,
 16585	/// out of five that maintain projections — so `excise_source` left the erased
 16586	/// body on disk in a content-storing FTS5 table). The `guard_row_owned_registry`
 16587	/// unit test introspects `sqlite_master` and fails if a `write_cursor`-keyed
 16588	/// table is missing from this list.
 16589	///
 16590	/// **NOT here, deliberately (design v5 §1.1): `_fathomdb_projection_state`.**
 16591	/// That table is KIND-owned — keyed by `kind`, holding a per-kind enqueue
 16592	/// watermark. Erasing one row must NOT rewind a whole kind's watermark, so it
 16593	/// must never be deleted per-cursor. A rebuild resets it deliberately; erasure
 16594	/// leaves it alone.
 16595	const ROW_OWNED_PROJECTIONS: &[RowOwnedProjection] = &[
 16596	    RowOwnedProjection {
 16597	        table: "search_index",
 16598	        cursor_column: "write_cursor",
 16599	        class: ProjectionClass::NodeFts,
 16600	    },
 16601	    RowOwnedProjection {
