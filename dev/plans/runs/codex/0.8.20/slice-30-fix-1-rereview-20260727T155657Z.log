+CATEGORY_COUNT_KEY = {"CHECKABLE": "checkable", "CROSS-REPO": "cross_repo", "PROSE": "prose"}
+COUNT_KEYS = ["checkable", "cross_repo", "prose", "total"]
+
+
+def die_env(msg):
+    print("check-c1-conformance: " + msg)
+    sys.exit(2)
