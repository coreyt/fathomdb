export interface BoundaryCrossing {
  node: NodeRecord;
  becameValidAt: number | null;
  becameInvalidAt: number | null;
}

export interface NodeRecord {
  logicalId: string;
  kind: string;
  body: string;
  /** Interim id carrier (parity with `SearchHit.id`). */
  writeCursor: number;
}

