import { InvalidArgumentError, rethrowTyped } from "./errors.js";
import { validateFfiString } from "./validation.js";
import type {
  DenseReadiness,
  Engine,
  Filter,
  FilterTerm,
  ProjectionRole,
  ProjectionSpec,
