    """

    built: list[str]
    dropped: list[str]
    deferred: list[str]
    unchanged: bool
    #: 0.8.20 Slice 22 (R-20-VC / TC-67) — node **kinds**, not attribute names:
    #: the vector-eligible kinds present in the corpus that the vector writer can
