+# job exists, runs the SHARED script, carries the recurrence guard, and has no
+# `if:` and no `needs:` at all.
+CI_JOB_BLOCK="$(awk '
+  /^  c1-contract-conformance:/ { inblock = 1; print; next }
+  inblock && /^  [A-Za-z0-9_-]+:/ { inblock = 0 }
+  inblock { print }
+' "$CI_YML")"
