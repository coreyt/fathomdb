+    text.replace(old, '("fn_defined", T15, "boot_rederive_converges_after_simulated_crash")', 1))
+PY
+then
+  set +e
+  OUT="$(bash "$SWAPPED_CHECKER" --contract "$CLEAN_CONTRACT" --pin "$REAL_PIN" --root "$CLEAN_ROOT" 2>&1)"
