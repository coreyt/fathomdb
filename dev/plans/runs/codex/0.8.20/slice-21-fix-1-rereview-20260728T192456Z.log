+    fn embed(&self, _text: &str) -> Result<Vector, EmbedderError> {
+        if !self.delay.is_zero() {
+            std::thread::sleep(self.delay);
+        }
+        let mut v = vec![0.0_f32; self.identity.dimension as usize];
+        v[0] = 1.0;
+        Ok(v)
