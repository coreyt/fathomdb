   315	// ---------------------------------------------------------------------------
   316	// TC-91 (a) — the baseline duplicate rate, with the probe separated out
   317	// ---------------------------------------------------------------------------
   318	
   319	struct DuplicateOutcome {
   320	    label: &'static str,
   321	    rows: usize,
   322	    pace_ms: u64,
   323	    split: EmbedSplit,
   324	    total_embeds: usize,
   325	    drain_ok: bool,
   326	    census: TerminalCensus,
   327	}
   328	
   329	impl DuplicateOutcome {
   330	    fn report(&self) {
   331	        println!(
   332	            "TC91-DUP arm={} rows={} pace_ms={} total_embeds={} ingest_calls={} \
   333	             ingest_distinct={} ingest_duplicates={} ingest_repeated_texts={} probe_calls={} \
   334	             dup_rate_pct={:.1} failed_terminals={} up_to_date_terminals={} \
   335	             failure_audit_rows={} vector_rows={} node_rows={} drain_ok={}",
   336	            self.label,
   337	            self.rows,
   338	            self.pace_ms,
   339	            self.total_embeds,
   340	            self.split.ingest_calls,
   341	            self.split.ingest_distinct,
   342	            self.split.ingest_duplicates,
   343	            self.split.ingest_repeated_texts,
   344	            self.split.probe_calls,
   345	            100.0 * self.split.ingest_duplicates as f64 / self.rows as f64,
   346	            self.census.failed_terminals,
   347	            self.census.up_to_date_terminals,
   348	            self.census.failure_audit_rows,
   349	            self.census.vector_rows,
   350	            self.census.node_rows,
   351	            self.drain_ok,
   352	        );
   353	    }
   354	}
   355	
   356	/// One duplicate-rate arm, measured inside a SINGLE open.
   357	///
   358	/// The workspace is fresh, so `_fathomdb_vector_kinds` is EMPTY at open and the
   359	/// vector-equivalence probe returns early having done ZERO embeds
   360	/// (`lib.rs:15348-15353`). The kind is enrolled AFTER open. Every `embed()` in
   361	/// this arm is therefore an ingest embed, and `probe_calls` is expected to be 0 —
   362	/// which the arm asserts, so the separation is verified rather than assumed.
   363	fn run_duplicate_arm(
   364	    label: &'static str,
   365	    governed: bool,
   366	    rows: usize,
   367	    pace_ms: u64,
   368	) -> DuplicateOutcome {
   369	    let dir = TempDir::new().expect("tempdir");
   370	    let path = dir.path().join(format!("tc91_dup_{label}{SQLITE_SUFFIX}"));
   371	    let log = EmbedLog::default();
   372	    let opened = Engine::open_with_embedder_for_test(
   373	        &path,
   374	        Arc::new(RecordingEmbedder::new(&log, Duration::from_millis(1))),
   375	    )
   376	    .expect("open");
   377	    let engine = &opened.engine;
   378	    engine.configure_vector_kind_for_test("doc").expect("vector kind");
   379	
   380	    for i in 0..rows {
   381	        engine.write(&[node(i, governed)]).expect("write must succeed");
   382	        // Yield so the worker interleaves rather than being starved. `pace_ms` is
   383	        // the independent variable of the mechanism experiment below.
   384	        std::thread::sleep(Duration::from_millis(pace_ms));
   385	    }
   386	    let drain_ok = engine.drain(120_000).is_ok();
   387	    let split = log.split();
   388	    let total_embeds = log.total();
   389	    opened.engine.close().expect("close");
   390	
   391	    let outcome = DuplicateOutcome {
   392	        label,
   393	        rows,
   394	        pace_ms,
   395	        split,
   396	        total_embeds,
   397	        drain_ok,
   398	        census: census(&path),
   399	    };
   400	    outcome.report();
   401	    outcome
   402	}
   403	
   404	/// Assertions shared by both duplicate arms. Non-vacuity first: an arm where the
   405	/// worker never embedded, or never committed, says nothing about a duplicate rate.
   406	fn assert_duplicate_arm(outcome: &DuplicateOutcome) {
   407	    assert!(outcome.drain_ok, "non-vacuity: drain must reach idle, else work is still outstanding");
   408	    assert_eq!(
   409	        outcome.split.ingest_distinct, outcome.rows,
   410	        "non-vacuity: every one of the {} unique rows must have been embedded at least once",
   411	        outcome.rows
   412	    );
   413	    assert_eq!(
   414	        outcome.census.vector_rows, outcome.rows as i64,
   415	        "non-vacuity: every row must have reached a durable vector, else the duplicates would \
   416	         be explained by rows that simply never landed"
   417	    );
   418	    assert_eq!(
   419	        outcome.split.probe_calls, 0,
   420	        "the probe MUST contribute zero embeds on a fresh workspace whose vector kind is \
   421	         enrolled after open (`lib.rs:15348-15353`) — if this is non-zero the ingest/probe \
   422	         separation is broken and every duplicate number below is contaminated"
   423	    );
   424	}
   425	
   426	/// **TC-91 (a) — GOVERNED arm.** `logical_id: Some(..)`.
   427	#[test]
   428	#[ignore = "TC-91 characterization arm — run explicitly with --ignored; see the design doc"]
   429	fn tc91_duplicate_embed_rate_governed() {
   430	    let outcome = run_duplicate_arm("governed", true, ROWS, 1);
   431	    assert_duplicate_arm(&outcome);
   432	    assert_eq!(
   433	        outcome.split.ingest_duplicates, 0,
   434	        "TC-91 (a): {} duplicate embeds over {ROWS} rows ({} distinct rows embedded more than \
   435	         once) — wasted embed work, invisible to every correctness test because a duplicate \
   436	         embed produces the right answer twice",
   437	        outcome.split.ingest_duplicates, outcome.split.ingest_repeated_texts,
   438	    );
   439	}
   440	
   441	/// **TC-91 (a) — ANONYMOUS arm.** `logical_id: None`.
   442	///
   443	/// This arm is the load-bearing one for attribution. The anonymous write path has
   444	/// NO read-then-upgrade window and never produced a caller error even before the
   445	/// TC-57 fix, so a duplicate rate here cannot be caused by the governed-write
   446	/// race. If both arms show the same rate, the cause is elsewhere.
   447	#[test]
   448	#[ignore = "TC-91 characterization arm — run explicitly with --ignored; see the design doc"]
   449	fn tc91_duplicate_embed_rate_anonymous() {
   450	    let outcome = run_duplicate_arm("anonymous", false, ROWS, 1);
   451	    assert_duplicate_arm(&outcome);
   452	    assert_eq!(
   453	        outcome.split.ingest_duplicates, 0,
   454	        "TC-91 (a): {} duplicate embeds over {ROWS} rows ({} distinct rows embedded more than \
   455	         once) on the ANONYMOUS arm — so the cause is NOT the governed-write race TC-57 fixed",
   456	        outcome.split.ingest_duplicates, outcome.split.ingest_repeated_texts,
   457	    );
   458	}
