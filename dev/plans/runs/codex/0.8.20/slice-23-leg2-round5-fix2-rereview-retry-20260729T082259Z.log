   547	/// same isolation TC-57 §4.2 performed. If this arm ever fails, the failure is
   548	/// NOT a promote race and must be reported as a separate finding.
   549	///
   550	/// **MEASURED 0/20 at `94f09d7d`** (two sessions of 10), `embed_calls == 0` in
   551	/// every run.
   552	#[test]
   553	#[ignore = "TC-90 characterization arm — run explicitly with --ignored; see the design doc"]
   554	fn tc90_control_transition_loop_without_second_writer() {
   555	    let outcome = run_arm(&ArmConfig {
   556	        label: "control",
   557	        second_writer: false,
   558	        writer_threads: 1,
   559	        burst: 1,
