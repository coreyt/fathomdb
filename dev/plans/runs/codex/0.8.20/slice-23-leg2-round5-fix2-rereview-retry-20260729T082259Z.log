   676	/// How long the external connection HOLDS the WAL write lock. Long enough that
   677	/// many worker commits are attempted inside the window.
   678	const HOLD: Duration = Duration::from_millis(1_500);
   679	
   680	/// Force worker commit failures by holding the WAL write lock from OUTSIDE the
   681	/// engine, then measure what the engine reports.
   682	///
   683	/// The blocker is an ordinary second connection on the same file running `BEGIN
   684	/// IMMEDIATE`. That is exactly the contention TC-90's mechanism pins characterize,
   685	/// applied in the opposite direction: `commit_projection_outcomes` (`lib.rs:13809`)
   686	/// opens rusqlite's DEFERRED default and reads (`lib.rs:13813`, `lib.rs:13828`)
   687	/// before it writes, so its promotion is refused with plain `SQLITE_BUSY` and the
   688	/// busy handler is never consulted. `let _ =` then discards the whole thing.
