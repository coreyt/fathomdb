   738	/// connection. The assertions are deliberately the wrong way round from a normal
   739	/// test: they assert that the two counters a future agent would reach for stay at
   740	/// **zero**, and that the re-embed count is simultaneously **non-zero**.
   741	///
   742	/// Passing therefore means: *real work was computed, thrown away, and recomputed,
   743	/// and the terminal-state census reported a perfectly clean run.* That is the
   744	/// finding. It is what makes "measure worker risk by counting `'failed'`
   745	/// terminals" a structurally invalid method rather than merely an imprecise one.
   746	#[test]
   747	#[ignore = "TC-91 characterization arm — run explicitly with --ignored; see the design doc"]
   748	fn tc91_forced_commit_failure_is_invisible_to_terminal_counting() {
   749	    let outcome = run_commit_loss_arm("blocked", true);
   750	
   751	    assert!(
   752	        outcome.blocked_ms >= HOLD.as_millis(),
   753	        "non-vacuity: the blocker must actually have held the write lock ({} ms < {} ms)",
   754	        outcome.blocked_ms,
   755	        HOLD.as_millis()
   756	    );
   757	    assert!(
   758	        outcome.split.ingest_duplicates > 0,
   759	        "non-vacuity: at least one outcome must have been computed and lost, else there is no \
   760	         commit failure to be blind to (duplicates={})",
   761	        outcome.split.ingest_duplicates
   762	    );
   763	    assert!(outcome.drain_ok, "the engine must still reach idle — this is a LOSS, not a wedge");
   764	    assert_eq!(
   765	        outcome.census.vector_rows, LOSS_ROWS as i64,
   766	        "and every row must still land eventually: the harm is wasted work, not data loss"
   767	    );
   768	
   769	    // ---- the finding ----
   770	    assert_eq!(
   771	        outcome.census.failed_terminals, 0,
   772	        "TC-91 (b): {} outcomes were discarded by `let _ = commit_projection_outcomes(..)` \
   773	         (`lib.rs:12711`) and the `'failed'` terminal count is {} — if this ever becomes \
   774	         NON-zero the blindness has been fixed and this test must be re-read, not re-run",
   775	        outcome.split.ingest_duplicates, outcome.census.failed_terminals,
   776	    );
   777	    assert_eq!(
   778	        outcome.census.failure_audit_rows, 0,
   779	        "TC-91 (b): nor does a discarded commit produce a `projection_failures` audit row — \
   780	         that arm (`lib.rs:13962-13984`) is reached only by an EMBED failure"
   781	    );
   782	}
   783	
   784	/// **TC-91 (b) CONTROL.** Identical load, no external lock.
   785	///
   786	/// Establishes the baseline duplicate count the blocked arm is read against, and
   787	/// confirms the two counters are zero for the ordinary reason (nothing failed) as
   788	/// well as for the pathological one — which is precisely why they cannot
   789	/// discriminate, and precisely why a future agent must not use them.
   790	#[test]
   791	#[ignore = "TC-91 characterization arm — run explicitly with --ignored; see the design doc"]
   792	fn tc91_control_unblocked_worker_commits() {
   793	    let outcome = run_commit_loss_arm("unblocked", false);
   794	
   795	    assert!(outcome.drain_ok, "drain must reach idle");
   796	    assert_eq!(
   797	        outcome.split.ingest_distinct, LOSS_ROWS,
   798	        "non-vacuity: every row must have been embedded at least once"
   799	    );
   800	    assert_eq!(
   801	        outcome.census.vector_rows, LOSS_ROWS as i64,
   802	        "non-vacuity: every row must have reached a durable vector"
   803	    );
   804	    assert_eq!(
   805	        outcome.census.failed_terminals, 0,
   806	        "the control's point: the counters read ZERO here for the ORDINARY reason"
   807	    );
   808	    assert_eq!(outcome.census.failure_audit_rows, 0, "same, for the audit rows");
   809	}

