   508	        label: "repro",
   509	        second_writer: true,
   510	        writer_threads: 1,
   511	        burst: 1,
   512	        writer_pace_ms: 3,
   513	        embed_delay_ms: 2,
   514	        transitions: TRANSITIONS,
   515	        budget: Duration::from_secs(120),
   516	    });
   517	    assert!(
   518	        outcome.embed_calls > 0,
   519	        "non-vacuity: the projection worker must have embedded at least one row, else there \
   520	         was no second writer and the promote window never existed"
   521	    );
   522	    assert_protocol_ran(&outcome, TRANSITIONS);
   523	    if let Some((i, err)) = &outcome.first_storage_failure {
   524	        panic!(
   525	            "TC-90 REPRO: transition {i} of {} failed with {err:?} after {} ms \
   526	             (slowest OK transition {} ms); storage={} scheduler={} other={} kinds={:?}",
   527	            outcome.attempted,
   528	            outcome.failure_wall_ms,
   529	            outcome.slowest_ok_ms,
   530	            outcome.storage_errors,
   531	            outcome.scheduler_errors,
   532	            outcome.other_errors,
   533	            outcome.other_error_kinds,
   534	        );
   535	    }
   536	}
