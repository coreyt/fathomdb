   575	             storage={} scheduler={} other={} kinds={:?}",
   576	            outcome.attempted,
   577	            outcome.failure_wall_ms,
   578	            outcome.storage_errors,
   579	            outcome.scheduler_errors,
   580	            outcome.other_errors,
