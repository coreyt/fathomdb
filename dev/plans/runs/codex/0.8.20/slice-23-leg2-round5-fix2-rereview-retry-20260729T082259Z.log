   709	        let started = Instant::now();
   710	        let conn = rusqlite::Connection::open(&path).expect("open blocker");
   711	        conn.execute_batch("BEGIN IMMEDIATE;").expect("blocker takes the WAL write lock");
   712	        conn.execute(
   713	            "INSERT OR IGNORE INTO _fathomdb_projection_terminal(write_cursor, state) \
