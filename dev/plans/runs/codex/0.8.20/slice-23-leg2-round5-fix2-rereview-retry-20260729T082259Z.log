   671	/// Rows for the forced-commit-failure arms. Comfortably more than
   672	/// `PROJECTION_INFLIGHT_LIMIT` (32) so several worker commits are attempted while
   673	/// the write lock is held.
   674	const LOSS_ROWS: usize = 96;
