   276	    /// Asserted `false` by every arm; see [`assert_stress_protocol_ran`].
   277	    truncated: bool,
   278	    /// First `EngineError::Storage` observed, as `(index, error)`. This is the
   279	    /// TC-90 signal; `Scheduler` and everything else are counted separately.
   280	    first_storage_failure: Option<(usize, EngineError)>,
   281	    /// Distinct non-`Storage`, non-`Scheduler` error variants seen, for diagnosis.
   282	    other_error_kinds: Vec<String>,
   283	    storage_errors: usize,
   284	    scheduler_errors: usize,
   285	    other_errors: usize,
   286	    /// Writes the competing thread landed. The competing thread is what creates
   287	    /// the drain-returns / mutex-acquired gap the repro arm targets.
   288	    competing_writes: usize,
   289	    competing_write_errors: usize,
   290	    /// Embeds performed. This IS the independent variable: `> 0` means a second
   291	    /// writer existed, `== 0` means it did not.
   292	    embed_calls: usize,
   293	    slowest_ok_ms: u128,
   294	    failure_wall_ms: u128,
   295	}
   296	
   297	impl ArmOutcome {
   298	    fn report(&self) {
   299	        println!(
   300	            "TC90 arm={} attempted={} truncated={} storage_errors={} scheduler_errors={} \
   301	             other_errors={} competing_writes={} competing_write_errors={} embed_calls={} \
   302	             slowest_ok_ms={} failure_wall_ms={} other_error_kinds={:?}",
   303	            self.label,
   304	            self.attempted,
   305	            self.truncated,
   306	            self.storage_errors,
   307	            self.scheduler_errors,
   308	            self.other_errors,
   309	            self.competing_writes,
   310	            self.competing_write_errors,
   311	            self.embed_calls,
   312	            self.slowest_ok_ms,
   313	            self.failure_wall_ms,
   314	            self.other_error_kinds,
   315	        );
   316	    }
   317	}
   318	
   319	/// Run one arm of the comparison.
   320	///
   321	/// Within a repro/control pairing the ONLY field that differs is
   322	/// [`ArmConfig::second_writer`] — embedder, seed rows, competing-write load,
   323	/// pacing and transition loop are identical.
   324	fn run_arm(config: &ArmConfig) -> ArmOutcome {
   325	    let label = config.label;
   326	    let dir = TempDir::new().expect("tempdir");
   327	    let path = dir.path().join(format!("tc90_{label}{SQLITE_SUFFIX}"));
   328	    let calls = Arc::new(AtomicUsize::new(0));
   329	    let opened = Engine::open_with_embedder_for_test(
   330	        &path,
   331	        Arc::new(CountingDelayEmbedder::new(
   332	            calls.clone(),
   333	            Duration::from_millis(config.embed_delay_ms),
   334	        )),
   335	    )
   336	    .expect("open");
   337	    let engine = Arc::new(opened.engine);
   338	    if config.second_writer {
   339	        engine.configure_vector_kind_for_test("doc").expect("vector kind");
   340	    }
   341	
   342	    // Seed the subjects the transition loop flips. Written BEFORE the competing
   343	    // thread starts so the loop never transitions a row that does not exist.
   344	    for s in 0..SUBJECTS {
   345	        engine
   346	            .write(&[governed_node(&format!("tc90-subject-{s}"), &format!("subject {s}"))])
   347	            .expect("seed write");
   348	    }
   349	    engine.drain(60_000).expect("seed drain");
   350	
   351	    // The competing writer. Its job is to keep offering `transition` the one
   352	    // in-process window that exists: `drain` returns idle, this thread wins the
   353	    // connection mutex, commits, wakes the dispatcher, and a worker is holding the
   354	    // write lock by the time `transition` promotes.
   355	    let stop = Arc::new(AtomicBool::new(false));
   356	    let competing_writes = Arc::new(AtomicUsize::new(0));
   357	    let competing_errors = Arc::new(AtomicUsize::new(0));
   358	    let burst = config.burst;
   359	    let pace = config.writer_pace_ms;
   360	    let mut writers = Vec::with_capacity(config.writer_threads);
   361	    for t in 0..config.writer_threads {
   362	        let engine = Arc::clone(&engine);
   363	        let stop = Arc::clone(&stop);
   364	        let writes = Arc::clone(&competing_writes);
   365	        let errors = Arc::clone(&competing_errors);
   366	        writers.push(std::thread::spawn(move || {
   367	            let mut i = 0_usize;
   368	            while !stop.load(Ordering::Relaxed) {
   369	                let batch: Vec<PreparedWrite> = (0..burst)
   370	                    .map(|b| {
   371	                        governed_node(
   372	                            &format!("tc90-load-{label}-{t}-{i}-{b}"),
   373	                            &format!("load {label} {t} {i} {b}"),
   374	                        )
   375	                    })
   376	                    .collect();
   377	                match engine.write(&batch) {
   378	                    Ok(_) => {
   379	                        writes.fetch_add(burst, Ordering::SeqCst);
   380	                    }
   381	                    Err(_) => {
   382	                        errors.fetch_add(1, Ordering::SeqCst);
   383	                    }
   384	                }
   385	                i += 1;
   386	                // Paced, not saturating, on the primary arms: `transition`'s own
   387	                // `drain` must be able to reach idle, or every call would fail with
   388	                // `Scheduler` (a drain timeout) and the arm would measure the wrong
   389	                // thing — MEASURED at `0`: 4 of 5 attempts were `Scheduler`.
   390	                if pace > 0 {
   391	                    std::thread::sleep(Duration::from_millis(pace));
   392	                }
   393	            }
   394	        }));
   395	    }
   396	
   397	    let mut attempted = 0_usize;
   398	    let mut first_storage_failure = None;
   399	    let mut storage_errors = 0_usize;
   400	    let mut scheduler_errors = 0_usize;
   401	    let mut other_errors = 0_usize;
   402	    let mut other_error_kinds: Vec<String> = Vec::new();
   403	    let mut slowest_ok_ms = 0_u128;
   404	    let mut failure_wall_ms = 0_u128;
   405	    let mut truncated = false;
   406	    // Per-subject state tracked from OBSERVED outcomes, never assumed.
   407	    //
   408	    // A failed `transition` rolls back, so the subject keeps its previous state.
   409	    // Deriving the next target from the loop index instead would then aim a flip
   410	    // at the state the row is already in — a self-loop, which the legal-transition
   411	    // table correctly refuses with `IllegalTransition`. That refusal is a CASCADE
   412	    // ARTIFACT of the harness, not a defect, and it would contaminate the very
   413	    // counter under measurement. Advancing only on success keeps `storage_errors`
   414	    // clean.
   415	    let mut subject_states = [LifecycleState::Active; SUBJECTS];
   416	    let loop_deadline = Instant::now() + config.budget;
   417	    for i in 0..config.transitions {
   418	        if Instant::now() >= loop_deadline {
   419	            truncated = true;
   420	            break;
   421	        }
   422	        let slot = i % SUBJECTS;
   423	        let subject = format!("tc90-subject-{slot}");
   424	        let to_state = match subject_states[slot] {
   425	            LifecycleState::Active => LifecycleState::Deleted,
   426	            _ => LifecycleState::Active,
   427	        };
   428	        let started = Instant::now();
   429	        let result = engine.transition(&subject, to_state, None);
   430	        let elapsed = started.elapsed().as_millis();
   431	        attempted += 1;
   432	        match result {
   433	            Ok(()) => {
   434	                subject_states[slot] = to_state;
   435	                slowest_ok_ms = slowest_ok_ms.max(elapsed);
   436	            }
   437	            Err(err) => match err {
   438	                EngineError::Storage => {
   439	                    storage_errors += 1;
   440	                    if first_storage_failure.is_none() {
   441	                        failure_wall_ms = elapsed;
   442	                        first_storage_failure = Some((i, err));
   443	                    }
   444	                }
   445	                EngineError::Scheduler => scheduler_errors += 1,
   446	                other => {
   447	                    other_errors += 1;
   448	                    let kind = format!("{other:?}");
   449	                    if !other_error_kinds.contains(&kind) {
   450	                        other_error_kinds.push(kind);
   451	                    }
   452	                }
   453	            },
   454	        }
   455	    }
   456	
   457	    stop.store(true, Ordering::Relaxed);
   458	    for writer in writers {
   459	        let _ = writer.join();
   460	    }
   461	    let _ = engine.drain(60_000);
   462	    let embed_calls = calls.load(Ordering::SeqCst);
   463	    let _ = engine.close();
   464	
   465	    let outcome = ArmOutcome {
   466	        label,
   467	        attempted,
   468	        truncated,
   469	        first_storage_failure,
   470	        other_error_kinds,
   471	        storage_errors,
   472	        scheduler_errors,
   473	        other_errors,
   474	        competing_writes: competing_writes.load(Ordering::SeqCst),
   475	        competing_write_errors: competing_errors.load(Ordering::SeqCst),
   476	        embed_calls,
   477	        slowest_ok_ms,
   478	        failure_wall_ms,
   479	    };
   480	    outcome.report();
   481	    outcome
   482	}
