   460	// ---------------------------------------------------------------------------
   461	// TC-91 (a) — the MECHANISM experiment
   462	// ---------------------------------------------------------------------------
   463	
   464	/// Rows for the mechanism experiment. Fewer than [`ROWS`] because the spaced arm
   465	/// pays `SPACED_PACE_MS` per row.
   466	const MECHANISM_ROWS: usize = 60;
   467	
   468	/// Write spacing for the SPACED arm. Comfortably longer than the 1 ms embed, so a
   469	/// worker's commit for row *i* has finished before row *i+1*'s `Engine::write`
   470	/// opens its `BEGIN IMMEDIATE` transaction.
   471	const SPACED_PACE_MS: u64 = 25;
   472	
   473	/// **The causal experiment for TC-91 (a): is the duplicate rate caused by the
   474	/// ENGINE'S OWN WRITER holding the WAL write lock across the worker's commit?**
   475	///
   476	/// Two arms of the same governed load differing ONLY in write spacing:
   477	///
   478	/// * **tight** (`pace_ms: 1`) — a write lands roughly every millisecond, which is
   479	///   also the embed latency, so `commit_projection_outcomes`' DEFERRED promotion
   480	///   (`lib.rs:13809`, reads at `:13813` / `:13828` before its writes at `:13863`)
   481	///   frequently lands while `commit_batch`'s `BEGIN IMMEDIATE` (`lib.rs:18637`)
   482	///   holds the lock.
   483	/// * **spaced** (`pace_ms: 25`) — the same rows, the same embedder, the same
   484	///   worker; only the overlap is removed.
   485	///
   486	/// **What a collapse in the spaced arm does and does not establish.** It
   487	/// establishes that the duplicate rate is CADENCE-SENSITIVE — the ~50 % is a
   488	/// property of the write cadence, not a fixed constant of the scheduler. It does
   489	/// **not**, on its own, establish that TC-91 (a) *is* TC-91 (b): spacing the
   490	/// writes changes overlap, but nothing in this arm observes a worker commit
   491	/// failing, because `let _ =` (`lib.rs:12711`) discards exactly that signal. Read
   492	/// together with [`tc91_forced_commit_failure_is_invisible_to_terminal_counting`]
   493	/// it strongly implicates the engine's own writer; see the module header's
   494	/// "What those numbers DO and DO NOT prove" for the precise boundary.
   495	///
   496	/// `#[ignore]`d with the other concurrency arms; it is a measurement, not a
   497	/// merge-gate invariant. See the module header's test-profile inventory.
   498	#[test]
   499	#[ignore = "TC-91 characterization arm — run explicitly with --ignored; see the design doc"]
   500	fn tc91_mechanism_duplicate_rate_versus_write_cadence() {
   501	    let tight = run_duplicate_arm("mech_tight", true, MECHANISM_ROWS, 1);
   502	    assert_duplicate_arm(&tight);
   503	    let spaced = run_duplicate_arm("mech_spaced", true, MECHANISM_ROWS, SPACED_PACE_MS);
   504	    assert_duplicate_arm(&spaced);
   505	
   506	    println!(
   507	        "TC91-MECH tight_duplicates={} spaced_duplicates={} rows={MECHANISM_ROWS}",
   508	        tight.split.ingest_duplicates, spaced.split.ingest_duplicates
   509	    );
   510	
   511	    assert!(
   512	        tight.split.ingest_duplicates > 0,
   513	        "non-vacuity: the TIGHT arm must reproduce the duplicate rate, else there is no effect \
   514	         to explain (duplicates={})",
   515	        tight.split.ingest_duplicates
   516	    );
   517	    assert_eq!(
   518	        spaced.split.ingest_duplicates, 0,
   519	        "TC-91 (a) MECHANISM: spacing writes to {SPACED_PACE_MS} ms took duplicates from {} to \
   520	         {} over {MECHANISM_ROWS} identical rows. The variable is write CADENCE — i.e. how often \
   521	         the engine's own `BEGIN IMMEDIATE` writer holds the WAL write lock across the worker's \
   522	         DEFERRED commit promotion. If this ever becomes non-zero, a SECOND duplicate source \
   523	         exists that this experiment does not explain, and the design doc's mechanism section \
   524	         must be re-opened.",
   525	        tight.split.ingest_duplicates, spaced.split.ingest_duplicates,
   526	    );
   527	}
   528	
   529	// ---------------------------------------------------------------------------
   530	// The probe's cost at HEAD — the trap, disarmed by measurement
   531	// ---------------------------------------------------------------------------
   532	
   533	/// Probes in the committed `vector_equivalence_probes.txt` fixture — the
   534	/// non-empty, non-comment lines `vector_equivalence_probes()` parses
   535	/// (`lib.rs:15242-15251`). Deterministic: the fixture is checked in, so this is a
   536	/// property of the tree, not of the run.
   537	const PROBE_FIXTURE_SIZE: usize = 45;
   538	
   539	/// What the POPULATION open costs: `probe_populate_or_check` populates the
   540	/// baseline (one embed per probe) and then immediately checks against it (one
   541	/// more each).
   542	const POPULATION_OPEN_PROBE_EMBEDS: usize = PROBE_FIXTURE_SIZE * 2;
   543	
   544	/// **What the vector-equivalence probe actually costs per open at HEAD.**
   545	///
   546	/// Not `#[ignore]`d — see the module header's test-profile inventory. It is
   547	/// sequential and fully deterministic (no threads, no racing writer, every
   548	/// `drain` awaited), and it is the figure every other embed measurement in this
   549	/// repo has to subtract.
   550	///
   551	/// Three opens of ONE workspace, each measured as a DELTA (ledger `seq-125`:
   552	/// absolute embed counts are unusable as an oracle across a reopen):
   553	///
   554	/// 1. **open 1** — fresh workspace, no vector kind yet ⇒ the probe returns early
   555	///    at `lib.rs:15351` having embedded nothing. The kind is enrolled after open.
   556	/// 2. **open 2** — a vector kind now exists and `_fathomdb_embed_probe` is empty
   557	///    ⇒ `probe_populate_or_check` (`lib.rs:15384-15389`) POPULATES 45 and then
   558	///    CHECKS 45.
   559	/// 3. **open 3** — the TC-68 fingerprint verdict cache (`lib.rs:15566`) decides
   560	///    whether the 45 re-embeds happen again.
   561	///
   562	/// **All three opens are pinned EXACTLY** (`0 / 90 / 0`), which is a change from
   563	/// this file's first draft — codex §9 round 4 finding 2. The first draft asserted
   564	/// only `open3 < open2`, while the design doc published a measured `0 / 90 / 0`
   565	/// as a *correction* to a stale on-the-record figure of 45 re-embeds per open. A
   566	/// regression back to 45 would have passed `45 < 90` silently, leaving the doc
   567	/// publishing a zero the tree no longer honoured. When a characterization's whole
   568	/// value is the number, the number is what must be asserted.
   569	#[test]
   570	fn tc91_probe_embed_cost_per_open_at_head() {
   571	    let dir = TempDir::new().expect("tempdir");
   572	    let path = dir.path().join(format!("tc91_probe{SQLITE_SUFFIX}"));
   573	
   574	    // --- open 1: fresh workspace, kind enrolled AFTER open ------------------
   575	    let log1 = EmbedLog::default();
   576	    let opened = Engine::open_with_embedder_for_test(
   577	        &path,
   578	        Arc::new(RecordingEmbedder::new(&log1, Duration::ZERO)),
   579	    )
   580	    .expect("open 1");
   581	    let open1_probe_embeds = log1.total();
   582	    opened.engine.configure_vector_kind_for_test("doc").expect("vector kind");
   583	    opened.engine.write(&[node(0, true)]).expect("seed write");
   584	    opened.engine.drain(60_000).expect("drain 1");
   585	    opened.engine.close().expect("close 1");
   586	
   587	    // --- open 2: vector kind present, probe table empty ---------------------
   588	    let log2 = EmbedLog::default();
   589	    let opened = Engine::open_with_embedder_for_test(
   590	        &path,
   591	        Arc::new(RecordingEmbedder::new(&log2, Duration::ZERO)),
   592	    )
   593	    .expect("open 2");
   594	    let open2_probe_embeds = log2.total();
   595	    opened.engine.close().expect("close 2");
   596	
   597	    // --- open 3: probe table populated; TC-68 cache decides -----------------
   598	    let log3 = EmbedLog::default();
   599	    let opened = Engine::open_with_embedder_for_test(
   600	        &path,
   601	        Arc::new(RecordingEmbedder::new(&log3, Duration::ZERO)),
   602	    )
   603	    .expect("open 3");
   604	    let open3_probe_embeds = log3.total();
