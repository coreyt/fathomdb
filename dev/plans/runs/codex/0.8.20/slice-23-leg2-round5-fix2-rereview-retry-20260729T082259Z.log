   145	  if [ "$rc" -ne 0 ]; then f=$((f+1)); fi
   146	done
   147	echo "STRESS REPRO FAILURES: $f/10"
   148	```
   149	
   150	**Stress control arm** (N = 10):
   151	
   152	```bash
   153	f=0
   154	for i in $(seq 1 10); do
   155	  cargo test -p fathomdb-engine --test tc90_transition_write_race -- \
