 15819	/// 0.8.18 Slice 5 — un-centered Euclidean (L2) distance, matching the
 15820	/// `vec_distance_l2` semantics used by the Phase-2 rerank.
 15821	fn l2_distance(a: &[f32], b: &[f32]) -> f32 {
 15822	    a.iter().zip(b.iter()).map(|(x, y)| (x - y) * (x - y)).sum::<f32>().sqrt()
 15823	}
