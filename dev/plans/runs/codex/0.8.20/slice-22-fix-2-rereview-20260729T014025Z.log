 15503	/// 0.8.20 Slice 22 (TC-68) — is `fingerprint` the fingerprint under which the
 15504	/// probe last RAN and PASSED on this workspace?
 15505	///
 15506	/// Fail-SAFE against ACCIDENT (R-VEQ-4): **every** failure mode answers `false`,
 15507	/// which means "run the probe". A missing `_fathomdb_open_state` table, an absent
 15508	/// row, a non-TEXT value, a truncated or garbled value, a stale fingerprint, any
 15509	/// SQL error — none of them can be mistaken for a pass.
 15510	///
 15511	/// # What a `true` does and does not mean (fix-1, codex §9 round 2 [P1])
 15512	///
 15513	/// `true` means: **the fingerprint inputs are unchanged since *some* engine
 15514	/// recorded a pass.** It does NOT mean "this engine verified this backend", and it
 15515	/// cannot: the fingerprint is a SHA-256 over deterministic, publicly derivable DB
 15516	/// and build inputs, so an actor with write access to the file can compute the
 15517	/// current digest and write it here, skipping the 45-probe verification. This
 15518	/// marker is not — and cannot be — an authenticated attestation; an embedded
 15519	/// local-first engine holds no secret with which to authenticate one, and a salt
 15520	/// would be readable by the same actor.
 15521	///
 15522	/// The same actor also defeats the same arm through the **pre-slice** path, by
 15523	/// re-baselining `_fathomdb_embed_probe`'s `reference_vec` blobs to their drifted
 15524	/// backend's own output — the probe then runs in full and verifies the drifted
 15525	/// backend against itself. Measured by
 15526	/// `tests/tc68_probe_fingerprint_cache.rs::a_forged_stored_baseline_defeats_the_probe_even_when_it_fully_runs`
 15527	/// (marker deleted, all 45 embeds performed, dense still enabled), with the
 15528	/// un-forged control caught.
 15529	///
 15530	/// **That is the same actor, NOT the same cost, and fix-2 struck the claim that it
 15531	/// was.** Forging this marker needs only a publicly computable digest — usually the
 15532	/// value already sitting in the row. Re-baselining additionally needs the target
 15533	/// backend's 45 exact embeddings, encoded into every row. **So the cache IS a
 15534	/// cheaper bypass** for a writer of the database file.
 15535	///
 15536	/// What bounds it is the ruled residual, not this marker. A same-identity backend
 15537	/// drift moves no fingerprint input, so a marker recorded by an **honest** earlier
 15538	/// open already skips the probe and already serves the drifted backend, with no
 15539	/// forgery anywhere
 15540	/// (`residual_same_identity_backend_drift_is_not_caught_on_a_cached_open`). Forgery
 15541	/// adds capability only on an open where no valid marker exists for the *current*
 15542	/// fingerprint — and a digest is valid only for the state it was computed over, so
 15543	/// it stops working at the next change to any fingerprint input.
 15544	///
 15545	/// The equivalence probe is a **correctness self-check against backend drift, not
 15546	/// tamper evidence**; `dense_disabled` is not a tamper signal. Threat model, with
 15547	/// the concession and the bound: §8.4/§8.5 of
 15548	/// `dev/design/0.8.20-tc68-equivalence-probe-fingerprint-cache.md`.
 15549	fn probe_verification_is_cached(connection: &Connection, fingerprint: &str) -> bool {
 15550	    connection
 15551	        .query_row(
 15552	            "SELECT value FROM _fathomdb_open_state WHERE key = ?1",
 15553	            [VECTOR_EQUIVALENCE_VERDICT_CACHE_KEY],
 15554	            |row| row.get::<_, String>(0),
 15555	        )
 15556	        .map(|cached| cached == fingerprint)
 15557	        .unwrap_or(false)
 15558	}
 15559	
 15560	/// 0.8.20 Slice 22 (TC-68) — record that the probe RAN and PASSED under
 15561	/// `fingerprint`.
 15562	///
 15563	/// A write failure is deliberately SWALLOWED rather than turned into a verdict
 15564	/// failure. The arm has just been verified, so refusing dense because a marker
 15565	/// could not be persisted (read-only file, disk full) would be a false refusal;
 15566	/// and the consequence of the missing marker is simply that the next open re-runs
 15567	/// the probe — more work, never less. That is the fail-safe direction.
 15568	fn record_probe_verification(connection: &Connection, fingerprint: &str) {
 15569	    let _ = connection.execute(
 15570	        "INSERT INTO _fathomdb_open_state(key, value) VALUES(?1, ?2)
 15571	         ON CONFLICT(key) DO UPDATE SET value = excluded.value",
 15572	        params![VECTOR_EQUIVALENCE_VERDICT_CACHE_KEY, fingerprint],
 15573	    );
 15574	}
 15575	
 15576	/// 0.8.20 Slice 22 (TC-68) — drop any cached verdict.
 15577	///
 15578	/// Called on EVERY failure path of the check, so a workspace that could not be
 15579	/// verified never carries a marker a later open might match. A failing verdict is
 15580	/// therefore never cached: the probe re-runs each open until it passes again.
 15581	fn clear_probe_verification(connection: &Connection) {
 15582	    let _ = connection.execute(
 15583	        "DELETE FROM _fathomdb_open_state WHERE key = ?1",
 15584	        [VECTOR_EQUIVALENCE_VERDICT_CACHE_KEY],
 15585	    );
 15586	}
 15587	
 15588	/// 0.8.18 Slice 5 — SUBSEQUENT open: re-embed the 45 probes and assert BOTH
 15589	/// dense-pipeline representations against the stored references — **(P1)** the
 15590	/// mean-centered `embedding_bin` sign-flip count (floor 0, exact) and **(P2)** the
 15591	/// un-centered Phase-2 L2 (within `VECTOR_EQUIVALENCE_L2_EPSILON`).
 15592	///
 15593	/// 0.8.20 Slice 22 (TC-68) — this wrapper adds the failure half of the verdict
 15594	/// cache: ANY `Err` from the inner check drops the cached marker, so a workspace
 15595	/// that could not be verified never leaves a stale "verified" marker behind for a
 15596	/// later open to match. (A failing verdict is never *written*; this also clears a
 15597	/// marker left by an earlier, passing open whose fingerprint has since changed.)
 15598	fn probe_check_against_baseline(
 15599	    connection: &Connection,
 15600	    embedder: &dyn Embedder,
 15601	    identity: &EmbedderIdentity,
 15602	    mean_pinned: bool,
 15603	    probes: &[&str],
 15604	) -> Result<(), String> {
 15605	    let outcome =
 15606	        probe_check_against_baseline_inner(connection, embedder, identity, mean_pinned, probes);
 15607	    if outcome.is_err() {
 15608	        clear_probe_verification(connection);
 15609	    }
 15610	    outcome
 15611	}
 15612	
 15613	/// 0.8.18 Slice 5 — the check proper. Fail-SAFE (fix-1 DEFECT #1): a probe embed
 15614	/// that panics/errors/returns wrong-dim, a malformed/missing reference row, an
 15615	/// unreadable pinned mean, or a `vec_quantize_binary`/L2 SQL failure each ⇒ `Err`
 15616	/// (cannot verify ⇒ refuse dense), never a silent skip-and-serve.
 15617	///
 15618	/// fix-2 (DEFECT #1 residual): BEFORE the divergence check, the STORED baseline is
 15619	/// validated to be EXACTLY the committed probe set — the expected row count, a
 15620	/// contiguous 0-based `probe_ordinal` per committed probe, each `probe_text` equal
 15621	/// to the committed fixture text at that ordinal, each `reference_vec` a well-formed
 15622	/// `4 * dim` f32 blob, and the stored embedder identity/dim matching the current
 15623	/// one. This closes the partial-baseline / external-tamper fail-open (a 44-of-45
 15624	/// table, or a re-attributed/mangled row, previously verified only the rows present
 15625	/// or re-embedded a tampered `probe_text` against itself). Any mismatch ⇒ `Err`.
 15626	///
 15627	/// 0.8.20 Slice 22 (TC-68) — the 45 re-embeds are CACHED against
 15628	/// [`probe_verification_fingerprint`]. Note WHERE the cache check sits: after the
 15629	/// mean resolution and after the fix-2 completeness validation, before the
 15630	/// re-embed loop. That split is deliberate — everything cheap keeps running on
 15631	/// EVERY open (so a short, re-attributed, mangled or fixture-mismatched baseline
 15632	/// still fails closed immediately), and only the expensive part, the 45 model
 15633	/// invocations, is skipped. The residual this buys is recorded in
 15634	/// `dev/design/0.8.20-tc68-equivalence-probe-fingerprint-cache.md`.
 15635	fn probe_check_against_baseline_inner(
 15636	    connection: &Connection,
 15637	    embedder: &dyn Embedder,
 15638	    identity: &EmbedderIdentity,
 15639	    mean_pinned: bool,
 15640	    probes: &[&str],
 15641	) -> Result<(), String> {
 15642	    let dimension = identity.dimension as usize;
 15643	
 15644	    // Resolve the live mean. Fail-SAFE: if centering is required + pinned but the
 15645	    // mean cannot be read, we cannot reproduce `embedding_bin` ⇒ refuse (P1
 15646	    // un-verifiable). NoopEmbedder / no-pin ⇒ un-centered on BOTH sides (R-VEQ-3c).
 15647	    let mean_vec = if identity_requires_mean_centering(identity) && mean_pinned {
 15648	        match read_pinned_mean_vec(connection, identity.dimension) {
 15649	            Ok(Some(mean)) => Some(mean),
 15650	            Ok(None) => {
 15651	                return Err("mean-centering is required and pinned but mean_vec is absent; \
 15652	                     cannot verify P1 (dense arm refused)"
 15653	                    .to_string());
 15654	            }
 15655	            Err(_) => {
 15656	                return Err(
 15657	                    "could not read the pinned mean_vec; cannot verify P1 (dense arm refused)"
 15658	                        .to_string(),
 15659	                );
 15660	            }
 15661	        }
 15662	    } else {
 15663	        None
 15664	    };
 15665	
 15666	    let mut stmt = connection
 15667	        .prepare(
 15668	            "SELECT probe_ordinal, probe_text, reference_vec, embedder_name, embedder_revision, dim \
 15669	             FROM _fathomdb_embed_probe ORDER BY probe_ordinal",
 15670	        )
 15671	        .map_err(|e| format!("could not read the stored probe references: {e}; cannot verify"))?;
 15672	    let stored: Vec<StoredProbeRow> = stmt
 15673	        .query_map([], |row| {
 15674	            Ok((
 15675	                row.get::<_, i64>(0)?,
 15676	                row.get::<_, String>(1)?,
 15677	                row.get::<_, Vec<u8>>(2)?,
 15678	                row.get::<_, String>(3)?,
 15679	                row.get::<_, String>(4)?,
 15680	                row.get::<_, i64>(5)?,
 15681	            ))
 15682	        })
 15683	        .and_then(|rows| rows.collect::<rusqlite::Result<Vec<_>>>())
 15684	        .map_err(|e| format!("could not read the stored probe references: {e}; cannot verify"))?;
 15685	
 15686	    // fix-2 (DEFECT #1 residual) — COMPLETENESS validation of the STORED baseline.
 15687	    // `COUNT(*) > 0` is NOT proof of a complete, trustworthy baseline: a partially
 15688	    // populated or externally-tampered probe table (44 of 45 rows, a gap/dupe in the
 15689	    // ordinals, a mangled reference blob, a mismatched probe_text, or a foreign
 15690	    // embedder identity) is UNVERIFIABLE stored state. The prior code re-embedded
 15691	    // the STORED probe_text and compared it to its OWN reference, so a tampered
 15692	    // probe_text verified against itself and a short table verified only the rows
 15693	    // present — both fail-OPEN. Atomic population stops the ENGINE from writing a
 15694	    // partial set; this closes external corruption, a manual edit, and a future
 15695	    // migration bug the engine did not author. Any mismatch ⇒ fail CLOSED (dense
 15696	    // refused); the text-only/FTS path still serves. The stored baseline must be
 15697	    // EXACTLY the committed probe set, in order, under the current identity.
 15698	    if stored.len() != probes.len() {
 15699	        return Err(format!(
 15700	            "the probe reference table has {} rows but the committed fixture defines {}; \
 15701	             the stored baseline is incomplete or corrupt — cannot verify the dense arm (refused)",
 15702	            stored.len(),
 15703	            probes.len()
 15704	        ));
 15705	    }
 15706	    for (idx, (ordinal, probe_text, ref_blob, name, revision, dim)) in stored.iter().enumerate() {
 15707	        // Contiguous 0-based ordinals, one per committed probe (no gaps/dupes).
 15708	        if *ordinal != idx as i64 {
 15709	            return Err(format!(
 15710	                "probe reference ordinals are non-contiguous (row {idx} carries ordinal {ordinal}); \
 15711	                 the stored baseline is corrupt — cannot verify the dense arm (refused)"
 15712	            ));
 15713	        }
 15714	        // The stored text MUST be the committed fixture text at this ordinal —
 15715	        // otherwise a tampered probe_text re-embeds and verifies against ITSELF,
 15716	        // masking drift (the exact fail-open this fix closes).
 15717	        if probe_text != probes[idx] {
 15718	            return Err(format!(
 15719	                "probe reference {ordinal} text does not match the committed fixture; \
 15720	                 the stored baseline is tampered or corrupt — cannot verify the dense arm (refused)"
 15721	            ));
 15722	        }
 15723	        // Well-formed f32[dim] reference (4*dim little-endian bytes).
 15724	        if ref_blob.len() != dimension * 4 {
 15725	            return Err(format!(
 15726	                "probe reference {ordinal} is malformed (len {} != {}); \
 15727	                 cannot verify the dense arm (refused)",
 15728	                ref_blob.len(),
 15729	                dimension * 4
 15730	            ));
 15731	        }
 15732	        // The stored embedder identity/dim must match the CURRENT expected identity
 15733	        // (defence-in-depth beyond `check_embedder_profile`: catches a baseline row
 15734	        // re-attributed to a foreign embedder by external edit/migration).
 15735	        if *dim != identity.dimension as i64
 15736	            || name != &identity.name
 15737	            || revision != &identity.revision
 15738	        {
 15739	            return Err(format!(
 15740	                "probe reference {ordinal} was captured under embedder {name}/{revision}/dim={dim} \
 15741	                 but the current embedder is {}/{}/dim={}; the stored baseline does not match — \
 15742	                 cannot verify the dense arm (refused)",
 15743	                identity.name, identity.revision, identity.dimension
 15744	            ));
 15745	        }
 15746	    }
 15747	
 15748	    // 0.8.20 Slice 22 (TC-68) — the CACHE gate. Everything above this line ran on
 15749	    // this open and still fails closed; everything below it is the 45 model
 15750	    // invocations that made `Engine::open` cost a flat 45 embeds FOREVER (measured
 15751	    // at `94bb33ef`: 0 with no enrolled kind, 90 on the one-time population open,
 15752	    // 45 on every open thereafter — independent of the enrolled-kind count, since
 15753	    // the probe gate is an `EXISTS` and the body never iterates kinds).
 15754	    //
 15755	    // If the probe already RAN and PASSED under this exact fingerprint, re-running
 15756	    // it is a pure re-computation of a known answer, so the verdict is reused.
 15757	    // Fail-SAFE: `probe_verification_is_cached` answers `false` for every failure
 15758	    // mode — missing table, absent row, garbled value, SQL error — so an
 15759	    // unreadable cache RUNS the probe, it never short-circuits to trusting it.
 15760	    let fingerprint = probe_verification_fingerprint(identity, mean_vec.as_deref(), &stored);
 15761	    if probe_verification_is_cached(connection, &fingerprint) {
 15762	        return Ok(());
 15763	    }
 15764	
 15765	    let mut total_flips: u64 = 0;
 15766	    let mut max_l2: f32 = 0.0;
 15767	    let mut worst_probe: Option<String> = None;
 15768	
 15769	    for (ordinal, probe_text, ref_blob, _, _, _) in &stored {
 15770	        let reference = decode_vector_blob(ref_blob);
 15771	        let reembed = probe_embed(embedder, probe_text, dimension).ok_or_else(|| {
 15772	            format!(
 15773	                "embedder failed/panicked re-embedding probe {ordinal}; \
 15774	                 cannot verify the dense arm (refused)"
 15775	            )
 15776	        })?;
 15777	
 15778	        // (P2) un-centered L2 — `vec_distance_l2(embedding, vec_f32(query))`.
 15779	        let l2 = l2_distance(&reembed, &reference);
 15780	        if l2 > max_l2 {
 15781	            max_l2 = l2;
 15782	            worst_probe = Some(probe_text.clone());
 15783	        }
 15784	
 15785	        // (P1) mean-centered Phase-1 flip count — same
 15786	        // `vec_quantize_binary(sign(x − mean_vec))` path as build_vector_phase1_sql.
 15787	        let (ref_c, reembed_c) = match &mean_vec {
 15788	            Some(mean) => (subtract_mean(&reference, mean), subtract_mean(&reembed, mean)),
 15789	            None => (reference.clone(), reembed.clone()),
 15790	        };
 15791	        let ref_bits = quantize_binary_via_sql(connection, &ref_c).ok_or_else(|| {
 15792	            format!("vec_quantize_binary SQL failed for probe {ordinal}; cannot verify P1")
 15793	        })?;
 15794	        let reembed_bits = quantize_binary_via_sql(connection, &reembed_c).ok_or_else(|| {
 15795	            format!("vec_quantize_binary SQL failed for probe {ordinal}; cannot verify P1")
 15796	        })?;
 15797	        total_flips = total_flips.saturating_add(hamming_bytes(&ref_bits, &reembed_bits));
 15798	    }
 15799	
 15800	    let p1_tripped = total_flips > VECTOR_EQUIVALENCE_P1_FLIP_FLOOR;
 15801	    let p2_tripped = max_l2 > VECTOR_EQUIVALENCE_L2_EPSILON;
 15802	    if p1_tripped || p2_tripped {
 15803	        let probe_hint = worst_probe.as_deref().unwrap_or("<unknown>");
 15804	        return Err(format!(
 15805	            "P1 mean-centered embedding_bin flips={total_flips} (floor={VECTOR_EQUIVALENCE_P1_FLIP_FLOOR}), \
 15806	             P2 max un-centered L2={max_l2:.3e} (epsilon={VECTOR_EQUIVALENCE_L2_EPSILON:.3e}); \
 15807	             worst probe {probe_hint:?}"
 15808	        ));
 15809	    }
 15810	
 15811	    // 0.8.20 Slice 22 (TC-68) — the probe RAN and PASSED; record the fingerprint
 15812	    // so the next open with identical inputs need not repeat it. Only a verdict
 15813	    // this engine reached itself is ever written (the failure paths above return
 15814	    // early, and the wrapper clears any prior marker on them).
 15815	    record_probe_verification(connection, &fingerprint);
 15816	    Ok(())
 15817	}
