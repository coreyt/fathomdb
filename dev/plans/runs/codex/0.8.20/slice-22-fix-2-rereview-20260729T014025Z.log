   627	
   628	/// **THE NARROWING TC-68 BUYS.** Before TC-68, a same-identity backend that
   629	/// drifted (candle CPU↔CUDA, a library/driver change) was caught at the NEXT open,
   630	/// because the probe re-ran every time. With the verdict cached against a
   631	/// fingerprint that such a drift does not move, it is no longer caught per-open —
   632	/// it is caught only when some fingerprint input changes.
   633	///
   634	/// This is the ruled trade (`dev/plans/plan-0.8.20.md` §3 R-20-VC), and it is a
   635	/// real narrowing of an HITL-signed guarantee
   636	/// (`dev/adr/ADR-0.8.18-vector-equivalence-self-check.md`). It is asserted here so
   637	/// it is reviewable and cannot be quietly reinterpreted as "preserved".
   638	///
   639	/// At `94bb33ef` this test FAILS — the drift *is* caught. That failure is the
   640	/// honest statement of what changes.
   641	///
   642	/// **fix-2 — this is also the BOUND on the forged-marker finding (§8.5 of the design
   643	/// note).** There is no forgery anywhere in this test: the marker is the one the
   644	/// ENGINE ITSELF recorded at the honest population open, asserted below to be
   645	/// present beforehand and byte-unchanged afterwards. A same-identity backend swap
   646	/// moves no fingerprint input, so that honest marker still matches and the drifted
   647	/// backend is served anyway. Whatever forging a marker buys an attacker, it does not
   648	/// buy *this* — the ruled trade already grants it, free. Forgery adds capability
   649	/// only on an open where no valid marker exists for the CURRENT fingerprint.
   650	#[test]
   651	fn residual_same_identity_backend_drift_is_not_caught_on_a_cached_open() {
   652	    let dir = TempDir::new().unwrap();
   653	    let path = db_path(&dir);
   654	    let calls = counter();
   655	    seed_verified_workspace(&path, &calls);
   656	
   657	    // fix-2: the marker in play is the ENGINE'S OWN, written by the honest
   658	    // population open above. Nothing in this test writes or computes a digest.
   659	    let honest_marker =
   660	        read_verdict_marker(&path).expect("the honest population open records its own verdict");
   661	
   662	    // Same identity, same pinned mean (none), same baseline, same fixture — only
   663	    // the BACKEND changed, which no fingerprint input can see.
   664	    let (embeds, degraded) = open_count_close(
   665	        &path,
   666	        Arc::new(CountingDivergentEmbedder { calls: calls.clone() }),
   667	        &calls,
   668	    );
   669	
   670	    assert_eq!(embeds, 0, "the cached verdict answers, so the drifted backend is never asked");
   671	    assert!(
   672	        !degraded,
   673	        "RESIDUAL: same-identity backend drift is NOT caught on a cached open — \
   674	         it is caught only at the next open whose fingerprint changed"
   675	    );
   676	    assert_eq!(
   677	        read_verdict_marker(&path).as_deref(),
   678	        Some(honest_marker.as_str()),
   679	        "fix-2 (§8.5): the drifted backend was served off the ENGINE'S OWN marker, \
   680	         unchanged — no forgery was involved, so a forged marker buys nothing here"
   681	    );
   682	}
