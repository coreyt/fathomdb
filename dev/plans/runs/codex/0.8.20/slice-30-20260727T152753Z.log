  # SCHEMA moves, the next slice changes) — i.e. a code push, which the
  # `markdownlint` job's `docs_only` gate excludes by construction. A currency
  # gate that cannot run on the push that makes the fact wrong is decorative.
  #
  # Default (depth-1) checkout is sufficient: the predicate reads working-tree
  # files only and walks no history.
  release-state-views:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
