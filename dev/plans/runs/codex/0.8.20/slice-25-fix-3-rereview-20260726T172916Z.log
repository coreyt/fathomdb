  1253	/// The per-statement tail of the normalisation: collapse whitespace, then
  1254	/// tighten qualified names so a schema qualifier is ONE token.
  1255	fn normalize_statement(raw: &str) -> String {
  1256	    tighten_qualified_names(&collapse_whitespace(raw))
  1257	}
  1258	
  1259	fn collapse_whitespace(raw: &str) -> String {
  1260	    raw.split_whitespace().collect::<Vec<_>>().join(" ")
  1261	}
  1262	
  1263	/// Remove whitespace around `.` so `main . canonical_nodes` normalises to
  1264	/// `MAIN.CANONICAL_NODES`.
  1265	///
  1266	/// SQLite's tokenizer accepts whitespace around the qualifier dot (verified
  1267	/// against SQLite 3.45: `UPDATE main . t SET …` parses and targets `main.t`),
  1268	/// while the token extractors below cut at whitespace — so without this the
  1269	/// spaced spelling would extract the bare token `MAIN` and slip the pin.
  1270	/// Comments are already stripped and string literals already elided to `''` by
  1271	/// this point, so no `.` that survives here is data.
  1272	fn tighten_qualified_names(statement: &str) -> String {
  1273	    if !statement.contains('.') {
  1274	        return statement.to_string();
  1275	    }
  1276	    statement.split('.').map(str::trim).collect::<Vec<_>>().join(".")
  1277	}
