  1421	/// SQLite's five `UPDATE OR <conflict-action>` / `INSERT OR <conflict-action>`
  1422	/// spellings (verified against SQLite 3.45.1).
  1423	const SQLITE_CONFLICT_ACTIONS: [&str; 5] = ["ROLLBACK", "ABORT", "FAIL", "IGNORE", "REPLACE"];
  1424	
  1425	/// The target table of an `UPDATE`, skipping SQLite's optional conflict clause.
  1426	///
  1427	/// `UPDATE OR REPLACE canonical_nodes SET logical_id = …` is a valid, running
  1428	/// backfill; the conflict action sits BETWEEN the keyword and the table name, so
  1429	/// taking the first token after `UPDATE ` yields `OR` and the pin is bypassed.
  1430	/// The skip is token-EXACT (the action must be a whole token followed by a
  1431	/// space), so a table actually named `or_ledger` is still read as the table.
  1432	///
  1433	/// The `INSERT`/`REPLACE` arm needs no equivalent: it anchors on ` INTO `, which
  1434	/// the conflict clause precedes (`INSERT OR IGNORE INTO canonical_nodes …`).
  1435	fn update_target_table(statement: &str) -> Option<String> {
  1436	    let mut rest = statement.strip_prefix("UPDATE ")?;
  1437	    if let Some(after_or) = rest.strip_prefix("OR ") {
  1438	        if let Some(after_action) = SQLITE_CONFLICT_ACTIONS
  1439	            .iter()
  1440	            .find_map(|action| after_or.strip_prefix(*action)?.strip_prefix(' '))
  1441	        {
  1442	            rest = after_action;
  1443	        }
  1444	    }
  1445	    first_token(rest)
  1446	}
