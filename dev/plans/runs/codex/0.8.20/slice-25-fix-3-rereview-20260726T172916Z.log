  1388	/// The bare table name from a possibly schema-qualified token.
  1389	///
  1390	/// SQLite resolves `main.canonical_nodes` (or `temp.canonical_nodes`, or any
  1391	/// quoted spelling of either half — the normaliser has already unwrapped those)
  1392	/// to the SAME pinned table as the bare name, so the qualifier is stripped
  1393	/// before the comparison. SQLite permits at most ONE qualifier, so the part
  1394	/// after the dot is the table name. This is a STRIP, not a widening to a
  1395	/// substring match: `main.canonical_nodes_old` is still a different table.
  1396	fn bare_table_name(token: &str) -> &str {
  1397	    token.rsplit_once('.').map_or(token, |(_, table)| table)
  1398	}
