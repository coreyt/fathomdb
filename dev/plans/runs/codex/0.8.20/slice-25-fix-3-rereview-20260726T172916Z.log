  1453	/// The leading identifier token of `rest`, cut at whitespace, `(` or `,`.
  1454	fn first_token(rest: &str) -> Option<String> {
  1455	    let token: String =
  1456	        rest.chars().take_while(|c| !c.is_whitespace() && *c != '(' && *c != ',').collect();
  1457	    (!token.is_empty()).then_some(token)
  1458	}
  1459	
  1460	/// `(table, remainder-after-the-table-name)` for an `INSERT`/`REPLACE … INTO …`.
  1461	fn table_after_into(statement: &str) -> Option<(String, String)> {
  1462	    let rest = statement.split_once(" INTO ")?.1;
  1463	    let table: String =
  1464	        rest.chars().take_while(|c| !c.is_whitespace() && *c != '(' && *c != ',').collect();
  1465	    (!table.is_empty()).then(|| (table.clone(), rest[table.len()..].to_string()))
  1466	}
  1467	
  1468	/// The assignment half of an `UPDATE`: everything between ` SET ` and the first
  1469	/// clause keyword that ends it.
  1470	fn set_clause(statement: &str) -> Option<&str> {
  1471	    let after_set = statement.split_once(" SET ")?.1;
  1472	    let end = [" WHERE ", " FROM ", " RETURNING "]
  1473	        .iter()
  1474	        .filter_map(|kw| after_set.find(kw))
  1475	        .min()
  1476	        .unwrap_or(after_set.len());
  1477	    Some(&after_set[..end])
  1478	}
