  1178	/// Split `sql` into per-statement NORMALISED views: comments removed, string
  1179	/// literals elided to `''`, quoted identifiers unwrapped to bare ones,
  1180	/// uppercased, whitespace collapsed to single spaces.
  1181	///
  1182	/// Scanning is strictly left-to-right so precedence is correct: a `--` inside a
  1183	/// string literal is data, and a `'` inside a comment is prose.
  1184	fn normalized_statements(sql: &str) -> Vec<String> {
  1185	    let mut statements = Vec::new();
  1186	    let mut current = String::new();
  1187	    let chars: Vec<char> = sql.chars().collect();
  1188	    let mut i = 0;
  1189	
  1190	    while i < chars.len() {
  1191	        let c = chars[i];
  1192	        match c {
  1193	            // Line comment: drop to end of line (the newline becomes whitespace).
  1194	            '-' if chars.get(i + 1) == Some(&'-') => {
  1195	                while i < chars.len() && chars[i] != '\n' {
  1196	                    i += 1;
  1197	                }
  1198	            }
  1199	            // Block comment: drop to the closing delimiter.
  1200	            '/' if chars.get(i + 1) == Some(&'*') => {
  1201	                i += 2;
  1202	                while i < chars.len() && !(chars[i] == '*' && chars.get(i + 1) == Some(&'/')) {
  1203	                    i += 1;
  1204	                }
  1205	                i = (i + 2).min(chars.len());
  1206	                current.push(' ');
  1207	            }
  1208	            // String literal: elide the contents (they can never be an
  1209	            // identifier). `''` inside a literal is an escaped quote.
  1210	            '\'' => {
  1211	                i += 1;
  1212	                while i < chars.len() {
  1213	                    if chars[i] == '\'' {
  1214	                        if chars.get(i + 1) == Some(&'\'') {
  1215	                            i += 2;
  1216	                            continue;
  1217	                        }
  1218	                        i += 1;
  1219	                        break;
  1220	                    }
  1221	                    i += 1;
  1222	                }
  1223	                current.push_str("''");
  1224	            }
  1225	            // Quoted identifiers: UNWRAP them, so `"logical_id"` / `[logical_id]`
  1226	            // / `` `logical_id` `` are the same identifier to the guard that they
  1227	            // are to SQLite.
  1228	            '"' | '`' | '[' => {
  1229	                let close = if c == '[' { ']' } else { c };
  1230	                i += 1;
  1231	                while i < chars.len() && chars[i] != close {
  1232	                    current.push(chars[i].to_ascii_uppercase());
  1233	                    i += 1;
  1234	                }
  1235	                i += 1;
  1236	            }
  1237	            ';' => {
  1238	                statements.push(normalize_statement(&current));
  1239	                current.clear();
  1240	                i += 1;
  1241	            }
  1242	            _ => {
  1243	                current.push(c.to_ascii_uppercase());
  1244	                i += 1;
  1245	            }
  1246	        }
  1247	    }
  1248	    statements.push(normalize_statement(&current));
  1249	    statements.retain(|s| !s.is_empty());
  1250	    statements
  1251	}
