  1279	/// Does one NORMALISED statement write into `logical_id` on a canonical table?
  1280	fn statement_violates_logical_id_pin(statement: &str) -> bool {
  1281	    let names_column = statement.contains(PINNED_IDENTITY_COLUMN);
  1282	
  1283	    // FIRST, and independent of the leading keyword: the keyword-anchored arms
  1284	    // below all begin `statement.starts_with(…)`, and SQLite's grammar allows a
  1285	    // `WITH …` CTE clause in FRONT of UPDATE / INSERT / DELETE — so
  1286	    // `WITH x AS (SELECT 1) UPDATE canonical_nodes SET logical_id = …` runs the
  1287	    // forbidden backfill while starting with none of them. This catch-all closes
  1288	    // that whole family without a paren-matching CTE parser, and runs BEFORE the
  1289	    // arms because several of them `return false` early (a non-pinned UPDATE
  1290	    // target, say), which would otherwise shadow it.
  1291	    if writes_pinned_identity_anywhere(statement, names_column) {
  1292	        return true;
  1293	    }
  1294	
  1295	    // A trigger is a deferred write; one that so much as mentions the identity
  1296	    // column AND names a canonical table — as its ON-target, or anywhere in the
  1297	    // first body statement, which the `;` split glues onto the head — is refused
  1298	    // whole. Later body statements split into their own fragments, which the
  1299	    // UPDATE / INSERT arms below catch independently.
  1300	    if statement.starts_with("CREATE") && statement.contains(" TRIGGER ") && names_column {
  1301	        return mentions_pinned_table(statement);
  1302	    }
  1303	
  1304	    if statement.starts_with("UPDATE") {
  1305	        let Some(table) = update_target_table(statement) else { return false };
  1306	        if !is_pinned_table(&table) {
  1307	            return false;
  1308	        }
  1309	        // Only the SET clause assigns. Reading `logical_id` in a WHERE predicate
  1310	        // (step 21) is explicitly legitimate.
  1311	        return set_clause(statement).is_some_and(|clause| clause.contains(PINNED_IDENTITY_COLUMN));
  1312	    }
  1313	
  1314	    if statement.starts_with("INSERT") || statement.starts_with("REPLACE") {
  1315	        let Some((table, rest)) = table_after_into(statement) else { return false };
  1316	        if !is_pinned_table(&table) {
  1317	            return false;
  1318	        }
  1319	        // Naming the column anywhere in an insert into a canonical table is a
  1320	        // backfill; a MISSING column list writes every column, identity included.
  1321	        return names_column || !rest.trim_start().starts_with('(');
  1322	    }
  1323	
  1324	    if statement.starts_with("ALTER") {
  1325	        let Some(table) = token_after(statement, "ALTER TABLE ") else { return false };
  1326	        if !is_pinned_table(&table) || !names_column {
  1327	            return false;
  1328	        }
  1329	        // Declaring the column bare is how step 12 shipped it. A DEFAULT
  1330	        // populates every existing row; a RENAME conscripts a populated one.
  1331	        return statement.contains("DEFAULT") || statement.contains("RENAME");
  1332	    }
  1333	
  1334	    if statement.starts_with("CREATE") && statement.contains(" TABLE ") {
  1335	        let Some(table) = token_after(statement, " TABLE ") else { return false };
  1336	        // A recreate may DECLARE the column (step 23 does); it may not default it.
  1337	        return is_pinned_table(&table) && names_column && statement.contains("DEFAULT");
  1338	    }
  1339	
  1340	    false
  1341	}
