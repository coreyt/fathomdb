  1400	fn is_pinned_table(token: &str) -> bool {
  1401	    PINNED_IDENTITY_TABLES.contains(&bare_table_name(token))
  1402	}
  1403	
  1404	/// Does any IDENTIFIER TOKEN of `statement` name a pinned canonical table?
  1405	///
  1406	/// Token-based, never a substring: `canonical_nodes_backup` is a DIFFERENT
  1407	/// table, and a `contains` test would conscript every lookalike name into the
  1408	/// pin — rejecting legitimate backup/recreate scaffolding. The statement is cut
  1409	/// on every character that cannot appear in an identifier, keeping `.` so a
  1410	/// schema qualifier stays one token for [`is_pinned_table`] to strip.
  1411	///
  1412	/// Used by the trigger arm, whose target table can sit anywhere in the head
  1413	/// (`… ON <table> …`), and which — because the `;` split glues the FIRST body
  1414	/// statement onto the head — must also see a table named inside that body.
  1415	fn mentions_pinned_table(statement: &str) -> bool {
  1416	    statement
  1417	        .split(|c: char| !(c.is_ascii_alphanumeric() || c == '_' || c == '.'))
  1418	        .any(is_pinned_table)
  1419	}
