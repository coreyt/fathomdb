+        return Ok(false);
+    }
+    conn.prepare_cached(
+        "SELECT EXISTS(SELECT 1 FROM _fathomdb_projection_registry WHERE vector_declared = 1)",
+    )?
+    .query_row([], |row| row.get(0))
