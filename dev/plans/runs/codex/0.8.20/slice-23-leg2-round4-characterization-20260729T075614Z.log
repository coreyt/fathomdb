             storage={} scheduler={} other={} kinds={:?}",
            outcome.attempted,
            outcome.failure_wall_ms,
            outcome.storage_errors,
            outcome.scheduler_errors,
            outcome.other_errors,
            outcome.other_error_kinds,
        );
    }
