+// ---------------------------------------------------------------------------
+// Small assertion helper
+// ---------------------------------------------------------------------------
+
+trait UnwrapErrOrPanic {
+    fn unwrap_err_or_panic(self, message: &str, context: &str);
+}
+
+impl UnwrapErrOrPanic for Result<(), MigrationLogicalIdPinError> {
+    fn unwrap_err_or_panic(self, message: &str, context: &str) {
+        assert!(self.is_err(), "{message}: {context}");
+    }
+}

