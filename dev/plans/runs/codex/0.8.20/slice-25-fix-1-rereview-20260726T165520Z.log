+        "an un-admitted, non-governed write path mints NOTHING — the rows stay `h:`"
+    );
+    assert!(
+        snap.iter().all(|(_, lid, _, _)| lid.is_none()),
+        "the structural writer binds a literal NULL logical_id"
+    );
