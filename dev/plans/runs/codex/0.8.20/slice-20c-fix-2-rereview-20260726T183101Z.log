+            "SELECT COUNT(*) FROM canonical_nodes n"
+            " LEFT JOIN _fathomdb_vector_rows v ON v.write_cursor = n.write_cursor"
+            " WHERE n.row_kind IN ('leaf', 'coverage') AND n.kind = ?"
+            " AND v.write_cursor IS NULL",
+            (kind,),
+        ).fetchone()
+        return int(row[0])
+    finally:
+        conn.close()
