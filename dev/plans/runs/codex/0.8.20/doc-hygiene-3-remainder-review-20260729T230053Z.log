   342	def build_record(args, fields):
   343	    """Assemble the record body (``kind`` onward) with a stable key order.
   344	
   345	    ``ts`` and ``seq`` are prepended by the caller inside the flock — ``ts`` so
   346	    it is ordered consistently with ``seq`` under concurrency, ``seq`` because it
   347	    needs the counter file. Arbitrary --field keys follow the reserved head,
   348	    sorted. Reserved keys win over a colliding --field (with a warning) so the
   349	    record shape stays predictable. Returns (tail, clobbered_reserved_keys).
   350	    """
   351	    record = {"kind": args.kind, "summary": args.summary}
   352	    reserved = {"ts", "seq", "kind", "summary", "refs", "body"}
   353	    extra = {k: v for k, v in fields.items() if k not in reserved}
   354	    for key in sorted(extra):
   355	        record[key] = extra[key]
   356	    if args.ref:
   357	        record["refs"] = list(args.ref)
   358	    if args.body is not None:
   359	        record["body"] = args.body
   360	    return record, (set(fields) & reserved)
