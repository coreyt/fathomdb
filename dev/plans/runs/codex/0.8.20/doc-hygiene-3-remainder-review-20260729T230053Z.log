    with open(ledger, "w", encoding="utf-8") as fh:
        fh.write(foreign + "\n")
    call([ledger, "--kind", "note", "--summary", "appended", "--no-seq"])
    lines = read_lines(ledger)
    assert lines[0] == foreign  # byte-for-byte untouched
    assert json.loads(lines[1])["summary"] == "appended"


