        .configure_projections(&[], &["status".to_string(), "status".to_string()])
        .unwrap_err();
    match err {
        EngineError::InvalidArgument { msg } => assert!(
            msg.contains("status") && msg.contains("duplicate"),
            "the typed refusal must name the duplicated drop, got: {msg}"
