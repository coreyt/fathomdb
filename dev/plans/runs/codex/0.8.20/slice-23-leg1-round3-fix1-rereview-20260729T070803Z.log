    try:
        return [
            r[0]
            for r in conn.execute(
                "SELECT attr_value FROM canonical_attributes"
                " WHERE attr_name = ? ORDER BY attr_value",
                (attr_name,),
            ).fetchall()
        ]
    finally:
        conn.close()


