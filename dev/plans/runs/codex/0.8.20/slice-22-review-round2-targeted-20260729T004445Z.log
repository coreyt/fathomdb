 14779	        return Ok(Vec::new());
 14780	    };
 14781	    let mut cols: Vec<String> = Vec::new();
 14782	    // Tokenize on any non-identifier byte; a token is an attribute column iff it
 14783	    // decodes as a well-formed `attr_<hex>` identifier.
 14784	    let mut token = String::new();
 14785	    let flush = |token: &mut String, cols: &mut Vec<String>| {
 14786	        if !token.is_empty() {
 14787	            if decode_attr_vec0_column(token).is_some() && !cols.contains(token) {
 14788	                cols.push(token.clone());
 14789	            }
 14790	            token.clear();
 14791	        }
 14792	    };
 14793	    for ch in sql.chars() {
 14794	        if ch.is_ascii_alphanumeric() || ch == '_' {
 14795	            token.push(ch);
 14796	        } else {
 14797	            flush(&mut token, &mut cols);
 14798	        }
 14799	    }
 14800	    flush(&mut token, &mut cols);
