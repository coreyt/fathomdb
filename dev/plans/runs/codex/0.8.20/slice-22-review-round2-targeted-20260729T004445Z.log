+    hash_fingerprint_field(&mut hasher, identity.name.as_bytes());
+    hash_fingerprint_field(&mut hasher, identity.revision.as_bytes());
+    hash_fingerprint_field(&mut hasher, &identity.dimension.to_le_bytes());
