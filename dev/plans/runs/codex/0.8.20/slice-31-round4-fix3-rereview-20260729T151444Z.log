   118	        " in {manifest, lockfile}; e.g. Cargo.lock -> (cargo, lockfile),"
   119	        " src/ts/package.json -> (npm, manifest), src/python/uv.lock ->"
   120	        " (pypi, lockfile), tools/docs/requirements.txt -> (pypi, manifest).",
