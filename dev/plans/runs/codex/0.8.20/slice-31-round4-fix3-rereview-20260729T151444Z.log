    19	def test_discovery_uses_git_ls_files_not_a_filesystem_walk(tmp_path: Path) -> None:
    20	    """AC-SBOM-01.
    21	
    22	    Discovery takes its candidate set from an injected `git ls-files` runner.
    23	    A manifest that exists on disk but is NOT reported by that runner must be
    24	    absent from the result — that is what makes `python/pyproject.toml`,
    25	    `target/**` and `node_modules/**` structurally unreachable.
    26	    """
    27	    discovery = require(
    28	        "sbom_survey.discovery",
    29	        "AC-SBOM-01",
    30	        "discover_manifests(root, *, ls_files=...) must derive its candidate set"
    31	        " from the injected `git ls-files` runner ONLY; a manifest present on"
    32	        " disk but untracked must never appear in the result.",
    33	    )
    34	
    35	    # Tracked, per the injected runner.
    36	    (tmp_path / "Cargo.toml").write_text("[package]\nname='x'\n", encoding="utf-8")
    37	    # On disk but NOT reported by the runner -> must be invisible.
    38	    untracked = tmp_path / "vendored"
    39	    untracked.mkdir()
    40	    (untracked / "package.json").write_text("{}", encoding="utf-8")
    41	
    42	    calls: list[Path] = []
    43	
    44	    def fake_ls_files(root: Path) -> list[str]:
    45	        calls.append(root)
    46	        return ["Cargo.toml"]
    47	
    48	    refs = discovery.discover_manifests(tmp_path, ls_files=fake_ls_files)
    49	
    50	    assert calls, "the injected ls_files runner was never called"
    51	    found = {r.path for r in refs}
    52	    assert found == {"Cargo.toml"}, (
    53	        "discovery must return exactly what git reports; got "
    54	        f"{sorted(found)} — an untracked on-disk manifest leaked in"
    55	    )
    56	
