    30	def test_cyclonedx_document_is_schema_valid_and_purl_identified() -> None:
    31	    """AC-SBOM-10.
    32	
    33	    The emitted document validates against the bundled CycloneDX 1.6 JSON
    34	    schema. Hand-rolled JSON that no consumer will validate is not an SBOM.
    35	
    36	    The schema verdict comes from an INDEPENDENT validator — the upstream
    37	    cyclonedx-python-lib one, not `sbom_survey.cyclonedx.validate()` — with a
    38	    known-invalid negative control proving the oracle actually rejects
    39	    something (codex §9 round 2). The tool's own validate() is then required to
    40	    agree with it in both directions rather than to be believed.
    41	
    42	    Schema validity alone is NOT enough, and asserting only it was the gap
    43	    codex §9 round 1 caught: `name` + `version` satisfy the 1.6 schema, so a
    44	    purl-less document would have passed. REQ-6 requires a `purl` PER
    45	    COMPONENT, and §5.5 makes the purl the `bom-ref` — the component identity
    46	    an advisory feed matches a locked version against. A component without one
    47	    is unmatchable, which defeats the reason the SBOM is produced.
    48	    """
    49	    survey = _offline_survey(
    50	        "AC-SBOM-10",
    51	        "Survey.to_cyclonedx() must produce a document that validates against"
    52	        " the bundled CycloneDX 1.6 JSON schema"
    53	        " (cyclonedx-python-lib[json-validation]), AND every component must"
    54	        " carry a `purl` that IS its `bom-ref`, bears the ecosystem prefix"
    55	        f" ({', '.join(PURL_PREFIXES)}) and encodes the component's own"
    56	        " locked version.",
    57	    )
    58	    doc = survey.to_cyclonedx()
    59	
    60	    assert doc.get("bomFormat") == "CycloneDX"
    61	    assert doc.get("specVersion") == "1.6"
    62	    assert str(doc.get("serialNumber", "")).startswith("urn:uuid:")
    63	    assert doc.get("components"), "the BOM has no components"
    64	
    65	    seen_types: set[str] = set()
    66	    for component in doc["components"]:
    67	        name = component.get("name")
    68	        purl = component.get("purl")
    69	        assert purl, (
    70	            f"{name!r}: component has NO purl — REQ-6 requires one per component,"
    71	            " and without it the component cannot be matched against an advisory"
    72	        )
    73	        assert purl.startswith(PURL_PREFIXES), (
    74	            f"{name!r}: purl {purl!r} does not carry a recognized ecosystem"
    75	            f" prefix (expected one of {PURL_PREFIXES})"
    76	        )
    77	        assert component.get("bom-ref") == purl, (
    78	            f"{name!r}: bom-ref {component.get('bom-ref')!r} != purl {purl!r} —"
    79	            " §5.5 makes the purl the bom-ref so refs are stable across runs"
    80	        )
    81	        seen_types.add(purl_type(purl) or "")
    82	
    83	        props = {p["name"]: p["value"] for p in component.get("properties", [])}
    84	        if props.get("fathomdb:resolution") != "unresolved":
    85	            version = component.get("version")
    86	            assert version, f"{purl}: resolved component has no version"
    87	            assert "@" in purl, (
    88	                f"{purl}: a resolved component's purl must pin its version"
    89	            )
    90	            assert unquote(purl.rsplit("@", 1)[-1]) == version, (
    91	                f"{purl}: purl version does not match component version"
    92	                f" {version!r} — the identity and the reported version disagree"
    93	            )
    94	
    95	    assert seen_types == set(PURL_PREFIX_BY_ECOSYSTEM), (
    96	        "the BOM's purl types must be exactly"
    97	        f" {sorted(PURL_PREFIX_BY_ECOSYSTEM)} — this repo tracks cargo, npm and"
    98	        f" pypi manifests, so all three must be represented; got {sorted(seen_types)}"
    99	    )
   100	
   101	    # --- schema validity, graded by an INDEPENDENT oracle -------------------
   102	    #
   103	    # This half used to call `sbom_survey.cyclonedx.validate()` — a function
   104	    # from the implementation under test — which is self-certification: a
   105	    # `validate()` that returns None unconditionally passed while the tool
   106	    # emitted invalid CycloneDX JSON, i.e. exactly the hand-rolled-SBOM failure
   107	    # this criterion exists to stop (codex §9 round 2, fix-2 finding 1). The
   108	    # oracle is now the upstream library's own 1.6 schema validator.
   109	    schema_valid = independent_cyclonedx_validator("AC-SBOM-10")
   110	
   111	    # Negative control FIRST — prove the oracle bites before trusting a clean
   112	    # result from it. An "independent validator" that accepts anything is no
   113	    # better than the self-certifying one it replaced.
   114	    assert schema_valid(KNOWN_INVALID_CYCLONEDX_DOC) is not None, (
   115	        "the independent CycloneDX 1.6 validator ACCEPTED a document whose only"
   116	        " component carries no `type`, which the 1.6 schema requires. The"
   117	        " oracle is not validating, so a clean verdict from it proves nothing."
   118	    )
   119	
   120	    problem = schema_valid(doc)
   121	    assert problem is None, f"CycloneDX 1.6 schema validation failed: {problem}"
   122	
   123	    # The tool's own validate() must AGREE with the independent oracle in BOTH
   124	    # directions. The second assertion is the one that kills a stub: a
   125	    # `validate()` that returns None unconditionally agrees on the valid
   126	    # document and is caught here.
   127	    validator_mod = require(
   128	        "sbom_survey.cyclonedx",
   129	        "AC-SBOM-10",
   130	        "sbom_survey.cyclonedx.validate(doc) must really run the CycloneDX 1.6"
   131	        " schema — returning None for a valid document AND a diagnostic for an"
   132	        " invalid one. It is cross-checked against the independent"
   133	        " cyclonedx-python-lib validator in both directions.",
   134	    )
   135	    assert validator_mod.validate(doc) is None, (
   136	        "sbom_survey.cyclonedx.validate() rejected a document the independent"
   137	        f" CycloneDX 1.6 validator accepts: {validator_mod.validate(doc)}"
   138	    )
   139	    assert validator_mod.validate(KNOWN_INVALID_CYCLONEDX_DOC) is not None, (
   140	        "sbom_survey.cyclonedx.validate() returned None for a document the"
   141	        " independent CycloneDX 1.6 validator REJECTS — it is not running the"
   142	        " schema, so it certifies nothing and must never be the oracle for"
   143	        " this criterion."
   144	    )
