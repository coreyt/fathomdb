   108	def test_ecosystem_and_kind_classification() -> None:
   109	    """AC-SBOM-04.
   110	
   111	    Each ref carries ecosystem in {cargo, npm, pypi} and kind in
   112	    {manifest, lockfile}. Checked against four real tracked paths.
   113	    """
