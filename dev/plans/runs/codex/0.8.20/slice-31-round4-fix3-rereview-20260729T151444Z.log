   118	
   119	def require(module: str, criterion: str, behaviour: str):
   120	    """Import `module`, or FAIL naming the criterion and the missing behaviour.
   121	
   122	    Never skips. A missing implementation is a failed acceptance criterion,
   123	    not an absent test.
   124	    """
   125	    try:
   126	        return importlib.import_module(module)
   127	    except Exception as exc:  # noqa: BLE001 - any import-time failure is a RED result
   128	        pytest.fail(
   129	            f"{criterion} is NOT SATISFIED: `{module}` is not implemented yet"
   130	            " (it lands in 0.8.20 Slice 32).\n"
   131	            f"  REQUIRED BEHAVIOUR: {behaviour}\n"
   132	            f"  import {module!r} raised: {exc!r}"
   133	        )
   134	
   135	
   136	def require_external(module: str, criterion: str, distribution: str, why: str):
   137	    """Import a THIRD-PARTY oracle module, or FAIL. Never skips.
   138	
   139	    Distinct from `require()`: that one imports the code UNDER TEST, and a
   140	    missing module there is the expected Slice-31 RED. This one imports a
   141	    module the test grades WITH, and a missing module there means the criterion
   142	    would go **ungraded**.
   143	
   144	    Which is why it must fail rather than skip. `pytest.skip` on a missing
   145	    oracle is the textbook vacuous green: the suite still reports success while
   146	    the assertion it was built for silently stopped running. Every distribution
   147	    reached through this helper is a declared dependency of the mini-project
   148	    (design §5.7), so its absence is a broken environment, not a licence to
   149	    pass.
   150	    """
   151	    try:
   152	        return importlib.import_module(module)
   153	    except Exception as exc:  # noqa: BLE001 - any import failure means "ungraded"
   154	        pytest.fail(
   155	            f"{criterion} CANNOT BE GRADED: the independent oracle `{module}` is"
   156	            " not importable, so the criterion would go UNGRADED.\n"
   157	            f"  INSTALL: {distribution} — a declared dependency of this"
   158	            " mini-project (design §5.7).\n"
   159	            f"  WHY THE ORACLE IS REQUIRED: {why}\n"
   160	            "  This is a FAILURE and never a skip: an oracle allowed to vanish"
   161	            " turns the criterion into a vacuous green.\n"
   162	            f"  import {module!r} raised: {exc!r}"
   163	        )
   164	
   165	
   166	def independent_cyclonedx_validator(criterion: str):
   167	    """A CycloneDX 1.6 schema validator that does NOT come from `sbom_survey`.
   168	
   169	    Returns `validate(doc) -> str | None` — `None` when `doc` is schema-valid,
   170	    a diagnostic string otherwise.
   171	
   172	    AC-SBOM-10 exists to stop a hand-rolled document that no consumer will
   173	    validate. Grading it with the implementation's own
   174	    `sbom_survey.cyclonedx.validate()` is **self-certification**: an
   175	    implementation whose `validate()` returns `None` unconditionally would pass
   176	    while emitting invalid JSON (codex §9 round 2, fix-2 finding 1). The oracle
   177	    is therefore the upstream library's own validator, bound to the normative
   178	    1.6 schema shipped by the `cyclonedx-python-lib[json-validation]` extra
   179	    (design §5.7 already declares that dependency for exactly this purpose).
   180	    """
   181	    validation = require_external(
   182	        "cyclonedx.validation.json",
   183	        criterion,
   184	        "cyclonedx-python-lib[json-validation]",
   185	        "AC-SBOM-10 must be graded by a validator INDEPENDENT of the code under"
   186	        " test; the implementation's own validate() cannot certify itself.",
   187	    )
   188	    schema = require_external(
   189	        "cyclonedx.schema",
   190	        criterion,
   191	        "cyclonedx-python-lib[json-validation]",
   192	        "SchemaVersion.V1_6 selects the normative 1.6 schema the emitted"
   193	        " document is graded against.",
   194	    )
   195	    try:
   196	        validator = validation.JsonStrictValidator(schema.SchemaVersion.V1_6)
   197	    except Exception as exc:  # noqa: BLE001 - a validator we cannot build grades nothing
   198	        pytest.fail(
   199	            f"{criterion} CANNOT BE GRADED: cyclonedx-python-lib imported, but its"
   200	            " JSON schema validator could not be constructed — the"
   201	            " `json-validation` extra (the JSON-schema engine plus the bundled"
   202	            " normative schemas) is almost certainly missing. Install"
   203	            " `cyclonedx-python-lib[json-validation]`, per design §5.7."
   204	            f" Raised: {exc!r}"
   205	        )
   206	
   207	    def validate(doc) -> str | None:
   208	        problem = validator.validate_str(json.dumps(doc))
   209	        return None if problem is None else str(problem)
   210	
   211	    return validate
   212	
   213	
   214	def run_cli(args: list[str], criterion: str, behaviour: str) -> subprocess.CompletedProcess:
   215	    """Drive the CLI as a subprocess, or FAIL naming the criterion.
   216	
   217	    Driving the CLI out-of-process is the second half of the no-module-level-
   218	    import rule: an absent entry point becomes a normal process result rather
   219	    than a collection error.
   220	    """
   221	    env = dict(os.environ)
   222	    env["PYTHONPATH"] = os.pathsep.join(
   223	        [str(PROJECT_ROOT), env.get("PYTHONPATH", "")]
   224	    ).rstrip(os.pathsep)
   225	    proc = subprocess.run(  # noqa: S603 - fixed argv, no shell
   226	        [sys.executable, "-m", "sbom_survey", *args],
   227	        capture_output=True,
   228	        text=True,
   229	        env=env,
   230	        cwd=str(REPO_ROOT),
   231	    )
   232	    if "No module named" in proc.stderr and "sbom_survey" in proc.stderr:
   233	        pytest.fail(
   234	            f"{criterion} is NOT SATISFIED: the `sbom-survey` CLI does not exist yet"
   235	            " (it lands in 0.8.20 Slice 32).\n"
   236	            f"  REQUIRED BEHAVIOUR: {behaviour}\n"
   237	            f"  `python -m sbom_survey {' '.join(args)}` exited {proc.returncode}"
   238	            f" with: {proc.stderr.strip().splitlines()[-1] if proc.stderr.strip() else '<no stderr>'}"
   239	        )
   240	    return proc
   241	
   242	
   243	def tracked_paths() -> list[str]:
   244	    """Every path tracked in this repository, straight from git."""
   245	    out = subprocess.run(  # noqa: S603 - fixed argv, no shell
   246	        ["git", "-C", str(REPO_ROOT), "ls-files", "-z"],
   247	        capture_output=True,
   248	        text=True,
   249	        check=True,
   250	    ).stdout
   251	    return [p for p in out.split("\0") if p]
   252	
   253	
   254	def tracked_manifest_paths() -> list[str]:
   255	    """The tracked paths whose basename is a recognized manifest name."""
   256	    return sorted(
   257	        p
   258	        for p in tracked_paths()
   259	        if Path(p).name in MANIFEST_BASENAMES
   260	        or (Path(p).name.startswith("requirements") and p.endswith(".txt"))
