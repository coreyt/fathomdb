### scripts/sbom-survey/tests/test_registry.py
     1	"""AC-SBOM-14 .. AC-SBOM-17 — the published-version seam.
     2	
     3	REQ-9 (injectable registry), REQ-10 (honest degradation).
     4	Design: dev/design/0.8.20-slice-31-sbom-survey-tool.md §5.4.
     5	
     6	A false "up-to-date" is the single worst output this tool can produce: it would
     7	let a live advisory be closed as `CLOSE-satisfied` in the LIBRARY-BUMP-STEWARD
     8	§2 triage. AC-SBOM-15 and AC-SBOM-16 are the two named guards against it.
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import socket
    14	
    15	import pytest
    16	
    17	from conftest import REPO_ROOT, require
    18	
    19	
    20	def test_survey_performs_no_network_io_by_default() -> None:
    21	    """AC-SBOM-14.
    22	
    23	    `run_survey` takes `published` as a REQUIRED keyword-only argument, so no
    24	    code path reaches the network implicitly. With `OfflineSource` a full
    25	    survey must open zero sockets — proved by making `socket.socket` explode.
    26	    """
    27	    survey_mod = require(
    28	        "sbom_survey.survey",
    29	        "AC-SBOM-14",
    30	        "run_survey(root, *, published=...) must take the published-version"
    31	        " source as a REQUIRED keyword-only argument and must perform ZERO"
    32	        " socket I/O when given an OfflineSource.",
    33	    )
    34	    registry = require(
    35	        "sbom_survey.registry",
    36	        "AC-SBOM-14",
    37	        "registry.OfflineSource must be a PublishedVersionSource that never"
    38	        " touches the network.",
    39	    )
    40	
    41	    with pytest.raises(TypeError):
    42	        survey_mod.run_survey(REPO_ROOT)  # `published` must not have a default
    43	
    44	    real_socket = socket.socket
    45	    opened: list[object] = []
    46	
    47	    def exploding_socket(*args, **kwargs):
    48	        opened.append(args)
    49	        raise AssertionError("the offline survey opened a socket")
    50	
    51	    socket.socket = exploding_socket  # type: ignore[assignment]
    52	    try:
    53	        survey_mod.run_survey(REPO_ROOT, published=registry.OfflineSource())
    54	    finally:
    55	        socket.socket = real_socket  # type: ignore[assignment]
    56	
    57	    assert not opened, "the offline survey opened a socket"
    58	
    59	
    60	def test_unknown_latest_is_never_reported_current() -> None:
    61	    """AC-SBOM-15.
    62	
    63	    With no registry available, every row is `unknown`. NOT ONE row may be
    64	    `current`: "we could not check" must never be rendered as "up to date".
    65	    """
    66	    survey_mod = require(
    67	        "sbom_survey.survey",
    68	        "AC-SBOM-15",
    69	        "when the published-version source returns None for every lookup, every"
    70	        " staleness row must have status == 'unknown' and latest_version is"
    71	        " None. NO row may be 'current' — an unknown latest must never be"
    72	        " rendered as up-to-date.",
    73	    )
    74	    registry = require("sbom_survey.registry", "AC-SBOM-15", "OfflineSource returns None for every lookup.")
    75	
    76	    survey = survey_mod.run_survey(REPO_ROOT, published=registry.OfflineSource())
    77	    rows = survey.staleness()
    78	    assert rows, "vacuous-pass guard: the survey produced zero staleness rows"
    79	
    80	    falsely_current = [r.name for r in rows if r.status == "current"]
    81	    assert not falsely_current, (
    82	        "offline run reported packages as 'current' with no registry data: "
    83	        f"{sorted(falsely_current)}"
    84	    )
    85	    for row in rows:
    86	        assert row.status == "unknown", f"{row.name}: expected 'unknown', got {row.status!r}"
    87	        assert row.latest_version is None, f"{row.name}: latest_version leaked {row.latest_version!r}"
    88	
    89	
    90	def test_registry_error_degrades_to_unknown() -> None:
    91	    """AC-SBOM-16.
    92	
    93	    A source that RAISES (DNS failure, 503, timeout, malformed JSON) degrades
    94	    to `unknown` with the reason recorded. It must not crash the run and must
    95	    not fall back to `current`.
    96	    """
    97	    survey_mod = require(
    98	        "sbom_survey.survey",
    99	        "AC-SBOM-16",
   100	        "a PublishedVersionSource that raises must degrade the affected rows to"
   101	        " status='unknown' with `lookup_error` recorded — the run must not"
   102	        " crash, and must not fall back to 'current'.",
   103	    )
   104	    require("sbom_survey.registry", "AC-SBOM-16", "the source protocol lives here.")
   105	
   106	    class ExplodingSource:
   107	        def latest(self, ecosystem: str, name: str) -> str | None:
   108	            raise ConnectionError(f"registry unreachable for {ecosystem}/{name}")
   109	
   110	    survey = survey_mod.run_survey(REPO_ROOT, published=ExplodingSource())
   111	    rows = survey.staleness()
   112	    assert rows, "vacuous-pass guard: the survey produced zero staleness rows"
   113	
   114	    for row in rows:
   115	        assert row.status == "unknown", f"{row.name}: expected 'unknown', got {row.status!r}"
   116	        assert row.lookup_error, f"{row.name}: the failure reason was not recorded"
   117	
   118	
   119	def test_static_source_classifies_current_outdated_ahead() -> None:
   120	    """AC-SBOM-17.
   121	
   122	    The positive path, with an injected source and no network: locked < latest
   123	    is `outdated`, locked == latest is `current`, locked > latest is `ahead`.
   124	    Both comparators are exercised (semver for cargo/npm, PEP 440 for pypi).
   125	    """
   126	    staleness_mod = require(
   127	        "sbom_survey.survey",
   128	        "AC-SBOM-17",
   129	        "classify_status(ecosystem, locked, latest) must return 'outdated' when"
   130	        " locked < latest, 'current' when equal, 'ahead' when locked > latest,"
   131	        " and 'unknown' when either side is None or unparseable — using semver"
   132	        " ordering for cargo/npm and PEP 440 ordering for pypi.",
   133	    )
   134	
   135	    cases = [
   136	        ("cargo", "1.0.0", "1.2.0", "outdated"),
   137	        ("cargo", "1.2.0", "1.2.0", "current"),
   138	        ("cargo", "1.3.0", "1.2.0", "ahead"),
   139	        ("cargo", "1.2.3-rc.1", "1.2.3", "outdated"),
   140	        ("npm", "0.22.1", "0.23.0", "outdated"),
   141	        ("pypi", "1.6.1", "1.6.1", "current"),
   142	        ("pypi", "1.6.1", "1.7.0", "outdated"),
   143	        ("pypi", "2.0.0.post1", "2.0.0", "ahead"),
   144	        ("cargo", None, "1.2.0", "unknown"),
   145	        ("cargo", "1.2.0", None, "unknown"),
   146	        ("cargo", "not-a-version", "1.2.0", "unknown"),
   147	    ]
   148	    for ecosystem, locked, latest, expected in cases:
   149	        got = staleness_mod.classify_status(ecosystem, locked, latest)
   150	        assert got == expected, (
   151	            f"{ecosystem} locked={locked!r} latest={latest!r}: expected"
   152	            f" {expected!r}, got {got!r}"
   153	        )
### scripts/sbom-survey/tests/test_report.py
     1	"""AC-SBOM-22 — the Slice-33 consumer contract.
     2	
     3	REQ-13 (determinism) and REQ-14 (consumer fields).
     4	Design: dev/design/0.8.20-slice-31-sbom-survey-tool.md §5.8.
     5	
     6	Slice 33 answers exactly two questions and stops: what is stale, and would a
     7	surgical ~1-5 SLOC change likely land it. This report must let it answer both
     8	without re-deriving anything. Nothing in Slice 33 is built here.
     9	"""
    10	
    11	from __future__ import annotations
    12	
    13	import json
    14	from datetime import datetime, timezone
    15	from pathlib import Path
    16	
    17	import pytest
    18	
    19	from conftest import REPO_ROOT, require, run_cli
    20	
    21	SLICE_33_ROW_FIELDS = {
    22	    "ecosystem",
    23	    "name",
    24	    "tier",
    25	    "depth",
    26	    "locked_version",
    27	    "latest_version",
    28	    "status",
    29	    "lookup_error",
    30	    "declared_in",
    31	    "edit_sites",
    32	    "edit_site_count",
    33	}
    34	
    35	# A default-path timestamp may not be wall-clock. §5.8 rules the default a FIXED
    36	# epoch, so any stamp within a day of the real clock is a wall-clock default.
    37	# The window is deliberately generous: it must not be tripped by a slow run, a
    38	# timezone slip or a machine whose clock is a few hours out, only by an
    39	# implementation that actually asks the operating system what time it is.
    40	WALL_CLOCK_WINDOW_SECONDS = 24 * 60 * 60
    41	
    42	
    43	def _assert_identical(first: dict[str, bytes], second: dict[str, bytes], what: str) -> None:
    44	    assert first and second, f"no artifacts were written {what}"
    45	    assert first.keys() == second.keys(), (
    46	        f"a different artifact set was written {what}: {sorted(first)} vs {sorted(second)}"
    47	    )
    48	    for name in first:
    49	        assert first[name] == second[name], (
    50	            f"{name} is not byte-identical {what} — the report is"
    51	            " non-deterministic, so a recurring re-run cannot diff cleanly"
    52	        )
    53	
    54	
    55	def test_staleness_rows_carry_slice_33_fields_and_are_deterministic(
    56	    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
    57	) -> None:
    58	    """AC-SBOM-22.
    59	
    60	    REQ-13 is about ORDINARY repeated runs, so the DEFAULT timestamp path is the
    61	    one that has to be covered. Pinning `now` on both runs — all this test used
    62	    to do — leaves an implementation that falls back to wall-clock whenever
    63	    `now` / `--now` is omitted passing (codex §9 round 2, fix-2 finding 3).
    64	    Three determinism legs are therefore run: pinned `now`, the in-process
    65	    default, and the CLI default (argparse has a default of its own and could
    66	    hand `run_survey` a wall-clock `now` explicitly, bypassing the other two).
    67	    """
    68	    survey_mod = require(
    69	        "sbom_survey.survey",
    70	        "AC-SBOM-22",
    71	        "each staleness row must carry exactly the Slice-33 consumer fields"
    72	        f" {sorted(SLICE_33_ROW_FIELDS)}, sorted by"
    73	        " (tier, ecosystem, name, locked_version); and two runs over identical"
    74	        " inputs must write BYTE-IDENTICAL artifacts — WITH and WITHOUT an"
    75	        " explicit `now`, in-process and through the CLI (UUIDv5 serialNumber,"
    76	        " a FIXED default epoch, no wall-clock timestamp) so a re-run diffs to"
    77	        " nothing.",
    78	    )
    79	    registry = require("sbom_survey.registry", "AC-SBOM-22", "OfflineSource keeps the run hermetic.")
    80	    report = require(
    81	        "sbom_survey.report",
    82	        "AC-SBOM-22",
    83	        "sbom_survey.report.write_reports(survey, out_dir) must emit"
    84	        " sbom.cdx.json, staleness.json and staleness.md deterministically.",
    85	    )
    86	
    87	    # Cleared so the PURE built-in default is exercised, not an environment
    88	    # override — and so the CLI subprocesses below inherit the same posture.
    89	    monkeypatch.delenv("SOURCE_DATE_EPOCH", raising=False)
    90	
    91	    def once(out: Path, **kwargs) -> dict[str, bytes]:
    92	        survey = survey_mod.run_survey(
    93	            REPO_ROOT, published=registry.OfflineSource(), **kwargs
    94	        )
    95	        report.write_reports(survey, out)
    96	        return {p.name: p.read_bytes() for p in sorted(out.iterdir())}
    97	
    98	    # Leg 1 — an explicit, pinned `now`.
    99	    pinned = "1970-01-01T00:00:00Z"
   100	    _assert_identical(
   101	        once(tmp_path / "a", now=pinned),
   102	        once(tmp_path / "b", now=pinned),
   103	        "across two runs with an explicit `now`",
   104	    )
   105	
   106	    # Leg 2 — the DEFAULT path, which is what an ordinary re-run takes.
   107	    default_first = once(tmp_path / "c")
   108	    _assert_identical(
   109	        default_first,
   110	        once(tmp_path / "d"),
   111	        "across two DEFAULT runs (no explicit `now`)",
   112	    )
   113	
   114	    # Byte-equality alone does not settle leg 2: two back-to-back runs can share
   115	    # a wall-clock second and look identical by luck. The default stamp must
   116	    # therefore be shown NOT to be wall-clock at all.
   117	    stamp = json.loads(default_first["sbom.cdx.json"])["metadata"]["timestamp"]
   118	    parsed = datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
   119	    if parsed.tzinfo is None:
   120	        parsed = parsed.replace(tzinfo=timezone.utc)
   121	    drift = abs((datetime.now(timezone.utc) - parsed).total_seconds())
   122	    assert drift > WALL_CLOCK_WINDOW_SECONDS, (
   123	        f"the DEFAULT run stamped metadata.timestamp {stamp!r}, which is within"
   124	        " a day of the real clock. §5.8 rules the default a FIXED epoch"
   125	        " (SOURCE_DATE_EPOCH or an explicit --now are the only overrides); a"
   126	        " wall-clock default makes every re-run diff, and two runs inside the"
   127	        " same second would still compare byte-identical, so the equality check"
   128	        " above cannot catch it on its own."
   129	    )
   130	
   131	    # Leg 3 — the CLI default. `--now` could be defaulted to the current time in
   132	    # the argument parser and passed explicitly to run_survey, which would sail
   133	    # past both legs above.
   134	    cli_runs: list[dict[str, bytes]] = []
   135	    for name in ("cli-a", "cli-b"):
   136	        out = tmp_path / name
   137	        proc = run_cli(
   138	            ["--repo", str(REPO_ROOT), "--offline", "--out", str(out)],
   139	            "AC-SBOM-22",
   140	            "two `sbom-survey --repo R --offline --out DIR` runs with NO --now"
   141	            " must write byte-identical artifacts, and must stamp the same"
   142	            " fixed default timestamp run_survey() uses in-process.",
   143	        )
   144	        assert proc.returncode == 0, (
   145	            f"offline CLI run exited {proc.returncode}\nstderr:\n{proc.stderr}"
   146	        )
   147	        cli_runs.append({p.name: p.read_bytes() for p in sorted(out.iterdir())})
   148	
   149	    _assert_identical(*cli_runs, what="across two CLI runs with no --now")
   150	
   151	    cli_stamp = json.loads(cli_runs[0]["sbom.cdx.json"])["metadata"]["timestamp"]
   152	    assert cli_stamp == stamp, (
   153	        f"the CLI stamped {cli_stamp!r} where run_survey()'s own default is"
   154	        f" {stamp!r} — `--now` is being defaulted in the argument parser, which"
   155	        " bypasses the deterministic default proved above"
   156	    )
   157	
   158	    # --- the Slice-33 consumer field set ------------------------------------
   159	    survey = survey_mod.run_survey(REPO_ROOT, published=registry.OfflineSource())
   160	    rows = [r.as_dict() for r in survey.staleness()]
   161	    assert rows, "vacuous-pass guard: zero staleness rows"
   162	
   163	    for row in rows:
   164	        assert set(row) == SLICE_33_ROW_FIELDS, (
   165	            "staleness row field set drifted from the Slice-33 contract:"
   166	            f" missing={sorted(SLICE_33_ROW_FIELDS - set(row))}"
   167	            f" unexpected={sorted(set(row) - SLICE_33_ROW_FIELDS)}"
   168	        )
   169	        assert isinstance(row["edit_sites"], list)
   170	        assert row["edit_site_count"] == len(row["edit_sites"])
   171	        for site in row["edit_sites"]:
   172	            assert not site.startswith("/"), "edit_sites must be repo-relative"
   173	
   174	    keys = [(r["tier"], r["ecosystem"], r["name"], r["locked_version"] or "") for r in rows]
   175	    assert keys == sorted(keys), "staleness rows are not deterministically sorted"
### scripts/sbom-survey/tests/test_tiering.py
     1	"""AC-SBOM-05 .. AC-SBOM-09 and AC-SBOM-23 — tiering, fixture exclusion, the
     2	loud gap, and the longest-prefix matching rule.
     3	
     4	REQ-3 (tiering), REQ-4 (loud gaps), REQ-5 (fixture exclusion).
     5	Design: dev/design/0.8.20-slice-31-sbom-survey-tool.md §5.2 and §5.3.
     6	
     7	`AC-SBOM-23` carries a criterion id out of file order: it was added at fix-3
     8	(codex §9 round 3) and numbered last so that AC-SBOM-10..22 keep the ids the
     9	design, the README and the closure JSON already cite. Its subject matter is
    10	§5.3, which is why the test lives here beside AC-SBOM-05..09.
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	from pathlib import Path
    16	
    17	import pytest
    18	
    19	from conftest import (
    20	    FIXTURE_PREFIX,
    21	    PROJECT_ROOT,
    22	    REPO_ROOT,
    23	    TIER_VOCABULARY,
    24	    require,
    25	    tracked_manifest_paths,
    26	)
    27	
    28	
    29	def _fixture_manifests() -> list[str]:
    30	    return [p for p in tracked_manifest_paths() if p.startswith(FIXTURE_PREFIX)]
    31	
    32	
    33	# --- AC-SBOM-23 overlapping-rule fixture data (design §5.3) -----------------
    34	#
    35	# `_SPECIFIC_PREFIX` is a PROPER PREFIX EXTENSION of `_BROAD_PREFIX`, and the
    36	# two map to DIFFERENT tiers, so first-match-wins and longest-prefix-wins give
    37	# DIFFERENT answers for `_OVERLAP_PATH`. That divergence is the whole point:
    38	# with two rules that agree, or that cannot both match, every matching strategy
    39	# looks identical and the criterion would be vacuous.
    40	#
    41	# Neither path needs to exist on disk. `TierMap.classify()` is a pure function
    42	# of the rule set and the path string, and deliberately so — a rule for a
    43	# subtree that does not exist yet must still be expressible.
    44	_BROAD_PREFIX = "dev/tools/"
    45	_SPECIFIC_PREFIX = "dev/tools/vendored-shipped/"
    46	_OVERLAP_PATH = _SPECIFIC_PREFIX + "Cargo.toml"
    47	_BROAD_ONLY_PATH = _BROAD_PREFIX + "mermaid/package.json"
    48	
    49	# A tier file with the SAME prefix twice — a load-time error per §5.3. Written
    50	# to pytest's `tmp_path` scratch dir at test time; Slice 31 creates no tracked
    51	# `tiers.toml` (that is a Slice 32 artifact, §6).
    52	_DUPLICATE_PREFIX_TOML = f"""\
    53	schema = 1
    54	
    55	[[rule]]
    56	prefix = "{_BROAD_PREFIX}"
    57	action = "tier"
    58	tier   = "dev-tooling"
    59	
    60	[[rule]]
    61	prefix = "{_BROAD_PREFIX}"
    62	action = "tier"
    63	tier   = "shipped"
    64	"""
    65	
    66	
    67	def test_release_fixtures_are_excluded_and_auditable() -> None:
    68	    """AC-SBOM-05.
    69	
    70	    `dev/release/fixtures/cargo-skew/**` and `dev/release/fixtures/pip-skew/**`
    71	    are deliberately fake, deliberately skewed manifests that exist to make the
    72	    release version-skew gates demonstrate their catch. They must contribute
    73	    ZERO components, and the exclusion must be RECORDED (auditable), not silent.
    74	    """
    75	    fixtures = _fixture_manifests()
    76	    assert len(fixtures) == 8, (
    77	        "precondition changed: expected the 8 tracked skew fixtures, found "
    78	        f"{len(fixtures)}: {fixtures}"
    79	    )
    80	
    81	    survey_mod = require(
    82	        "sbom_survey.survey",
    83	        "AC-SBOM-05",
    84	        "run_survey() must exclude every dev/release/fixtures/** manifest from"
    85	        " `components` AND record each one in `survey.excluded` with"
    86	        " reason='fixture' — excluded, but auditable, never silently dropped.",
    87	    )
    88	    registry = require(
    89	        "sbom_survey.registry",
    90	        "AC-SBOM-05",
    91	        "an OfflineSource is needed to run the survey without network.",
    92	    )
    93	
    94	    survey = survey_mod.run_survey(REPO_ROOT, published=registry.OfflineSource())
    95	
    96	    excluded = {e.path: e.reason for e in survey.excluded}
    97	    for path in fixtures:
    98	        assert excluded.get(path) == "fixture", (
    99	            f"{path} must appear in survey.excluded with reason='fixture';"
   100	            f" got {excluded.get(path)!r}"
   101	        )
   102	
   103	    doc = survey.to_cyclonedx()
   104	    origins = {
   105	        prop.get("value")
   106	        for component in doc.get("components", [])
   107	        for prop in component.get("properties", [])
   108	        if prop.get("name") == "fathomdb:declared-in"
   109	    }
   110	    leaked = sorted(o for o in origins if o and o.startswith(FIXTURE_PREFIX))
   111	    assert not leaked, f"fixture manifests produced real components: {leaked}"
   112	
   113	
   114	def test_fixture_exclusion_is_data_driven_not_hardcoded() -> None:
   115	    """AC-SBOM-06.
   116	
   117	    The exclusion must be a rule in the tracked `tiers.toml`, not an `if` in
   118	    code. Proof: load a tier map with the fixture rule REMOVED and the fixture
   119	    manifests must then flow through to tiering (and, having no rule, trip the
   120	    REQ-4 loud failure). A hardcoded special case cannot satisfy this.
   121	
   122	    Proving it at `TierMap.classify()` alone is NOT enough, and that was codex
   123	    §9 round 2's second finding: Slice 32 could make classify() perfectly
   124	    data-driven and still write `if path.startswith("dev/release/fixtures/")`
   125	    into `run_survey()`, passing both AC-SBOM-05 and the classify-level
   126	    assertions while REQ-5's "never by a hardcoded special case in code" went
   127	    untested where it counts. Both tier maps are therefore driven THROUGH the
   128	    survey boundary as well.
   129	    """
   130	    tiers_file = PROJECT_ROOT / "tiers.toml"
   131	    tiers = require(
   132	        "sbom_survey.tiers",
   133	        "AC-SBOM-06",
   134	        "the fixture exclusion must live as an `action = \"exclude\"` rule in the"
   135	        " tracked scripts/sbom-survey/tiers.toml; removing that rule from a"
   136	        " loaded TierMap must change the behaviour, proving the rule is data,"
   137	        " not a hardcoded path check in code.",
   138	    )
   139	
   140	    assert tiers_file.is_file(), (
   141	        f"{tiers_file} does not exist — the tier/exclusion rules must be tracked"
   142	        " DATA (Slice 32 artifact), not code"
   143	    )
   144	    text = tiers_file.read_text(encoding="utf-8")
   145	    assert FIXTURE_PREFIX in text, (
   146	        f"{tiers_file} carries no rule for {FIXTURE_PREFIX!r}; the exclusion is"
   147	        " not data-driven"
   148	    )
   149	
   150	    full = tiers.load_tier_map(tiers_file)
   151	    assert full.classify(FIXTURE_PREFIX + "cargo-skew/Cargo.toml").action == "exclude"
   152	
   153	    stripped = tiers.TierMap(
   154	        [r for r in full.rules if not r.prefix.startswith(FIXTURE_PREFIX)]
   155	    )
   156	    with pytest.raises(tiers.UntieredManifestError):
   157	        stripped.classify(FIXTURE_PREFIX + "cargo-skew/Cargo.toml")
   158	
   159	    # --- and now at the SURVEY BOUNDARY, which is where REQ-5 actually bites -
   160	    survey_mod = require(
   161	        "sbom_survey.survey",
   162	        "AC-SBOM-06",
   163	        "run_survey(repo_root, *, published, tier_map=…) must take its exclusion"
   164	        " decisions FROM the injected tier map: with the fixture rule present"
   165	        " the fixture manifests are excluded; with that one rule removed they"
   166	        " must reach tiering and raise UntieredManifestError naming a fixture"
   167	        ' path. A hardcoded path.startswith("dev/release/fixtures/") inside'
   168	        " run_survey() cannot satisfy both halves.",
   169	    )
   170	    registry = require(
   171	        "sbom_survey.registry",
   172	        "AC-SBOM-06",
   173	        "an OfflineSource keeps the survey-boundary run hermetic.",
   174	    )
   175	
   176	    fixtures = _fixture_manifests()
   177	
   178	    with_rule = survey_mod.run_survey(
   179	        REPO_ROOT, published=registry.OfflineSource(), tier_map=full
   180	    )
   181	    still_excluded = {e.path for e in with_rule.excluded}
   182	    missing = sorted(set(fixtures) - still_excluded)
   183	    assert not missing, (
   184	        "run_survey() did not honour the INJECTED tier map — these fixture"
   185	        f" manifests were not excluded: {missing}"
   186	    )
   187	
   188	    with pytest.raises(tiers.UntieredManifestError) as excinfo:
   189	        survey_mod.run_survey(
   190	            REPO_ROOT, published=registry.OfflineSource(), tier_map=stripped
   191	        )
   192	    assert any(path in str(excinfo.value) for path in fixtures), (
   193	        "run_survey() with the fixture rule REMOVED must fail loudly, naming a"
   194	        " fixture manifest (REQ-4). If it excluded them anyway, the exclusion"
   195	        " lives in CODE rather than in tiers.toml, which is exactly what REQ-5"
   196	        f" forbids. Error was: {excinfo.value}"
   197	    )
   198	
   199	
   200	def test_untiered_manifest_raises_untiered_manifest_error() -> None:
   201	    """AC-SBOM-07.
   202	
   203	    A tracked manifest matched by NO rule is a hard error naming the path.
   204	    There is deliberately no catch-all rule: a default would turn "somebody
   205	    added a manifest and nobody classified it" — the event this tool exists to
   206	    catch — into a silent mis-tag.
   207	    """
   208	    tiers = require(
   209	        "sbom_survey.tiers",
   210	        "AC-SBOM-07",
   211	        "TierMap.classify() must raise UntieredManifestError NAMING THE PATH for"
   212	        " a tracked manifest that matches no rule. It must never return a null"
   213	        " tier, never fall back to a default tier, and never drop the manifest.",
   214	    )
   215	
   216	    tier_map = tiers.TierMap(
   217	        [tiers.TierRule(prefix="src/rust/crates/", action="tier", tier="shipped")]
   218	    )
   219	    with pytest.raises(tiers.UntieredManifestError) as excinfo:
   220	        tier_map.classify("some/brand/new/Cargo.toml")
   221	    assert "some/brand/new/Cargo.toml" in str(excinfo.value), (
   222	        "the error must name the offending path so the fix is obvious; got: "
   223	        f"{excinfo.value}"
   224	    )
   225	
   226	
   227	def test_tier_map_covers_every_discovered_manifest() -> None:
   228	    """AC-SBOM-08.
   229	
   230	    The repository's own tiers.toml must classify every path discovery
   231	    currently returns. This is the drift detector: a manifest added tomorrow
   232	    goes red here until somebody tiers it.
   233	    """
   234	    tiers = require(
   235	        "sbom_survey.tiers",
   236	        "AC-SBOM-08",
   237	        "scripts/sbom-survey/tiers.toml must classify EVERY tracked manifest"
   238	        " this repository currently has — an unclassified one fails loudly.",
   239	    )
   240	    discovery = require(
   241	        "sbom_survey.discovery",
   242	        "AC-SBOM-08",
   243	        "discovery supplies the paths that the tier map must cover.",
   244	    )
   245	
   246	    tier_map = tiers.load_tier_map(PROJECT_ROOT / "tiers.toml")
   247	    unclassified: list[str] = []
   248	    for ref in discovery.discover_manifests(REPO_ROOT):
   249	        try:
   250	            tier_map.classify(ref.path)
   251	        except tiers.UntieredManifestError:
   252	            unclassified.append(ref.path)
   253	    assert not unclassified, (
   254	        "tracked manifests with no tier assignment: "
   255	        f"{sorted(unclassified)} — add a rule to {PROJECT_ROOT / 'tiers.toml'}"
   256	    )
