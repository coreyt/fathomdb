   466	
   467	REQ-11. Design: dev/design/0.8.20-slice-31-sbom-survey-tool.md §5.6.
   468	"""
   469	
   470	from __future__ import annotations
   471	
   472	from conftest import REPO_ROOT, is_gitignored, require
   473	
   474	
   475	def test_report_dir_is_gitignored_and_findings_home_is_tracked() -> None:
   476	    """AC-SBOM-18.
   477	
   478	    Generated reports are gitignored (HITL-ruled). Slice 33's *findings*
   479	    therefore need a separate, deliberately NOT-ignored durable home — the raw
   480	    tool output is not one.
