   155	
   156	def test_survey_performs_no_network_io_by_default() -> None:
   157	    """AC-SBOM-14.
   158	
   159	    `run_survey` takes `published` as a REQUIRED keyword-only argument, so no
   160	    code path reaches the network implicitly. With `OfflineSource` a full
   161	    survey must open zero sockets — proved by making `socket.socket` explode.
   162	    """
   163	    survey_mod = require(
   164	        "sbom_survey.survey",
   165	        "AC-SBOM-14",
   166	        "run_survey(root, *, published=...) must take the published-version"
   167	        " source as a REQUIRED keyword-only argument and must perform ZERO"
   168	        " socket I/O when given an OfflineSource.",
   169	    )
   170	    registry = require(
   171	        "sbom_survey.registry",
   172	        "AC-SBOM-14",
   173	        "registry.OfflineSource must be a PublishedVersionSource that never"
   174	        " touches the network.",
   175	    )
   176	
   177	    with pytest.raises(TypeError):
   178	        survey_mod.run_survey(REPO_ROOT)  # `published` must not have a default
   179	
   180	    real_socket = socket.socket
   181	    opened: list[object] = []
   182	
   183	    def exploding_socket(*args, **kwargs):
   184	        opened.append(args)
   185	        raise AssertionError("the offline survey opened a socket")
   186	
   187	    socket.socket = exploding_socket  # type: ignore[assignment]
   188	    try:
   189	        survey_mod.run_survey(REPO_ROOT, published=registry.OfflineSource())
   190	    finally:
   191	        socket.socket = real_socket  # type: ignore[assignment]
   192	
   193	    assert not opened, "the offline survey opened a socket"
