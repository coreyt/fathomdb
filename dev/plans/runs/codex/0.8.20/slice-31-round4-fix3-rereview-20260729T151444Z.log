   290	"""AC-SBOM-22 — the Slice-33 consumer contract.
   291	
   292	REQ-13 (determinism) and REQ-14 (consumer fields).
   293	Design: dev/design/0.8.20-slice-31-sbom-survey-tool.md §5.8.
   294	
   295	Slice 33 answers exactly two questions and stops: what is stale, and would a
   296	surgical ~1-5 SLOC change likely land it. This report must let it answer both
   297	without re-deriving anything. Nothing in Slice 33 is built here.
   298	"""
   299	
   300	from __future__ import annotations
   301	
   302	import json
   303	from datetime import datetime, timezone
   304	from pathlib import Path
   305	
   306	import pytest
   307	
   308	from conftest import REPO_ROOT, require, run_cli
   309	
   310	SLICE_33_ROW_FIELDS = {
   311	    "ecosystem",
   312	    "name",
   313	    "tier",
   314	    "depth",
   315	    "locked_version",
   316	    "latest_version",
   317	    "status",
   318	    "lookup_error",
   319	    "declared_in",
   320	    "edit_sites",
   321	    "edit_site_count",
   322	}
   323	
   324	# A default-path timestamp may not be wall-clock. §5.8 rules the default a FIXED
   325	# epoch, so any stamp within a day of the real clock is a wall-clock default.
   326	# The window is deliberately generous: it must not be tripped by a slow run, a
   327	# timezone slip or a machine whose clock is a few hours out, only by an
   328	# implementation that actually asks the operating system what time it is.
   329	WALL_CLOCK_WINDOW_SECONDS = 24 * 60 * 60
   330	
   331	
   332	def _assert_identical(first: dict[str, bytes], second: dict[str, bytes], what: str) -> None:
   333	    assert first and second, f"no artifacts were written {what}"
   334	    assert first.keys() == second.keys(), (
   335	        f"a different artifact set was written {what}: {sorted(first)} vs {sorted(second)}"
   336	    )
   337	    for name in first:
   338	        assert first[name] == second[name], (
   339	            f"{name} is not byte-identical {what} — the report is"
   340	            " non-deterministic, so a recurring re-run cannot diff cleanly"
   341	        )
   342	
   343	
   344	def test_staleness_rows_carry_slice_33_fields_and_are_deterministic(
   345	    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
   346	) -> None:
   347	    """AC-SBOM-22.
   348	
   349	    REQ-13 is about ORDINARY repeated runs, so the DEFAULT timestamp path is the
   350	    one that has to be covered. Pinning `now` on both runs — all this test used
   351	    to do — leaves an implementation that falls back to wall-clock whenever
   352	    `now` / `--now` is omitted passing (codex §9 round 2, fix-2 finding 3).
   353	    Three determinism legs are therefore run: pinned `now`, the in-process
   354	    default, and the CLI default (argparse has a default of its own and could
   355	    hand `run_survey` a wall-clock `now` explicitly, bypassing the other two).
   356	    """
   357	    survey_mod = require(
   358	        "sbom_survey.survey",
   359	        "AC-SBOM-22",
   360	        "each staleness row must carry exactly the Slice-33 consumer fields"
   361	        f" {sorted(SLICE_33_ROW_FIELDS)}, sorted by"
   362	        " (tier, ecosystem, name, locked_version); and two runs over identical"
   363	        " inputs must write BYTE-IDENTICAL artifacts — WITH and WITHOUT an"
   364	        " explicit `now`, in-process and through the CLI (UUIDv5 serialNumber,"
   365	        " a FIXED default epoch, no wall-clock timestamp) so a re-run diffs to"
   366	        " nothing.",
   367	    )
   368	    registry = require("sbom_survey.registry", "AC-SBOM-22", "OfflineSource keeps the run hermetic.")
   369	    report = require(
   370	        "sbom_survey.report",
   371	        "AC-SBOM-22",
   372	        "sbom_survey.report.write_reports(survey, out_dir) must emit"
   373	        " sbom.cdx.json, staleness.json and staleness.md deterministically.",
   374	    )
   375	
   376	    # Cleared so the PURE built-in default is exercised, not an environment
   377	    # override — and so the CLI subprocesses below inherit the same posture.
   378	    monkeypatch.delenv("SOURCE_DATE_EPOCH", raising=False)
   379	
   380	    def once(out: Path, **kwargs) -> dict[str, bytes]:
   381	        survey = survey_mod.run_survey(
   382	            REPO_ROOT, published=registry.OfflineSource(), **kwargs
   383	        )
   384	        report.write_reports(survey, out)
   385	        return {p.name: p.read_bytes() for p in sorted(out.iterdir())}
   386	
   387	    # Leg 1 — an explicit, pinned `now`.
   388	    pinned = "1970-01-01T00:00:00Z"
   389	    _assert_identical(
   390	        once(tmp_path / "a", now=pinned),
   391	        once(tmp_path / "b", now=pinned),
   392	        "across two runs with an explicit `now`",
   393	    )
   394	
   395	    # Leg 2 — the DEFAULT path, which is what an ordinary re-run takes.
   396	    default_first = once(tmp_path / "c")
   397	    _assert_identical(
   398	        default_first,
   399	        once(tmp_path / "d"),
   400	        "across two DEFAULT runs (no explicit `now`)",
   401	    )
   402	
   403	    # Byte-equality alone does not settle leg 2: two back-to-back runs can share
   404	    # a wall-clock second and look identical by luck. The default stamp must
   405	    # therefore be shown NOT to be wall-clock at all.
   406	    stamp = json.loads(default_first["sbom.cdx.json"])["metadata"]["timestamp"]
   407	    parsed = datetime.fromisoformat(str(stamp).replace("Z", "+00:00"))
   408	    if parsed.tzinfo is None:
   409	        parsed = parsed.replace(tzinfo=timezone.utc)
   410	    drift = abs((datetime.now(timezone.utc) - parsed).total_seconds())
   411	    assert drift > WALL_CLOCK_WINDOW_SECONDS, (
   412	        f"the DEFAULT run stamped metadata.timestamp {stamp!r}, which is within"
   413	        " a day of the real clock. §5.8 rules the default a FIXED epoch"
   414	        " (SOURCE_DATE_EPOCH or an explicit --now are the only overrides); a"
   415	        " wall-clock default makes every re-run diff, and two runs inside the"
   416	        " same second would still compare byte-identical, so the equality check"
   417	        " above cannot catch it on its own."
   418	    )
   419	
   420	    # Leg 3 — the CLI default. `--now` could be defaulted to the current time in
   421	    # the argument parser and passed explicitly to run_survey, which would sail
   422	    # past both legs above.
   423	    cli_runs: list[dict[str, bytes]] = []
   424	    for name in ("cli-a", "cli-b"):
   425	        out = tmp_path / name
   426	        proc = run_cli(
   427	            ["--repo", str(REPO_ROOT), "--offline", "--out", str(out)],
   428	            "AC-SBOM-22",
   429	            "two `sbom-survey --repo R --offline --out DIR` runs with NO --now"
   430	            " must write byte-identical artifacts, and must stamp the same"
   431	            " fixed default timestamp run_survey() uses in-process.",
   432	        )
   433	        assert proc.returncode == 0, (
   434	            f"offline CLI run exited {proc.returncode}\nstderr:\n{proc.stderr}"
   435	        )
   436	        cli_runs.append({p.name: p.read_bytes() for p in sorted(out.iterdir())})
   437	
   438	    _assert_identical(*cli_runs, what="across two CLI runs with no --now")
   439	
   440	    cli_stamp = json.loads(cli_runs[0]["sbom.cdx.json"])["metadata"]["timestamp"]
   441	    assert cli_stamp == stamp, (
   442	        f"the CLI stamped {cli_stamp!r} where run_survey()'s own default is"
   443	        f" {stamp!r} — `--now` is being defaulted in the argument parser, which"
   444	        " bypasses the deterministic default proved above"
   445	    )
   446	
   447	    # --- the Slice-33 consumer field set ------------------------------------
   448	    survey = survey_mod.run_survey(REPO_ROOT, published=registry.OfflineSource())
   449	    rows = [r.as_dict() for r in survey.staleness()]
   450	    assert rows, "vacuous-pass guard: zero staleness rows"
   451	
   452	    for row in rows:
   453	        assert set(row) == SLICE_33_ROW_FIELDS, (
   454	            "staleness row field set drifted from the Slice-33 contract:"
   455	            f" missing={sorted(SLICE_33_ROW_FIELDS - set(row))}"
   456	            f" unexpected={sorted(set(row) - SLICE_33_ROW_FIELDS)}"
   457	        )
   458	        assert isinstance(row["edit_sites"], list)
   459	        assert row["edit_site_count"] == len(row["edit_sites"])
   460	        for site in row["edit_sites"]:
   461	            assert not site.startswith("/"), "edit_sites must be repo-relative"
   462	
   463	    keys = [(r["tier"], r["ecosystem"], r["name"], r["locked_version"] or "") for r in rows]
   464	    assert keys == sorted(keys), "staleness rows are not deterministically sorted"
