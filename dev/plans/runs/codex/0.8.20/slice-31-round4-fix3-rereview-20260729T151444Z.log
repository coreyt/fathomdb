   171	
   172	def test_dependency_graph_is_closed_and_depth_tagged() -> None:
   173	    """AC-SBOM-12.
   174	
   175	    library<->library enumeration. The `dependencies` array is the edge set;
   176	    every `dependsOn` ref must resolve to a declared component (no dangling
   177	    refs), and every component is tagged direct or transitive — LBS §2's
   178	    triage turns on that distinction.
   179	
   180	    Closure ALONE is vacuous, and that was codex §9 round 1's third finding: an
   181	    empty `dependencies` array is trivially closed, so an implementation that
   182	    emitted the manifest-derived DIRECT set and skipped every lockfile-derived
   183	    library<->library edge used to pass. The graph is therefore asserted
   184	    non-empty, closed in BOTH directions (every declared component appears as a
   185	    `ref`, leaves carrying an empty `dependsOn`), to contain at least one edge
   186	    whose source is a library rather than the root component, and to have
   187	    carried at least one known lockfile-only crate through as `transitive`.
   188	    """
   189	    survey = _offline_survey(
   190	        "AC-SBOM-12",
   191	        "the CycloneDX `dependencies` array must be NON-EMPTY and CLOSED IN BOTH"
   192	        " DIRECTIONS (every dependsOn ref resolves to a declared component"
   193	        " bom-ref, and every declared component appears as a `ref` entry), must"
   194	        " contain at least one library->library edge, and every component must"
   195	        " carry `fathomdb:depth` in {direct, transitive} with at least one"
   196	        " lockfile-only package tagged `transitive`.",
   197	    )
   198	    doc = survey.to_cyclonedx()
   199	
   200	    component_refs = {c["bom-ref"] for c in doc["components"]}
   201	    root_ref = doc["metadata"]["component"]["bom-ref"]
   202	    declared = component_refs | {root_ref}
   203	
   204	    entries = doc.get("dependencies")
   205	    assert isinstance(entries, list) and entries, (
   206	        "the `dependencies` array is empty — REQ-8 and §5.5 require the"
   207	        " lockfile-derived library<->library edge set, and an empty graph is"
   208	        " vacuously 'closed' while enumerating nothing"
   209	    )
   210	
   211	    dangling: list[str] = []
   212	    for entry in entries:
   213	        if entry["ref"] not in declared:
   214	            dangling.append(entry["ref"])
   215	        for target in entry.get("dependsOn", []):
   216	            if target not in declared:
   217	                dangling.append(target)
   218	    assert not dangling, f"dangling dependency refs (graph not closed): {sorted(set(dangling))}"
   219	
   220	    ungraphed = sorted(component_refs - {e["ref"] for e in entries})
   221	    assert not ungraphed, (
   222	        "these components have no `dependencies` entry, so the graph does not"
   223	        f" cover the component list (leaves take an empty dependsOn): {ungraphed[:5]}"
   224	        f" (+{max(0, len(ungraphed) - 5)} more)"
   225	    )
   226	
   227	    library_edges = [
   228	        e for e in entries if e["ref"] != root_ref and e.get("dependsOn")
   229	    ]
   230	    assert library_edges, (
   231	        "every edge in the graph originates at the root component — not one"
   232	        " library->library edge was emitted, which is the core of REQ-8"
   233	    )
   234	
   235	    for component in doc["components"]:
   236	        depths = [
   237	            p["value"]
   238	            for p in component.get("properties", [])
   239	            if p.get("name") == "fathomdb:depth"
   240	        ]
   241	        ref = component["bom-ref"]
   242	        assert len(depths) == 1, f"{ref}: expected one fathomdb:depth, got {depths}"
   243	        assert depths[0] in ("direct", "transitive"), f"{ref}: bad depth {depths[0]!r}"
   244	
   245	    def _depth(component: dict) -> str | None:
   246	        for prop in component.get("properties", []):
   247	            if prop.get("name") == "fathomdb:depth":
   248	                return prop.get("value")
   249	        return None
   250	
   251	    assert any(_depth(c) == "direct" for c in doc["components"]), (
   252	        "no component was tagged direct — the manifest-derived direct set is empty"
   253	    )
   254	
   255	    transitive_cargo = {
   256	        c.get("name")
   257	        for c in doc["components"]
   258	        if _depth(c) == "transitive"
   259	        and str(c.get("purl", "")).startswith(PURL_PREFIX_BY_ECOSYSTEM["cargo"])
   260	    }
