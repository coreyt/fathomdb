     1	"""AC-SBOM-01 .. AC-SBOM-04 — manifest discovery.
     2	
     3	REQ-1 (discovery is `git ls-files`-derived) and REQ-2 (completeness).
     4	Design: dev/design/0.8.20-slice-31-sbom-survey-tool.md §5.1.
     5	"""
     6	
     7	from __future__ import annotations
     8	
     9	from pathlib import Path
    10	
    11	from conftest import (
    12	    REPO_ROOT,
    13	    require,
    14	    tracked_manifest_paths,
    15	    tracked_paths,
    16	)
