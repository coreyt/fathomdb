    97	# The NEGATIVE CONTROL for AC-SBOM-10's independent schema oracle.
    98	#
    99	# CycloneDX 1.6 makes `type` REQUIRED on every component (the 1.6 component
   100	# definition is `"required": ["type", "name"]`), so a conforming validator must
   101	# reject this document. A validator that accepts it is not validating anything,
   102	# and a clean result from it would prove nothing — which is the whole failure
   103	# mode AC-SBOM-10 exists to stop.
   104	KNOWN_INVALID_CYCLONEDX_DOC = {
   105	    "bomFormat": "CycloneDX",
   106	    "specVersion": "1.6",
   107	    "version": 1,
   108	    "components": [{"name": "component-with-no-type", "version": "1.0.0"}],
