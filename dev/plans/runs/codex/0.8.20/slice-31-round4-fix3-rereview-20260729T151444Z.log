    58	def test_gitignored_top_level_python_dir_is_out_of_scope() -> None:
    59	    """AC-SBOM-02.
    60	
    61	    `.gitignore` ignores `/python/` in its entirety (the sourceless recovered
    62	    binding kept on disk for Memex). `python/pyproject.toml` is therefore
    63	    UNTRACKED and out of BOM scope, even on a developer machine where the
    64	    directory exists. This is the LBS charter §2 "noise against gitignored
    65	    dev/eval lockfiles" trap.
    66	    """
    67	    assert not any(p.startswith("python/") for p in tracked_paths()), (
    68	        "precondition changed: `python/` is now tracked — the design's scope"
    69	        " ruling (§5.1) must be revisited before this criterion is re-graded"
    70	    )
    71	
    72	    discovery = require(
    73	        "sbom_survey.discovery",
    74	        "AC-SBOM-02",
    75	        "discover_manifests(REPO_ROOT) must return no path under `python/`,"
    76	        " because `.gitignore` ignores the whole `/python/` tree and the SBOM"
    77	        " scope is `everything tracked on main`.",
    78	    )
    79	
    80	    refs = discovery.discover_manifests(REPO_ROOT)
    81	    leaked = sorted(r.path for r in refs if r.path.startswith("python/"))
    82	    assert not leaked, f"gitignored `/python/` leaked into the BOM scope: {leaked}"
    83	
