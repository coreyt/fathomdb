    24	def _offline_survey(criterion: str, behaviour: str):
    25	    survey_mod = require("sbom_survey.survey", criterion, behaviour)
    26	    registry = require("sbom_survey.registry", criterion, behaviour)
    27	    return survey_mod.run_survey(REPO_ROOT, published=registry.OfflineSource())
