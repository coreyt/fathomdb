   111	
   112	def purl_type(purl: object) -> str | None:
   113	    """The purl `type` segment (`pkg:<type>/…`), or None if it is not a purl."""
   114	    if not isinstance(purl, str) or not purl.startswith("pkg:"):
   115	        return None
   116	    return purl[len("pkg:") :].split("/", 1)[0]
