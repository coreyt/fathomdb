  1082	        if block is None:
  1083	            continue
  1084	        inner = re.search(r"\bfn\s+" + re.escape(fn) + r"\b[^{;]*\{", block)
  1085	        if inner is None:
  1086	            continue
  1087	        body = brace_body(block, inner.end() - 1)
  1088	        if body is not None:
  1089	            return body
  1090	    return None
