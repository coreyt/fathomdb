   935	def walk_tree(rel, exts):
   936	    """Every (path, text) text file under a root-relative tree, as a LIST.
   937	
   938	    TC-37 path #4 FOR A TREE-SCOPED SUBJECT (fix-3). Once a probe's subject is a
   939	    TREE rather than a FILE, "missing" needs a definition, and there are two
   940	    ways a tree can fail to be a subject:
   941	
   942	      * THE DIRECTORY IS ABSENT. Unambiguous: the assertion could not be
   943	        evaluated at all. exit 2, as it always has been.
   944	      * THE DIRECTORY YIELDS NO CANDIDATE FILE (it is empty, or holds nothing
   945	        matching `exts`, or only binaries). Judgement call, decided this way: a
   946	        NEGATIVE assertion that examined ZERO files is trivially satisfiable and
   947	        would report "no violation found" having looked at nothing. That is the
   948	        vacuous pass in its purest form, and it is what a renamed/moved crate
   949	        leaves behind. exit 2.
   950	
   951	    A LIST rather than a generator, because "examined nothing" can only be known
   952	    after the walk finishes, and a caller that returns early on the first match
   953	    would never let a generator get there. Cached per (tree, exts): the three
   954	    negative-space probes of C1-Q6B share one walk of src/, and the whole scan
   955	    happens once per distinct scope rather than once per probe.
   956	    """
   957	    key = (rel, exts)
   958	    if key in _tree_cache:
   959	        return _tree_cache[key]
   960	    base = os.path.join(ROOT, rel)
   961	    if not os.path.isdir(base):
   962	        die_env(
   963	            f"the source tree {rel} does not exist under --root {ROOT} — a clause assertion could "
   964	            "not be EVALUATED (TC-37 evaporation path #4). The gate computed no verdict for that "
   965	            "clause, so it refuses to report one."
   966	        )
   967	    found = []
   968	    for dirpath, dirnames, filenames in os.walk(base):
   969	        dirnames[:] = sorted(d for d in dirnames if d not in SKIP_DIRS)
   970	        for name in sorted(filenames):
   971	            if exts is not None and not name.endswith(tuple(exts)):
   972	                continue
   973	            full = os.path.join(dirpath, name)
   974	            try:
   975	                with open(full, "rb") as fh:
   976	                    blob = fh.read()
   977	            except OSError as exc:
   978	                die_env(
   979	                    f"cannot read {os.path.relpath(full, ROOT)} while scanning {rel}: {exc} — a "
   980	                    "clause assertion could not be EVALUATED (TC-37 evaporation path #4)."
   981	                )
   982	            if b"\0" in blob[:8192]:
   983	                continue  # binary; the contract's negative space is about source text
   984	            found.append((os.path.relpath(full, ROOT), blob.decode("utf-8", errors="replace")))
   985	    if not found:
   986	        scope = "text file" if exts is None else "/".join(exts) + " file"
   987	        die_env(
   988	            f"the source tree {rel} under --root {ROOT} exists but holds no {scope} — 0 files were "
   989	            "scanned, so a NEGATIVE clause assertion would have reported 'no violation' having "
   990	            "examined NOTHING. That is not a pass, it is TC-37 evaporation path #4: the assertion "
   991	            "could not "
   992	            "be EVALUATED. Point --root at a complete source tree, or restore the crate."
   993	        )
   994	    _tree_cache[key] = found
