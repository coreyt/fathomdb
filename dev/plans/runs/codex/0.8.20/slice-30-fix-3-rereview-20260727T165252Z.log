  1097	def arm_pairs(body, ty):
  1098	    """Every (variant, string) match arm in `body`, both directions, sorted.
  1099	
  1100	    A LIST, not a dict: two arms mapping the same variant to two different
  1101	    spellings is itself a vocabulary that is not closed, and collapsing them
  1102	    into a dict would hide exactly that.
  1103	
  1104	    OR-PATTERNS are expanded (fix-2, codex §9 round 2 finding #3): in
  1105	    `"vector" | "searchable" => Some(Ty::Searchable)` only the LAST alternative
  1106	    sits immediately before the `=>`, so a single-literal pattern harvested the
  1107	    pinned pair and reported the vocabulary as exact while the arm accepted a
  1108	    second token. Each alternative now yields its own pair, in BOTH directions.
  1109	    """
  1110	    who = r"(?:Self|" + re.escape(ty) + r")"
  1111	    variant = who + r"::[A-Za-z_]\w*"
  1112	    pairs = []
  1113	    # [Ty::A |] Ty::B => "s"
  1114	    for match in re.finditer(
  1115	        r"((?:" + variant + r"\s*\|\s*)*" + variant + r")\s*=>\s*" + _STRING_CAP, body
  1116	    ):
  1117	        for name in re.findall(who + r"::([A-Za-z_]\w*)", match.group(1)):
  1118	            pairs.append((name, match.group(2)))
  1119	    # ["a" |] "b" => Some(Ty::A)
  1120	    for match in re.finditer(
  1121	        r"((?:" + _STRING_LIT + r"\s*\|\s*)*" + _STRING_LIT + r")\s*=>\s*Some\("
  1122	        + who + r"::([A-Za-z_]\w*)\)",
  1123	        body,
  1124	    ):
  1125	        for spelling in re.findall(_STRING_CAP, match.group(1)):
  1126	            pairs.append((match.group(2), spelling))
  1127	    return sorted(pairs)
