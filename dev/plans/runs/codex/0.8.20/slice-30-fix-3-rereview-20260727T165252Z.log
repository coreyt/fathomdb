@@ -30,6 +30,8 @@ PREFLIGHT="$REPO_ROOT/scripts/preflight.sh"
 CHECKER="$REPO_ROOT/scripts/check-board-currency.sh"
 # shellcheck source=lib/governed-surface-fixture.sh
