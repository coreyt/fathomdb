  1044	def enum_variants(view, ty):
  1045	    """Every variant identifier of `enum ty`, in declaration order; None if the
  1046	    declaration is absent or unparseable."""
  1047	    match = re.search(r"\benum\s+" + re.escape(ty) + r"\b[^{;]*\{", view)
  1048	    if match is None:
  1049	        return None
  1050	    body = brace_body(view, match.end() - 1)
  1051	    if body is None:
  1052	        return None
  1053	    body = re.sub(r"#\[[^\]]*\]", " ", body)
  1054	    chunks, depth, current = [], 0, ""
  1055	    for char in body:
  1056	        if char in "({[":
  1057	            depth += 1
  1058	        elif char in ")}]":
  1059	            depth -= 1
  1060	        if char == "," and depth == 0:
  1061	            chunks.append(current)
  1062	            current = ""
  1063	        else:
  1064	            current += char
  1065	    chunks.append(current)
  1066	    variants = []
  1067	    for chunk in chunks:
  1068	        chunk = chunk.strip()
  1069	        if not chunk:
  1070	            continue
  1071	        name = re.match(r"([A-Za-z_][A-Za-z0-9_]*)", chunk)
  1072	        if name is None:
  1073	            return None
  1074	        variants.append(name.group(1))
  1075	    return variants
