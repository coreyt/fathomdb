  1002	# ---------------------------------------------------------------------------
  1003	# STRUCTURAL RUST READING for the CLOSED-VOCABULARY probes (fix-1).
  1004	#
  1005	# Deliberately a small, dumb reader, not a Rust parser: it strips comments,
  1006	# brace-matches ONE named block, and reads what is inside. Everything it can
  1007	# fail to find is reported as a CLAUSE DEFECT (exit 1) rather than being
  1008	# skipped, so a rename or a refactor that puts the enum somewhere this reader
  1009	# cannot see it goes RED and gets looked at — it never quietly stops checking.
  1010	#
  1011	# Known limits, stated rather than papered over: comment-stripping is textual,
  1012	# so a `//` inside a string literal truncates that line, and brace-matching does
  1013	# not skip braces inside strings. Neither can reach the three blocks read here
  1014	# (their bodies hold only bare identifiers and short string literals), and both
  1015	# would surface as a clause FAILURE, never as a silent pass.
  1016	# ---------------------------------------------------------------------------
  1017	_view_cache = {}
  1018	
  1019	
  1020	def rust_view(rel):
  1021	    """A comment-stripped view of a Rust source file (cached)."""
  1022	    if rel not in _view_cache:
  1023	        text = read_source(rel)
  1024	        text = re.sub(r"/\*.*?\*/", " ", text, flags=re.S)
  1025	        text = re.sub(r"//[^\n]*", "", text)
  1026	        _view_cache[rel] = text
  1027	    return _view_cache[rel]
