+run_preflight "$CLEAN_LINKED" --landing
+if [ "$RC" -eq 0 ]; then
+  pass "--landing still exits 0 in a worktree that conforms to the pinned contract"
+else
+  fail "--landing must not regress a conforming tree; got rc=$RC, out: $OUT"
+fi
