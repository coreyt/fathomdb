  1030	def brace_body(text, open_index):
  1031	    """Body of the brace block whose '{' sits at open_index; None if unbalanced."""
  1032	    depth = 0
  1033	    for i in range(open_index, len(text)):
  1034	        char = text[i]
  1035	        if char == "{":
  1036	            depth += 1
  1037	        elif char == "}":
  1038	            depth -= 1
  1039	            if depth == 0:
  1040	                return text[open_index + 1:i]
  1041	    return None
