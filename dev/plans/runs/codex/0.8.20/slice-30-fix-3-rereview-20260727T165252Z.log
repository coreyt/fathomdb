 pass() { printf 'PASS  %s\n' "$1"; }
@@ -74,6 +76,7 @@ init_repo() {
   # beyond its presence, and the gate's own arms live in
   # scripts/tests/test_check_governed_surface_pin.sh.
   seed_governed_surface_fixture "$dir"
+  seed_c1_conformance_fixture "$dir"
 }
 
