    assert.ok(got, "the projection must exist");
    assert.equal(got.fts, true);
    assert.equal(got.vector, true);
    assert.deepEqual([...got.roles].sort(), ["filterable", "searchable"]);
  } finally {
    await engine.close();
  }
});

