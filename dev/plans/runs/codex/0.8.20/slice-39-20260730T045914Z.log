341
    switch (t.term) {
342
      case "source_type":
343
        sf.sourceType = t.value;
344
        break;
345
      case "kind":
346
        sf.kind = t.value;
347
        break;
348
      case "created_after":
349
        sf.createdAfter = t.value;
350
        break;
351
      case "status":
352
        sf.status = t.value;
353
        break;
354
      case "json":
355
        throw new InvalidFilterError(VEC0_JSON_REJECT);
356
    }
357
  }
358
  return sf;
359
}
