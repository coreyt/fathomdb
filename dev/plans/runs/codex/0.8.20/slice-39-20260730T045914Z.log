    "fathomdb-engine": { "keywords": ["database", "embedded", "sqlite", "vector-search", "full-text-search"], "count": 5, "max_len": 16 },
    "fathomdb-schema": { "keywords": ["sqlite", "migrations", "schema", "database", "embedded"], "count": 5, "max_len": 10 },
    "fathomdb-query": { "keywords": ["sqlite", "fts5", "full-text-search", "query", "search"], "count": 5, "max_len": 16 },
