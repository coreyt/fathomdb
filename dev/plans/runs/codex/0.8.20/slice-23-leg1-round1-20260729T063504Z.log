                            ("recovery", SLICE_TEMPLATE, ["when something goes wrong"]),
                            ("escalate", LBO_TEMPLATE, ["escalate to lbs"])):
        a = m.anchor(path, kw, label)
        if a:
            m.out("  %-17s %s" % (label, a))
    m.out()

