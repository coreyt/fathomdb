+  C9F_SEEN=0
+  C9F_LAST=""
+  C9F_OUT=""
+  while read -r c9f_rel c9f_slice c9f_ref; do
+    [ -n "$c9f_ref" ] || continue
+    C9F_SEEN=$((C9F_SEEN + 1))
+    if [ "$c9f_rel/$c9f_slice" != "$C9F_LAST" ]; then
+      C9F_LAST="$c9f_rel/$c9f_slice"
+      set +e
+      C9F_OUT="$("$REPO_ROOT/scripts/commission-manifest.sh" "$c9f_rel" "$c9f_slice" 2>&1)"
+      C9F_RC=$?
