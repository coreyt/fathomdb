import sys
p = sys.argv[1]
text = open(p, encoding="utf-8").read()
assert "pub enum DenseReadiness {" in text
text = text.replace("pub enum DenseReadiness {", "pub enum VectorFreshness {", 1)
open(p, "w", encoding="utf-8").write(text)
