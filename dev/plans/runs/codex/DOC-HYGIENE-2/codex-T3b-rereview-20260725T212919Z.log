def build(release, state_path, state, slice_no, entry):
    m = Manifest()
    ladder = {e.get("slice"): e for e in state.get("ladder") or []}
    landed = state.get("landed") or []
    next_slice = state.get("next_slice")
    plan = state.get("plan") or ""
