   283	
   284	# ========= Arm 8b (RED): a pin that DELETES one of its own counts ============
   285	# Arm 8 proved the counts block is what catches a lazy re-pin. So the counts
   286	# block is itself worth attacking: reading counts.<list> permissively meant an
   287	# ABSENT entry came back as None and BOTH the internal-consistency check and the
   288	# file-count check silently skipped that list. Deleting a count therefore
   289	# disarmed the backstop — the gate would have kept reporting "ok" while checking
   290	# strictly less than it claimed. Captured on the pre-fix script, all three of
   291	# these exited 0. A count the gate cannot read is a MALFORMED PIN (exit 2, "the
   292	# gate could not run"), never a divergence (exit 1, "go get the surface signed").
   293	#
   294	# omit_count_pin <key> -> prints the path of a pin with counts.<key> deleted
   295	omit_count_pin() {
   296	  local key="$1" out="$TMPROOT/pin-omit-$1.json"
   297	  python3 - "$REAL_PIN" "$out" "$key" <<'PY'
   298	import json, sys
   299	pin = json.load(open(sys.argv[1]))
   300	del pin["counts"][sys.argv[3]]
   301	json.dump(pin, open(sys.argv[2], "w"), indent=2)
   302	PY
   303	  printf '%s' "$out"
   304	}
   305	
   306	for KEY in allowlist core recovery_denylist; do
   307	  check_fixture "$REAL_FILE" "$(omit_count_pin "$KEY")"
   308	  expect_rc 2 "a pin that OMITS counts.$KEY HARD-fails as malformed (was a silent exit 0)"
   309	  expect_out "'counts' has no '$KEY' entry" "omit-counts.$KEY names the missing count entry"
   310	  expect_out 'MALFORMED' "omit-counts.$KEY says the pin is malformed"
   311	  expect_out "DO NOT 'fix' this by regenerating the pin" \
   312	    "omit-counts.$KEY forbids regenerating the pin to clear it"
   313	  if printf '%s' "$OUT" | grep -q 'ok +governed-surface-pin'; then
   314	    fail "omit-counts.$KEY must never print an ok line; got: $OUT"
   315	  else
   316	    pass "omit-counts.$KEY prints no ok line (no vacuous pass)"
   317	  fi
   318	done
   319	
   320	# ===== Arm 8c (RED): counts entry present but not an integer =================
   321	# Same hole through a different door: null skipped the check exactly like an
   322	# absent key (pre-fix exit 0), a float 30.0 compared EQUAL to 30 and also passed
   323	# (pre-fix exit 0), and a string "30" tripped the consistency check with a
   324	# nonsense message ("counts.allowlist says 30 but its list holds 30"). All three
   325	# are a malformed pin, and all three must now say so.
   326	type_count_pin() {
   327	  local label="$1" literal="$2" out="$TMPROOT/pin-type-$1.json"
