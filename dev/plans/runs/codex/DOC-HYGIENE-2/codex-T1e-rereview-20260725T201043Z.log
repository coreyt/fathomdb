   337	check_fixture "$REAL_FILE" "$(type_count_pin null 'null')"
   338	expect_rc 2 "a NULL counts.allowlist HARD-fails as malformed (was a silent exit 0)"
   339	expect_out 'not an integer' "null-count says the count is not an integer"
   340	
   341	check_fixture "$REAL_FILE" "$(type_count_pin string '"30"')"
   342	expect_rc 2 "a STRING counts.allowlist HARD-fails as malformed (was a confusing exit 1)"
   343	expect_out 'not an integer' "string-count says the count is not an integer"
   344	
   345	check_fixture "$REAL_FILE" "$(type_count_pin float '30.0')"
   346	expect_rc 2 "a FLOAT counts.allowlist HARD-fails as malformed (30.0 == 30 used to pass)"
