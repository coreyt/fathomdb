   367	raw = open(sys.argv[2], "rb").read()
   368	pin["allowlist"] = json.loads(raw.decode("utf-8"))["allowlist"]  # signed list updated
   369	pin["sha256"] = hashlib.sha256(raw).hexdigest()                  # hashes recomputed
   370	pin["git_blob_sha1"] = hashlib.sha1(b"blob %d\0" % len(raw) + raw).hexdigest()
