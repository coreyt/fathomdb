   289	            f"{FILE} content differs from the pin ({WHERE}).\n"
   290	            f"        pinned   sha256 {pin['sha256']}  git-blob {pin['git_blob_sha1']}\n"
   291	            f"        on disk  sha256 {got_sha256}  git-blob {got_blob}"
