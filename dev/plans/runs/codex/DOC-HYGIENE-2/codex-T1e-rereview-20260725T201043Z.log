   330	pin = json.load(open(sys.argv[1]))
   331	pin["counts"]["allowlist"] = json.loads(sys.argv[3])
   332	json.dump(pin, open(sys.argv[2], "w"), indent=2)
   333	PY
   334	  printf '%s' "$out"
   335	}
