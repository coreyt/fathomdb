   258	  } >&2
   259	  exit 1
   260	fi
   261	if [ "$CITATIONS" -eq 0 ]; then
   262	  {
   263	    echo "FAIL lint-plan-anchors: ZERO citations verified across ${#PLANS[@]} ACTIVE plan(s)."
   264	    echo "  The existence check — the whole point of this gate — did not execute, so a"
   265	    echo "  green here would be vacuous (TC-37). Either the citation form drifted away"
   266	    echo "  from \`sym\` in \`path\`, or the extractor is broken."
   267	  } >&2
   268	  exit 1
   269	fi
   270	
   271	if [ "$FAIL" -ne 0 ]; then
   272	  printf '\nlint-plan-anchors: %d bare line anchor(s); scanned %d ACTIVE plan(s), %d citation(s).\n' \
   273	    "$ANCHORS" "${#PLANS[@]}" "$CITATIONS" >&2
