   190	for plan in "${PLANS[@]}"; do
   191	  # ---- RULE 1: bare line anchors ----------------------------------------
   192	  while IFS= read -r hit; do
   193	    [ -n "$hit" ] || continue
   194	    ln="${hit%%:*}"; tok="${hit#*:}"
   195	    ANCHORS=$((ANCHORS + 1))
   196	    FAIL=1
   197	    {
   198	      printf 'FAIL %s:%s: bare line anchor %s\n' "$plan" "$ln" "$tok"
   199	      printf '  A `<name>:<line>` pointer has no referential integrity — it rots on the next\n'
   200	      printf '  commit that touches the file, silently. Cite a greppable symbol instead:\n'
   201	      printf '      `fn some_symbol` in `path/to/file.rs`\n'
   202	      printf '  (this lint then verifies that symbol actually occurs in that file).\n'
   203	    } >&2
   204	  done < <(grep -noE "$ANCHOR_RE" "$plan" || true)
   205	
   206	  # ---- RULE 2: every citation must resolve AND exist ---------------------
   207	  while IFS=$'\t' read -r ln match; do
   208	    [ -n "$match" ] || continue
   209	    mapfile -t groups < <(tr '`' '\n' <<<"$match" | awk 'NR%2==0')
   210	    (( ${#groups[@]} >= 2 )) || continue
   211	    cited="${groups[-1]}"
   212	    unset 'groups[-1]'
   213	
   214	    resolved=""; rc=0
   215	    resolved="$(resolve_path "$cited")" || rc=$?
   216	    if [ "$rc" -eq 1 ]; then
   217	      FAIL=1
   218	      printf 'FAIL %s:%s: citation names `%s`, which matches no file in the worktree.\n' \
   219	        "$plan" "$ln" "$cited" >&2
   220	      continue
   221	    elif [ "$rc" -eq 2 ]; then
   222	      FAIL=1
   223	      printf 'FAIL %s:%s: citation path `%s` is AMBIGUOUS (matches >1 file) — it cannot be\n' \
   224	        "$plan" "$ln" "$cited" >&2
   225	      printf '  verified mechanically. Cite the full repo-relative path.\n' >&2
   226	      continue
   227	    fi
   228	
   229	    for sym in "${groups[@]}"; do
   230	      case "$sym" in
   231	        *…*|*...*)
   232	          FAIL=1
   233	          printf 'FAIL %s:%s: citation `%s` in `%s` contains an elision placeholder, so it\n' \
   234	            "$plan" "$ln" "$sym" "$cited" >&2
   235	          printf '  cannot be matched literally. An unverifiable citation is not skipped here —\n' >&2
   236	          printf '  that is how an unverified pointer gets laundered as a verified one. Rewrite\n' >&2
   237	          printf '  it as a literal symbol or quoted fragment that greps.\n' >&2
