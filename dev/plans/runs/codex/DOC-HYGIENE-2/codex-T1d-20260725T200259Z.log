    69	# lychee — link integrity. Offline by default; pass AGENT_LINK_CHECK=online to hit the network.
    70	#
    71	# TC-37 follow-up (deliberately left as skip-on-absent, unlike lint-md-structure above):
    72	# lychee is a separate Rust binary (cargo install), not part of the node_modules symlink
    73	# convention that makes markdownlint-cli2 trivially available in a worktree, and it is not
    74	# the tool implicated in the TC-37 incident (that was markdownlint-cli2 missing 9 real
    75	# structural errors). Hard-failing here would break every worktree that has not run the
    76	# full `scripts/bootstrap.sh` (which `cargo install`s lychee) for a check whose own online/
    77	# offline modality already signals partial, best-effort coverage. Revisit if a lychee-only
    78	# vacuous-green incident is ever observed.
    79	if command -v lychee >/dev/null 2>&1; then
    80	  if [ "${AGENT_LINK_CHECK:-offline}" = "online" ]; then
    81	    run_capped lint-md-links lychee --offline=false --no-progress '**/*.md'
    82	  else
    83	    run_capped lint-md-links lychee --offline --no-progress '**/*.md'
    84	  fi
    85	else
    86	  skip_notice lint-md-links "lychee not installed (run scripts/bootstrap.sh)"
    87	fi
