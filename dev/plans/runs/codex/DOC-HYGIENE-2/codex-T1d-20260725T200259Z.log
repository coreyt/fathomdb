    23	    echo "FAIL lint-md-structure: markdownlint-cli2 not found at node_modules/.bin/markdownlint-cli2."
    24	    echo "  A missing structural markdown linter must never report a silent pass (TC-37)."
    25	    echo "  Fix: run scripts/bootstrap.sh to install it, OR (inside a linked worktree)"
    26	    echo "  symlink the primary checkout's node_modules:"
    27	    echo "    ln -s /home/coreyt/projects/fathomdb/node_modules node_modules"
