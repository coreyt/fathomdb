    42	
    43	# T1d (DOC-HYGIENE-2): ACTIVE plans may not cite code by `<name>:<line>` — a
    44	# line number rots on the next commit, silently (plan-0.8.20.md's TC-45 pair was
    45	# ~2,100 lines off and git shows it was never correct) — and every symbol an
    46	# ACTIVE plan DOES cite must actually occur in the file it names. That second
    47	# half is the load-bearing one: swapping an unverified number for an unverified
    48	# symbol would launder the same bad pointer. Pure bash/perl, no external binary,
    49	# so no absent-tool skip path. Also runs always-on in CI (the `plan-anchors`
    50	# job) — the push that renames a symbol is a CODE push, which the docs_only
    51	# markdownlint job never sees.
    52	run_capped lint-plan-anchors "$SCRIPT_DIR/lint-plan-anchors.sh" --quiet
    53	
    54	# docs/** structural lint. The repo .markdownlint-cli2.jsonc IGNORES docs/** (it is
    55	# otherwise gated only by `mkdocs build --strict`, which does NOT enforce markdownlint
    56	# style). agent-lint-docs.sh lints docs/** with the same .markdownlint.jsonc rules via
    57	# an out-of-tree copy (so the ignore does not apply). It self-skips if the binary is
    58	# absent, so run it unconditionally.
    59	run_capped lint-md-docs "$SCRIPT_DIR/agent-lint-docs.sh"
    60	
    61	# NOTE: prettier --check was REMOVED from the markdown gate (0.8.9.1, HITL 2026-06-28).
    62	# prettier's markdown formatter is non-configurable for emphasis style and its *->_ reflow
    63	# CORRUPTS multi-line / nested / adjacent-to-`code` emphasis spans (broken spans, snake_case
    64	# `_` loss, word-joins that change tokenization). markdownlint-cli2 (AST/token-aware) above is
    65	# the sole structural formatter; it does not have this failure mode. Neutrality of any future
    66	# bulk markdown reformat is verified out-of-band by dev/tools/md-neutrality-guard (markdown-it-py
    67	# AST visible-text diff), not by re-introducing prettier.
