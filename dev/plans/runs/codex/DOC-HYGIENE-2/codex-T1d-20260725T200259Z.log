     1	#!/usr/bin/env bash
     2	# scripts/lint-plan-anchors.sh — T1d enforcement (DOC-HYGIENE-2): the LINE-ANCHOR BAN.
     3	#
     4	# ---------------------------------------------------------------------------
     5	# WHY (measured, not hypothetical)
     6	# ---------------------------------------------------------------------------
     7	# `dev/plans/plan-0.8.20.md` carried 18 backticked `<name>:<line>` pointers. The
     8	# TC-45 pair (`engine:14867` / `engine:14890`) was ~2,100 lines off — the real
     9	# call sites were at 16963 / 16986 — and `git log` shows the anchors were
    10	# authored AFTER the merge they claimed to describe, so they were never correct,
    11	# not merely stale. A line number is a pointer with no referential integrity: it
    12	# rots on the very next commit that touches the file, silently, and nothing in
    13	# the repo notices. A symbol name does not rot, and — crucially — it can be
    14	# mechanically checked.
    15	#
    16	# Same class the master's own §6 findings keep re-discovering, and the same
    17	# remedy the standing rule prescribes: fix the tooling so it cannot recur for
    18	# anyone, rather than writing a "be careful with line numbers" note.
    19	#
    20	# ---------------------------------------------------------------------------
    21	# WHAT IT ENFORCES (two rules + one guard)
    22	# ---------------------------------------------------------------------------
    23	# RULE 1 — BARE LINE-ANCHOR BAN.
    24	#   A backticked token whose ENTIRE content is `<name>:<3-or-more digits>`
    25	#   (optionally a range, `lib.rs:876-887`, or an open end, `engine:12166+`) is a
    26	#   bare line anchor and is BANNED inside an ACTIVE plan.
    27	#
    28	#   The rule is a SHAPE, not a whitelist of known crate prefixes. An enumerated
    29	#   prefix list (engine|py|napi|schema|cli|…) is defeated by the very next name
    30	#   anyone invents — `fathomdb-cli:389` already escapes every enumeration that
    31	#   would plausibly have been written — so `<name>` here is any identifier-ish
    32	#   token: letters, digits, `_`, `.`, `-`, `+`.
    33	#
    34	#   Anchoring on the WHOLE backtick group is deliberate. It means the rule fires
    35	#   only on a token that is NOTHING BUT a name and a line number — i.e. a pure
    36	#   pointer — and never on prose or code that merely happens to contain a colon
    37	#   (`derive_logical_id = SHA256("{kind}:{name}")`, `bm25(idx, 1.0, 3.0)`).
    38	#
    39	#   Three digits is the floor because two-digit `:NN` suffixes are overwhelmingly
    40	#   section/clause references in this corpus (`§2:98`), not line numbers.
    41	#   KNOWN GAP, deliberately left open for a follow-on tranche: this shape does
    42	#   NOT catch (a) prefixless anchors `` `:6229` ``, (b) slashed paths
    43	#   `` `dev/acceptance.md:1147` ``, (c) spaced forms `` `engine lib.rs:6479` ``,
    44	#   or (d) sub-100 line numbers. Widening to any of those is a one-line change
    45	#   to ANCHOR_RE below, but it turns ~90 further sites red across the ACTIVE
    46	#   set and so needs its own conversion budget.
    47	#
    48	# RULE 2 — MANDATORY SYMBOL-EXISTENCE CHECK.
    49	#   This is the crux. A gate that merely swaps an unverified NUMBER for an
    50	#   unverified SYMBOL reproduces the exact failure mode above with better
    51	#   cosmetics — it launders a bad pointer as a good one — and is therefore worse
    52	#   than no gate at all. So every citation an ACTIVE plan makes is verified
    53	#   against the file it names.
    54	#
    55	#   THE CITATION FORM (precise, and the only form this lint vouches for):
    56	#
    57	#       `<needle>` in `<path>`
    58	#       `<needle>` / `<needle>` / … in `<path>`     (a `/`-separated chain)
    59	#
    60	#   * `<path>` must be file-path-shaped: `name.ext`, optionally slashed. It is
    61	#     resolved against the worktree — exactly, or by UNIQUE suffix match (plans
    62	#     write `fathomdb-engine/src/lib.rs`; the file lives at
    63	#     `src/rust/crates/fathomdb-engine/src/lib.rs`). Unresolvable => FAIL.
    64	#     Resolving to MORE THAN ONE file => FAIL as ambiguous: a citation nobody
    65	#     can resolve deterministically is not a citation. (This is why a bare
    66	#     `README.md` is rejected — cite the full path.)
    67	#   * `<needle>` is verified by LITERAL substring match (`grep -F`) in the
    68	#     resolved file. It is not required to be a Rust identifier: a quoted DDL
    69	#     fragment, a YAML job key or a heading phrase all work, which is what makes
    70	#     the form usable for the non-Rust targets ACTIVE plans cite
    71	#     (`.github/workflows/release.yml`, design `README.md`s).
    72	#   * A needle containing an ELISION PLACEHOLDER (`…` or `...`) cannot be
    73	#     matched literally. Rather than SKIP it — which would silently reintroduce
    74	#     the unverified-pointer class this gate exists to close — the lint FAILS
    75	#     and says the citation is unverifiable. Rewrite it to something greppable.
    76	#
    77	#   Prose is deliberately unconstrained: only the `` `x` in `y.ext` `` shape is
    78	#   read as a citation. `the … arm in `foo.rs`` or `Detail in `plan-0.8.8.md``
    79	#   are prose and are not checked — the lint is permissive about surrounding
    80	#   text and strict about the parts it verifies.
    81	#
    82	#   The extractor is WRAP-AWARE: a citation may straddle ONE line break, with an
    83	#   optional `>` blockquote marker on the continuation line. This is not a
    84	#   nicety. A first, line-based implementation of this lint silently missed four
    85	#   real citations in the ACTIVE set that markdown soft-wrap had split across
    86	#   lines (plan-0.8.20.md 150/151, 466/467, 704/705, and the `search_index_v2`
    87	#   DDL citation in the master). A checker that a line break can defeat is a
    88	#   checker whose green means nothing — the same vacuous-pass class as TC-37,
    89	#   just at a different granularity. Two line breaks or a blank line ends a
    90	#   citation: that is a paragraph boundary, not a wrap.
    91	#
    92	# VACUOUS-PASS GUARD (TC-37 — this repo's named failure class: a gate that
    93	# reports green without having run). If the scan discovers ZERO ACTIVE plans,
    94	# or verifies ZERO citations, the checking loops never execute and this script
    95	# would exit 0 having vouched for nothing. Both are HARD failures.
    96	#
    97	# ---------------------------------------------------------------------------
    98	# SCOPE
    99	# ---------------------------------------------------------------------------
   100	# `dev/plans/*.md` (TOP LEVEL) whose YAML frontmatter says `status: ACTIVE`.
   101	# Derived from frontmatter, never from a filename list.
   102	#
   103	# Everything else is out of scope BY CONSTRUCTION, not by exception:
   104	#   - a plan that is COMPLETE/SUPERSEDED/PROPOSED/UNKNOWN is a historical record;
   105	#     rewriting its anchors would be falsifying the record;
   106	#   - `dev/plans/runs/**` (slice logs, status boards, closure JSON) and
   107	#     `dev/plans/prompts/**` (one-shot execution prompts) are immutable run
   108	#     artifacts — the top-level glob excludes them structurally;
   109	#   - `dev/archive/**` is frozen and is not under `dev/plans/` at all.
   110	# Same scope split as scripts/lint-plans-status.sh; see dev/plans/README.md.
   111	#
   112	# Usage:  scripts/lint-plan-anchors.sh [--quiet]
   113	# Exit:   0 = every ACTIVE plan is anchor-free AND every citation it makes
   114	#             resolves and exists (and >=1 plan and >=1 citation were seen);
   115	#         1 = a violation, or a vacuous scan.
   116	set -euo pipefail
   117	cd "$(git rev-parse --show-toplevel)"
   118	
   119	QUIET=0
   120	[ "${1:-}" = "--quiet" ] && QUIET=1
   121	
   122	# RULE 1 shape. Widen HERE (single source) if the known gaps above get budget.
   123	ANCHOR_RE='`[A-Za-z_][A-Za-z0-9_.+-]*:[0-9]{3,}(-[0-9]+)?\+?`'
   124	
   125	# `perl` carries the wrap-aware citation extraction (it needs whole-file regex
   126	# with match offsets, which line-oriented grep/awk cannot do). If it is absent
   127	# the lint cannot run — and a gate that cannot run must fail loudly, never skip
   128	# (TC-37).
   129	if ! command -v perl >/dev/null 2>&1; then
   130	  echo "FAIL lint-plan-anchors: perl not found; the wrap-aware citation extractor" >&2
   131	  echo "  cannot run. A gate that cannot run must not report a pass (TC-37)." >&2
   132	  exit 1
   133	fi
   134	
   135	# Emit one `<line-number><TAB><whitespace-normalised citation>` record per
   136	# citation found in $1. `WS` permits at most ONE newline (plus an optional `>`
   137	# blockquote continuation marker), so soft-wrapped citations are found while a
   138	# blank line still terminates the match.
   139	extract_citations() {
   140	  perl -0777 -ne '
   141	    my $WS   = qr/(?:[ \t]*\n[ \t]*>?[ \t]*|[ \t]+)/;
   142	    my $TICK = qr/`[^`\n]+`/;
   143	    my $CIT  = qr/(?:$TICK$WS?\/$WS?)*$TICK${WS}in${WS}`[A-Za-z0-9._\/-]+\.[A-Za-z0-9]+`/;
   144	    while (/($CIT)/g) {
   145	      my $m = $1;
   146	      my $ln = (substr($_, 0, $-[0]) =~ tr/\n//) + 1;
   147	      $m =~ s/[ \t]*\n[ \t]*>?[ \t]*/ /g;
   148	      print "$ln\t$m\n";
   149	    }
   150	  ' "$1"
   151	}
   152	
   153	FAIL=0
   154	PLANS=()
   155	ANCHORS=0
   156	CITATIONS=0
   157	
   158	note() { [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"; }
   159	
   160	# --- discover ACTIVE plans from frontmatter -------------------------------
   161	shopt -s nullglob
   162	for f in dev/plans/*.md; do
   163	  [ "$(head -n1 "$f")" = "---" ] || continue
   164	  status="$(awk 'NR==1{next} /^---$/{exit} /^status:[[:space:]]*/{sub(/^status:[[:space:]]*/,""); sub(/[[:space:]]+$/,""); print; exit}' "$f")"
   165	  [ "$status" = "ACTIVE" ] && PLANS+=("$f")
   166	done
   167	shopt -u nullglob
   168	
   169	# --- worktree file index, for citation path resolution --------------------
   170	INDEX="$(mktemp)"
   171	trap 'rm -f "$INDEX"' EXIT
   172	find . \( -name .git -o -name node_modules -o -name target -o -name .venv \) -prune \
   173	  -o -type f -print 2>/dev/null | sed 's|^\./||' | sort >"$INDEX"
   174	
   175	# Resolve a cited path to exactly one worktree file.
   176	# Prints the resolved path on success; prints nothing and returns
   177	# 1 = no match, 2 = ambiguous.
   178	resolve_path() {
   179	  local want="$1" hits
   180	  if [ -f "$want" ]; then printf '%s\n' "$want"; return 0; fi
   181	  hits="$(grep -F -x -e "$want" "$INDEX" || true)"
   182	  [ -n "$hits" ] || hits="$(grep -E "(^|/)$(sed -E 's/[][\.^$*+?(){}|/]/\\&/g' <<<"$want")\$" "$INDEX" || true)"
