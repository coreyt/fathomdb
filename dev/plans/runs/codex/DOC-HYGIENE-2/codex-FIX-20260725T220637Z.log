   699	def verify(m, release, slice_no):
   700	    """CHECK 1 + CHECK 2 + the TC-37 guard. Returns (paths, anchors) verified."""
   701	    problems = list(m.problems)
   702	    paths_ok = 0
   703	    anchors_ok = 0
   704	    seen = set()
   705	    for path, needle, label in m.cites:
   706	        exists = os.path.exists(path)   # MUTATION POINT (see the test suite)
   707	        if not exists:
   708	            problems.append(
   709	                "FAIL commission-manifest: cited path `%s` does NOT exist in the worktree\n"
   710	                "  (citation role: %s). The file was renamed, moved or deleted; a brief built\n"
   711	                "  on it would send an agent to a dead path." % (path, label or "unlabelled"))
   712	            continue
   713	        if path not in seen:
   714	            seen.add(path)
   715	            paths_ok += 1
   716	        if needle is not None:
   717	            if os.path.isdir(path):
   718	                problems.append(
   719	                    "FAIL commission-manifest: `%s` is a directory but the citation names the\n"
   720	                    "  symbol `%s` (role: %s)." % (path, needle, label))
   721	                continue
   722	            if needle not in read(path):
   723	                problems.append(
   724	                    "FAIL commission-manifest: cited symbol `%s`\n"
   725	                    "  does NOT occur in `%s` (role: %s). The heading or symbol was renamed —\n"
   726	                    "  an unverified pointer must never be laundered as a verified one."
   727	                    % (needle, path, label))
   728	                continue
   729	            anchors_ok += 1
   730	
   731	    body = "\n".join(m.lines)
   732	    hit = LINE_ANCHOR_RE.search(body)
   733	    if hit:
   734	        problems.append(
   735	            "FAIL commission-manifest: the manifest emitted a bare line anchor %s.\n"
   736	            "  `<name>:<line>` pointers are banned (T1d): emit a greppable section anchor."
   737	            % hit.group(0))
   738	
   739	    if not m.cites:
   740	        problems.append(
   741	            "FAIL commission-manifest: ZERO citations emitted for %s Slice %s.\n"
   742	            "  An empty manifest briefs nobody while looking green — the TC-37 vacuous-pass\n"
   743	            "  class. This is a hard failure, never an exit 0." % (release, slice_no))
   744	    if paths_ok == 0 and not problems:
   745	        problems.append(
   746	            "FAIL commission-manifest: ZERO paths verified for %s Slice %s (TC-37)."
   747	            % (release, slice_no))
   748	    return paths_ok, anchors_ok, problems
