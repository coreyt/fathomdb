   261	             "  for nothing (TC-37). Either the state files moved or this is not the repo."])
   262	    if not os.path.isfile(path):
   263	        die(["FAIL commission-manifest: unknown release '%s' — no release-state file at" % release,
   264	             "  `%s`. Releases that DO have one: %s." % (path, ", ".join(known)),
   265	             "  The state file is the single writer (T2a); a manifest is not generated",
   266	             "  from prose."])
   267	    try:
   268	        return path, json.loads(read(path))
