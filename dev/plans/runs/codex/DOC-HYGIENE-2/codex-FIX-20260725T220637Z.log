   208	class Manifest:
   209	    """Accumulates the emitted lines AND the citations they make, so the
   210	    existence checks run over exactly what the brief says — not a parallel list
   211	    that could drift from it."""
   212	
   213	    def __init__(self):
   214	        self.lines = []
   215	        self.cites = []      # (path, needle|None, label)
   216	        self.problems = []
   217	
   218	    def out(self, text=""):
   219	        self.lines.append(text)
   220	
   221	    def cite(self, path, needle=None, label=""):
   222	        self.cites.append((path, needle, label))
   223	        if needle is not None:
   224	            return "`%s` in `%s`" % (needle, path)
   225	        return "`%s`" % path
   226	
   227	    def anchor(self, path, keywords, role, required=True):
   228	        """Resolve a section anchor by ROLE keyword against the file's own
   229	        headings. Never a line number (T1d RULE 1); always verified (RULE 2)."""
   230	        try:
   231	            text = read(path)
   232	        except OSError:
   233	            self.problems.append(
   234	                "FAIL commission-manifest: cannot read `%s` while resolving the %s anchor."
   235	                % (path, role))
   236	            self.cites.append((path, None, role))
   237	            return None
   238	        for ln in text.split("\n"):
   239	            if not ln.startswith("#"):
   240	                continue
   241	            low = ln.lower()
   242	            if all(k in low for k in keywords):
   243	                return self.cite(path, ln.strip(), role)
   244	        if required:
   245	            self.problems.append(
   246	                "FAIL commission-manifest: `%s` has no heading matching %s (role %s).\n"
   247	                "  The section was renamed or removed, so the brief would cite a heading\n"
   248	                "  that no longer exists. Re-point the role or restore the heading."
   249	                % (path, " + ".join("'%s'" % k for k in keywords), role))
   250	        return None
