   185	def frontmatter_status(path):
   186	    """Parse `status:` exactly as scripts/lint-design-status.sh does."""
   187	    try:
   188	        text = read(path)
   189	    except OSError:
   190	        return None
   191	    lines = text.split("\n")
   192	    if not lines or lines[0].strip() != "---":
   193	        return None
   194	    block = []
   195	    for ln in lines[1:]:
   196	        if ln.rstrip() == "---":
   197	            break
   198	        block.append(ln)
   199	    else:
   200	        return None
   201	    for ln in block:
   202	        m = re.match(r"^status:\s*(.*?)\s*$", ln)
   203	        if m and m.group(1):
   204	            return m.group(1)
   205	    return None
