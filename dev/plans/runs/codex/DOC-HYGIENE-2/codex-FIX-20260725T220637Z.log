   295	def slice_tokens(entry):
   296	    """Derive the search tokens for the design tier from T2a's OWN fields, so the
   297	    required-reading list follows the state file rather than a hardcoded map.
   298	    Shapes only — snake_case identifiers and the repo's structured ids."""
   299	    blob = "%s %s" % (entry.get("short") or "", entry.get("title") or "")
   300	    pats = [
   301	        r"\b[a-z][a-z0-9]*(?:_[a-z0-9]+)+\b",   # dense_readiness, flush_embeddings
   302	        r"\bTC-[0-9]+\b",                        # carry/todo ids
   303	        r"\bR-[0-9]+-[A-Za-z0-9]+\b",            # requirement ids: R-20-DR
   304	        r"\bC-[0-9]+\b",                         # contract ids
   305	        r"\bAC-[0-9]+\b",
   306	        r"\bRUBRIC-[A-Za-z0-9]+\b",
   307	        r"\b[A-Z]{2,}-[0-9]+\b",                 # OPP-12, EXP-…
   308	    ]
   309	    tokens = []
   310	    for pat in pats:
   311	        for tok in re.findall(pat, blob):
   312	            if tok not in tokens:
   313	                tokens.append(tok)
   314	    return tokens
