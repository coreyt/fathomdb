   689	def schema_src_path(state):
   690	    """The state file states the SCHEMA source as prose ('pub const X in <path>');
   691	    take the path out of it rather than hardcoding a second copy."""
   692	    src = state.get("schema_version_source") or ""
   693	    for tok in src.split():
   694	        if "/" in tok:
   695	            return tok
   696	    return "src/rust/crates/fathomdb-schema/src/lib.rs"
