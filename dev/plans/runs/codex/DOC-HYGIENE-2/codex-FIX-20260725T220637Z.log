   316	
   317	def scan_design(tokens, release, slice_no):
   318	    # Second selector, alongside the token scan: a doc whose FILENAME names this
   319	    # release AND this slice is that slice's own design memo (SLICE-TEMPLATE §3.0
   320	    # writes one per slice). The release is required in the name precisely
   321	    # because `dev/design/slice-30-design.md` is 0.8.0's — pulling it into a
   322	    # 0.8.20 Slice-30 brief would be a wrong citation that still resolves.
   323	    name_re = re.compile(r"slice[-_ ]?0*%d(?![0-9])" % slice_no, re.I)
   324	    hits = []
   325	    for root, dirs, files in os.walk(DESIGN_ROOT):
   326	        dirs.sort()
   327	        for name in sorted(files):
   328	            if not name.endswith(".md"):
   329	                continue
   330	            path = os.path.join(root, name)
   331	            try:
   332	                text = read(path)
   333	            except OSError:
   334	                continue
   335	            matched = [t for t in tokens if t in text]
   336	            if release in name and name_re.search(name):
   337	                matched.append("filename: %s slice %s" % (release, slice_no))
   338	            if not matched:
   339	                continue
   340	            status = frontmatter_status(path) or "(no status:)"
   341	            hits.append((STATUS_RANK.get(status.split()[0], 7), path, status, matched))
   342	    hits.sort(key=lambda h: (h[0], h[1]))
   343	    return hits
