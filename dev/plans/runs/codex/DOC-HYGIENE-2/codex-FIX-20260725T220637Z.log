   437	def build(release, state_path, state, slice_no, entry):
   438	    m = Manifest()
   439	    ladder = {e.get("slice"): e for e in state.get("ladder") or []}
   440	    landed = state.get("landed") or []
   441	    next_slice = state.get("next_slice")
   442	    plan = state.get("plan") or ""
   443	    board = state.get("board") or ""
   444	    master = state.get("master") or ""
   445	
   446	    tokens = slice_tokens(entry)
   447	    design = scan_design(tokens, release, slice_no)
   448	
   449	    # ---- 1. ASSIGNMENT (LBO "Assignment"; SLICE-TEMPLATE heading + §2) -----
   450	    m.out("=" * 100)
   451	    m.out("COMMISSION MANIFEST — %s Slice %s (%s)" % (release, slice_no, entry.get("short") or "?"))
   452	    m.out("=" * 100)
   453	    m.out("GENERATED, READ-ONLY. It CITES sources of record; it restates no ruling and decides")
   454	    m.out("nothing. Facts come from the single-writer state file %s" % m.cite(state_path))
   455	    m.out("(T2a) and from `status:` frontmatter under `%s/` (T2c). Section set derived from" % DESIGN_ROOT)
   456	    m.out("%s" % m.cite(LBO_TEMPLATE))
   457	    m.out("and %s — this REPLACES those as the brief" % m.cite(SLICE_TEMPLATE))
   458	    m.out("assembly step; it does not add a third template to maintain.")
   459	    m.out()
   460	    m.out("## 1. ASSIGNMENT   [LBO 'Assignment (filled by LBS)'; SLICE-TEMPLATE title line + §2]")
   461	    m.out("  release          %s (%s)" % (release, state.get("release_kind") or "kind not stated"))
   462	    m.out("  slice            %s — %s" % (slice_no, entry.get("title") or "(no title)"))
   463	    m.out("  requirement id   %s" % (entry.get("short") or "(none)"))
   464	    m.out("  ladder status    %s" % (entry.get("status") or "?"))
   465	    m.out("  depends on       %s" % (", ".join(
   466	        "Slice %s [%s%s]" % (d, (ladder.get(d) or {}).get("status", "UNKNOWN"),
   467	                             ", %s" % (ladder.get(d) or {}).get("sha")
   468	                             if (ladder.get(d) or {}).get("sha") else "")
   469	        for d in (entry.get("depends_on") or [])) or "— (none)"))
   470	    if next_slice == slice_no:
   471	        m.out("  sequencing       ✅ this IS the next slice per the state file")
   472	    else:
   473	        m.out("  sequencing       ⚠ this is NOT the next slice — the state file says next = %s"
   474	              % next_slice)
   475	    m.out("  plan             %s" % m.cite(plan))
   476	    m.out("  board of record  %s" % m.cite(board))
   477	    m.out("  master           %s" % m.cite(master))
   478	    m.out("  codex §9         transcripts go under %s, release-namespaced (TC-RUBRIC-7)"
   479	          % m.cite(CODEX_DIR))
   480	    m.out()
   481	
   482	    # ---- 2. BASE SHA (LBO "Branch from tip"; SLICE-TEMPLATE §0) ------------
   483	    # The base is the TARGET SLICE'S PREDECESSOR: the greatest LANDED slice
   484	    # STRICTLY BELOW slice_no. It is NOT max(landed). For any slice that is not
   485	    # the next one — a historical regeneration, an out-of-order brief — max()
   486	    # can select the target's OWN landing merge or a later one, i.e. tell an
   487	    # operator to branch from the very work they are being commissioned to do.
   488	    # A wrong branch point is this repo's named agent-worktree-stale-base trap
   489	    # (it has already cost two slices), and a confidently printed wrong SHA is
   490	    # exactly what defeats the human sanity check, so this is computed
   491	    # relative to the target and never to the tip of `landed`.
   492	    #
   493	    # `depends_on` is deliberately NOT the base. Dependencies state the MINIMUM
   494	    # ancestry a slice needs; branching from that minimum would silently drop
   495	    # every slice landed since — the same stale-base trap from the other side.
   496	    # The predecessor is the ancestry-maximal choice that still excludes the
   497	    # target itself, so dependencies are CROSS-CHECKED against it instead.
   498	    m.out("## 2. BASE SHA + BRANCH POINT   [LBO 'Branch from tip'; SLICE-TEMPLATE §0]")
   499	    landed_nums = sorted({s for s in landed if isinstance(s, int)})
   500	    prior_landed = [s for s in landed_nums if s < slice_no]
   501	    later_landed = [s for s in landed_nums if s > slice_no]
   502	    base_slice = max(prior_landed) if prior_landed else None
   503	    base_sha = (ladder.get(base_slice) or {}).get("sha") if base_slice is not None else None
   504	    if slice_no in landed_nums:
   505	        m.out("  ⚠ HISTORICAL     Slice %s is ITSELF LANDED (%s), so this is a regeneration:"
   506	              % (slice_no, (ladder.get(slice_no) or {}).get("sha") or "no sha recorded"))
   507	        m.out("                   the base below is that slice's PREDECESSOR, never its own merge.")
   508	    if base_sha:
   509	        m.out("  base sha         %s  (Slice %s — the newest LANDED slice STRICTLY BEFORE Slice %s)"
   510	              % (base_sha, base_slice, slice_no))
   511	    elif base_slice is not None:
   512	        m.out("  base sha         (Slice %s is the predecessor but records NO landing sha)"
   513	              % base_slice)
