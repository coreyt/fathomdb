452-# --- Arm 2b: .git/index IS BYTE-UNCHANGED, EVEN WITH A STALE STAT CACHE ------
453-# Arm 2's tree_snapshot PRUNES */.git, so it could never see this: `git status`
454-# refreshes a stale stat cache and REWRITES .git/index under .git/index.lock.
455-# That is a repo-metadata write by a script whose stated contract is that it
456-# writes nothing at all, and it can race a concurrent git command for the lock.
457-#
458-# Staling technique: rewrite every tracked file's mtime to a FIXED PAST instant.
459-# A fixed timestamp (rather than `touch` + sleep) puts the mtime well outside
460-# git's racily-clean one-second window with no wall-clock cost, so every cache
461-# entry is unambiguously stat-dirty.
462-#
463-# NON-VACUITY, and the RED witness carried inside the suite: a fixture where git
464-# had nothing to refresh would green this arm no matter what the briefing does.
465-# So the same staled fixture is COPIED (cp -a preserves the mtimes, so the copy
466-# is staled identically) and probed with a PLAIN, lock-taking `git status` — the
467-# exact call the briefing used to make. That copy's index MUST change. Only then
468-# does "the briefing left the index alone" mean anything.
469:setup_fixture
470-find "$FIX" -path '*/.git' -prune -o -type f -print0 \
471-  | xargs -0 touch -d '2026-01-01 00:00:00'
472-
473-WITNESS="$TMPROOT/parent/witness"
474-cp -a "$FIX" "$WITNESS"
475-WITNESS_BEFORE="$(sha256sum "$WITNESS/.git/index" | cut -d' ' -f1)"
476-git -C "$WITNESS" status --porcelain --untracked-files=all >/dev/null 2>&1 || true
477-WITNESS_AFTER="$(sha256sum "$WITNESS/.git/index" | cut -d' ' -f1)"
478-if [ "$WITNESS_BEFORE" != "$WITNESS_AFTER" ]; then
479-  pass "arm 2b witness: the stat cache really is stale — a plain \`git status\` rewrites .git/index"
480-else
481-  fail "arm 2b fixture invalid: a plain lock-taking \`git status\` did NOT rewrite .git/index, so this arm proves nothing"
482-fi
483-rm -rf "$WITNESS"
484-
485-INDEX_BEFORE="$(sha256sum "$FIX/.git/index" | cut -d' ' -f1)"
486-INDEX_META_BEFORE="$(stat -c '%s %.9Y' "$FIX/.git/index")"
487-run_orient "$FIX"
488-INDEX_AFTER="$(sha256sum "$FIX/.git/index" | cut -d' ' -f1)"
489-INDEX_META_AFTER="$(stat -c '%s %.9Y' "$FIX/.git/index")"
490-# Guarded on the run having HAPPENED: a briefing that cannot start also writes
491-# no index, and must not be able to green this.
492-if [ "$RC" -eq 0 ] && [ -n "$OUT" ]; then
493-  pass "arm 2b precondition: the briefing still completes on a stat-stale checkout (rc=0)"
494-else
495-  fail "arm 2b precondition: the briefing did not run (rc=$RC, $BYTES bytes) — the index assertion would be vacuous; err=$ERR"
496-fi
497-if [ "$INDEX_BEFORE" = "$INDEX_AFTER" ]; then
498-  pass "writes no file — .git/index is BYTE-IDENTICAL across a run with a deliberately staled stat cache"
499-else
500-  fail "arm 2b: the briefing REWROTE .git/index ($INDEX_BEFORE -> $INDEX_AFTER) — it must run git with optional locks disabled"
501-fi
502-if [ "$INDEX_META_BEFORE" = "$INDEX_META_AFTER" ]; then
503-  pass "writes no file — .git/index size+mtime are unchanged too (NANOSECOND mtime: it was not even reopened)"
504-else
505-  fail "arm 2b: .git/index metadata moved ($INDEX_META_BEFORE -> $INDEX_META_AFTER)"
506-fi
507-if [ ! -e "$FIX/.git/index.lock" ]; then
508-  pass "writes no file — no .git/index.lock is left behind"
509-else
510-  fail "arm 2b: the briefing left a .git/index.lock behind"
511-fi
512-
513-# --- Arm 2c: a HELD index lock does not perturb the briefing ----------------
514-# HONEST SCOPE: measured on git 2.43, a plain `git status` tolerates a held
515-# optional lock (it declines to write and still exits 0), so this arm is NOT a
516-# RED witness for the fix — it is a forward guard. It is worth its cost because
517-# the briefing runs under `set -euo pipefail`, where any future git probe that
518-# DOES insist on the lock (or a git version that starts erroring) would abort the
519-# whole cold-start briefing rather than degrade. With optional locks disabled the
520-# lock is never contended for at all.
521:setup_fixture
522-find "$FIX" -path '*/.git' -prune -o -type f -print0 \
523-  | xargs -0 touch -d '2026-01-01 00:00:00'
524-: >"$FIX/.git/index.lock"
525-LOCKED_INDEX_BEFORE="$(sha256sum "$FIX/.git/index" | cut -d' ' -f1)"
526-run_orient "$FIX"
527-LOCKED_INDEX_AFTER="$(sha256sum "$FIX/.git/index" | cut -d' ' -f1)"
528-if [ "$RC" -eq 0 ] && [ -n "$OUT" ]; then
529-  pass "a concurrently HELD .git/index.lock does not abort the briefing (rc=0)"
530-else
531-  fail "arm 2c: a held index lock broke the briefing (rc=$RC); err=$ERR"
532-fi
533-if [ "$LOCKED_INDEX_BEFORE" = "$LOCKED_INDEX_AFTER" ]; then
534-  pass "a held index lock run still leaves .git/index byte-identical"
535-else
536-  fail "arm 2c: .git/index changed while its lock was held by another process"
537-fi
538-if [ -e "$FIX/.git/index.lock" ]; then
539-  pass "the other process's .git/index.lock is still there — the briefing never touched it"
540-else
541-  fail "arm 2c: the briefing REMOVED another process's .git/index.lock"
542-fi
543-rm -f "$FIX/.git/index.lock"
544-
545-# --- Arm 2d: structural — EVERY git probe disables optional locks -----------
546-# Behavioural arm 2b only covers the git calls on the paths it exercises. This
547-# arm is the drift guard: a new `$(git ...)` added later without the flag would
548-# silently reintroduce the index write. Counts every command substitution /
549-# process substitution that starts a git command and requires all of them to
550-# carry --no-optional-locks, plus the exported env var that covers git run by
551-# CHILD processes (gh, python3).
552-GIT_CALLS_ALL="$(grep -coE '(\$\(|<\()git ' "$GATE" || true)"
553-GIT_CALLS_SAFE="$(grep -coE '(\$\(|<\()git --no-optional-locks ' "$GATE" || true)"
554-if [ "$GIT_CALLS_ALL" -ge 8 ]; then
555-  pass "arm 2d precondition: the briefing really does shell out to git ($GIT_CALLS_ALL call sites)"
556-else
557-  fail "arm 2d precondition: found only $GIT_CALLS_ALL git call sites — the count regex has drifted, so this arm proves nothing"
558-fi
559-if [ "$GIT_CALLS_ALL" -eq "$GIT_CALLS_SAFE" ]; then
560-  pass "every git call site ($GIT_CALLS_SAFE/$GIT_CALLS_ALL) passes --no-optional-locks"
561-else
562-  fail "arm 2d: $((GIT_CALLS_ALL - GIT_CALLS_SAFE)) git call site(s) can still take .git/index.lock: $(grep -nE '(\$\(|<\()git ' "$GATE" | grep -v -- '--no-optional-locks')"
563-fi
564-if grep -qE '^export GIT_OPTIONAL_LOCKS=0$' "$GATE"; then
565-  pass "GIT_OPTIONAL_LOCKS=0 is exported, so git in CHILD processes (gh, python3) cannot lock either"
566-else
567-  fail "arm 2d: the briefing must export GIT_OPTIONAL_LOCKS=0"
568-fi
