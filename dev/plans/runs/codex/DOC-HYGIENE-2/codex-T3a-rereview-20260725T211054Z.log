172-# Runs the briefing with cwd inside $1. stdout and stderr are captured
173-# SEPARATELY so the byte cap is measured on the payload alone. TMPDIR is
174-# redirected to a per-run sandbox so "writes no file" can be asserted.
175-run_orient() {
176-  local dir="$1"
177-  local sandbox="$TMPROOT/sandbox"
178-  rm -rf "$sandbox"
179-  mkdir -p "$sandbox"
180-  set +e
181-  (cd "$dir" && TMPDIR="$sandbox" bash "$GATE") \
182-    >"$TMPROOT/out.txt" 2>"$TMPROOT/err.txt"
183-  RC=$?
184-  set -e
185-  OUT="$(cat "$TMPROOT/out.txt")"
186-  ERR="$(cat "$TMPROOT/err.txt")"
187-  BYTES="$(wc -c <"$TMPROOT/out.txt" | tr -d ' ')"
188-  SANDBOX_RESIDUE="$(find "$sandbox" -mindepth 1 | head -5)"
189-}
