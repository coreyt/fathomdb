+            "mode": "project",
+            "projection": "rulings",
+            "entries": entries,
+            "items": len(rows),
+            "ruled": counts["ruled"],
+            "unruled": counts["unruled"],
+            "unclassified": counts["unclassified"],
+            "malformed": malformed,
+            "keyed_by_seq": keyed_by_seq,
+            "rows": rows,
+        }
+        out.write(json.dumps(envelope) + "\n")
+    else:
+        for row in rows:
