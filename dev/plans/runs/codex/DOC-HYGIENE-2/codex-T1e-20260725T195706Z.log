   136	# REQ-054 / AC-041: the recovery denylist is FIVE names. Hardcoded here on
   137	# purpose — checked against both the file and the pin, so a re-pin cannot widen
   138	# it. See the "recovery denylist is five names" rule.
   139	REQ_054 = ["recover", "restore", "repair", "fix", "rebuild"]
   140	
   141	LIST_KEYS = ["allowlist", "core", "recovery_denylist"]
   142	CAP = 8  # cap on enumerated member names per difference line
