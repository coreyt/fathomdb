name: CI

on:
  push:
    branches:
      - main
  pull_request:

# H-4 (pre-0.6.0 security fix): scope workflow permissions to least privilege.
# Default GITHUB_TOKEN has broader access that a compromised third-party action
# could exploit.
permissions:
  contents: read

jobs:
  # Docs-only fast-path detector. Computes whether the diff touches ANY
  # non-markdown file. A markdown/docs-only change then runs ONLY the lightweight
  # `markdownlint` job (plus the always-on `docs` mkdocs gate) and skips the heavy
  # verify / security / embedder / cross-OS / wheel jobs — so a trivial docs edit
  # no longer burns the full matrix (and a single md finding no longer reds main
  # via the heavy gate). The md gate itself is PRESERVED on the fast path; this is
  # not a `paths-ignore` drop. paths-filter handles base-ref resolution for both
  # push (before SHA) and pull_request (base branch).
  changes:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      # docs_only = true when NO changed file is outside markdown (i.e. every
      # changed path is *.md). `nonmd` is true when at least one non-md file
      # changed; docs_only is its negation. The bias is safe: a misread can only
      # make heavy jobs RUN on a docs change (slower), never SKIP on a code change.
      docs_only: ${{ steps.filter.outputs.nonmd == 'false' }}
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - uses: dorny/paths-filter@fbd0ab8f3e69293af611ebaee6363fc25e6d187d # v4.0.1
        id: filter
        with:
          filters: |
            nonmd:
              - '!**/*.md'

  # Single agent-loop gate. Mirrors what scripts/agent-verify.sh does locally,
  # so a green CI run = `verify` is green on the same toolchain set.
  verify:
    needs: changes
    if: needs.changes.outputs.docs_only != 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      # H-5 (pre-0.6.0 security fix): pin third-party actions to commit SHAs.
      # 0.8.9 Slice 1: fetch-depth 0 so the AC-050c removal-detect gate can
      # resolve its base ref (v0.6.1 tag); the default shallow checkout has no
      # tags, which made `git diff v0.6.1..HEAD` fail (`bad revision`) once the
      # bootstrap un-mask let agent-security.sh actually reach AC-050c.
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0
      - name: Configure per-session TMPDIR
        shell: bash
        run: |
          # Per-session TMPDIR root so cleanup is one rm -rf at job end (GH #40).
          # Set via $GITHUB_ENV — runner.* context isn't available at job-env level.
          TMPDIR="$RUNNER_TEMP/fathomdb-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$TMPDIR"
          echo "TMPDIR=$TMPDIR" >> "$GITHUB_ENV"
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: "3.12"
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version: "22"
      - uses: dtolnay/rust-toolchain@fa04a1451ff1842e2626ccb99004d0195b455a88 # stable
        with:
          toolchain: stable
          components: rustfmt, clippy
      - uses: Swatinem/rust-cache@c19371144df3bb44fab255c43d04cbc2ab54d1c4 # v2.9.1
      - name: Bootstrap dev tooling
        run: bash scripts/bootstrap.sh
      - name: agent-verify (lint -> typecheck -> test)
        run: bash scripts/agent-verify.sh

  # Gate (n) — agent-security battery (AC-036/037/038/050a/050c).
  #
  # 0.8.0 Slice 40 (Q3/META): the agent-verify job above already runs
  # STRICT=1 agent-security.sh, but on ubuntu-latest (24.04) AppArmor
  # restricts unprivileged user namespaces, so the AC-037 netns-deny-egress
  # fixture cannot actually create its userns there. This dedicated job pins
  # the security battery to ubuntu-22.04, which permits unprivileged userns
  # by default, so AC-037 genuinely exercises (the home of AC-037 per
  # acceptance.md). STRICT=1 promotes any toolchain blocker to a hard
  # failure — a blocker here means AC-037 did NOT run, which must fail the
  # gate rather than pass vacuously.
  security:
    needs: changes
    if: needs.changes.outputs.docs_only != 'true'
    runs-on: ubuntu-22.04
    timeout-minutes: 20
    steps:
      # 0.8.9 Slice 1: fetch-depth 0 so AC-050c removal-detect can resolve its
      # v0.6.1 base tag (see the verify job above for the same rationale).
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0
      - name: Configure per-session TMPDIR
        shell: bash
        run: |
          TMPDIR="$RUNNER_TEMP/fathomdb-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$TMPDIR"
          echo "TMPDIR=$TMPDIR" >> "$GITHUB_ENV"
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: "3.12"
      - uses: dtolnay/rust-toolchain@fa04a1451ff1842e2626ccb99004d0195b455a88 # stable
        with:
          toolchain: stable
      - uses: Swatinem/rust-cache@c19371144df3bb44fab255c43d04cbc2ab54d1c4 # v2.9.1
      - name: Bootstrap dev tooling (installs strace for AC-036/AC-037)
        run: bash scripts/bootstrap.sh
      - name: agent-security (AC-036/037/038/050a/050c)
        run: STRICT=1 bash scripts/agent-security.sh

  # EU-5c — pre-warm the BGE-small embedder weight cache (~133 MB from HF)
  # via actions/cache, then run the network-hitting EU-5b tests against the
  # warm cache. If the warm step fails (e.g. HF unreachable), the env-gate
  # `FATHOMDB_SKIP_NETWORK_TESTS=1` is exported and the gated tests skip
  # cleanly with a log line instead of failing the job. On the happy path
  # the env var stays unset and the tests run normally — fast on warm cache.
  default-embedder-tests:
    needs: changes
    if: needs.changes.outputs.docs_only != 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - name: Configure per-session TMPDIR
        shell: bash
        run: |
          TMPDIR="$RUNNER_TEMP/fathomdb-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$TMPDIR"
          echo "TMPDIR=$TMPDIR" >> "$GITHUB_ENV"
      - uses: dtolnay/rust-toolchain@fa04a1451ff1842e2626ccb99004d0195b455a88 # stable
        with:
          toolchain: stable
      - uses: Swatinem/rust-cache@c19371144df3bb44fab255c43d04cbc2ab54d1c4 # v2.9.1
      # H-5: pin third-party actions to commit SHAs. Cache key is
      # runner.os + model identity + HF revision (see
      # fathomdb-embedder/src/loader.rs::HF_REVISION). Bumping the
      # revision invalidates the cache cleanly.
      - name: Restore BGE embedder weight cache
        id: bge-cache
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/fathomdb/embedders
          key: ${{ runner.os }}-fathomdb-embedder-bge-small-en-v1.5-5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
          # Future revision bumps should still benefit from partial
          # restoration (the loader will sha-verify each file and refetch
          # only mismatched ones). Without this, a SHA bump = 100% cold
          # miss (~133 MB redownload from HF).
          restore-keys: |
            ${{ runner.os }}-fathomdb-embedder-bge-small-en-v1.5-
            ${{ runner.os }}-fathomdb-embedder-
      - name: Warm BGE embedder cache (no-op on cache hit)
        id: warm
        shell: bash
        run: |
          set +e
          # Surface cache-hit outcome as a GitHub Actions notice so it
          # shows up in the run summary without log-diving. A regression
          # that breaks the cache key (silently forcing cold downloads
          # on every run) becomes visible at a glance here.
          echo "::notice title=BGE cache::hit=${{ steps.bge-cache.outputs.cache-hit }}"
          cargo run --quiet -p fathomdb-cli --features default-embedder \
            --bin fathomdb -- doctor warm-cache --json
          rc=$?
          if [ "$rc" -ne 0 ]; then
            echo "warm-cache failed (rc=$rc); will skip network-hitting tests"
            echo "FATHOMDB_SKIP_NETWORK_TESTS=1" >> "$GITHUB_ENV"
          fi
          # Never fail the job on warm-cache failure — the env gate covers it.
          exit 0
      - name: Network-hitting EU-5b tests (engine)
        run: |
          cargo test -p fathomdb-engine --features default-embedder \
            --test eu5b_lockflip
      - name: Network-hitting EU-5b tests (cli warm-cache)
        run: |
          cargo test -p fathomdb-cli --features default-embedder \
            --test cli_warm_cache

  # Platform-sensitive engine code regresses on Windows/macOS often enough
  # that pre-0.6.0 carried these matrix legs. Keep them.
  rust-windows:
    needs: changes
    if: needs.changes.outputs.docs_only != 'true'
    runs-on: windows-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - name: Configure per-session TMPDIR
        shell: bash
        run: |
          # Windows resolves temp dir via TMP/TEMP, not TMPDIR.
          TMP="$RUNNER_TEMP/fathomdb-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$TMP"
          echo "TMP=$TMP" >> "$GITHUB_ENV"
          echo "TEMP=$TMP" >> "$GITHUB_ENV"
      - uses: dtolnay/rust-toolchain@fa04a1451ff1842e2626ccb99004d0195b455a88 # stable
        with:
          toolchain: stable
      - uses: Swatinem/rust-cache@c19371144df3bb44fab255c43d04cbc2ab54d1c4 # v2.9.1
      # 0.8.9 Slice 20 (F-9): --no-fail-fast surfaces the FULL set of Windows test
      # failures in one run rather than stopping at the first. The pyo3 link gate had
      # masked Windows test execution entirely; once it lifted, failures appear one per
      # run with a default (fail-fast) invocation. Enumerate them all so the
      # cross-platform remediation scope is known, not discovered whack-a-mole. (Aligned
      # with 0.8.9's anti-masking mandate — a first failure must not hide the rest.)
      - run: cargo test --workspace --no-fail-fast

  rust-macos:
    needs: changes
    if: needs.changes.outputs.docs_only != 'true'
    runs-on: macos-latest
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - name: Configure per-session TMPDIR
        shell: bash
        run: |
          TMPDIR="$RUNNER_TEMP/fathomdb-${GITHUB_RUN_ID}-${GITHUB_RUN_ATTEMPT}"
          mkdir -p "$TMPDIR"
          echo "TMPDIR=$TMPDIR" >> "$GITHUB_ENV"
      - uses: dtolnay/rust-toolchain@fa04a1451ff1842e2626ccb99004d0195b455a88 # stable
        with:
          toolchain: stable
      - uses: Swatinem/rust-cache@c19371144df3bb44fab255c43d04cbc2ab54d1c4 # v2.9.1
      - run: cargo test --workspace

  # EU-6 FIX-1 / ADR-0.6.0-default-embedder.md EMB-3 — wheel-size gate.
  #
  # Per `dev/design/0.7.1-EU-6-FIX-1-design.md` D2:
  #   * The SHIPPED wheel (with `default-embedder` feature ON, the
  #     surface a `pip install fathomdb` user actually consumes) is the
  #     GATED artifact. Each platform has its own `baseline_bytes`;
  #     regression > 20 MB blocks. This is the canary that matters.
  #   * The NO-FEATURE wheel is built informationally per matrix entry
  #     and recorded in the job summary so accidental dependency creep
  #     on the minimal-deps build path is still visible — but not gated.
  #
  # Matrix covers all 5 release-target platforms emitted by
  # `release.yml`'s build-python job: Linux x86_64, Linux aarch64,
  # macOS x86_64, macOS arm64, Windows x86_64. AC-FIX1-5.
  #
  # Baselines: Linux x86_64 measured on the FIX-1 GREEN commit
  # (with-feature wheel ≈ 6.16 MB; ~20% padding → 7.4 MB). Non-Linux
  # baselines are seeded at conservative numbers derived from the
  # Linux measurement; the first CI run will surface the real per-
  # platform numbers and any baseline that's too low can be bumped
  # within EMB-3's 20 MB regression budget. BASELINES TO RE-CALIBRATE
  # IN FIRST CI RUN — bump in a follow-up commit once the first run
  # emits real `::notice title=wheel-size::` values.
  wheel-size-gate:
    needs: changes
    if: needs.changes.outputs.docs_only != 'true'
    strategy:
      fail-fast: false
      matrix:
        include:
          - runner: ubuntu-latest
            target: x86_64-unknown-linux-gnu
            label: linux-x64
            manylinux: "2_28"
            # Measured on FIX-1 GREEN commit (Linux x86_64, abi3 cp310):
            # no-feature ≈ 3.06 MB, with-feature ≈ 6.16 MB. Baseline
            # = with-feature + ~20% headroom so Cargo.lock churn does
            # not whip the gate; the 20 MB regression budget on top of
            # this absorbs intentional dependency bumps.
            baseline_bytes: 7400000
          - runner: ubuntu-latest
            target: aarch64-unknown-linux-gnu
            label: linux-aarch64
            manylinux: "2_28"
            # Seeded from Linux x86_64 with ~5% padding (aarch64 wheels
            # are typically near-parity, occasionally a hair larger).
            # TO RECALIBRATE.
            baseline_bytes: 7700000
          - runner: macos-latest
            target: x86_64-apple-darwin
            label: darwin-x64
            # Seeded from Linux x86_64 with ~5% padding (Mach-O vs ELF
            # overhead is small at this scale). TO RECALIBRATE.
            baseline_bytes: 7700000
          - runner: macos-latest
            target: aarch64-apple-darwin
            label: darwin-arm64
            # Seeded from Linux x86_64 with ~5% padding. TO RECALIBRATE.
            baseline_bytes: 7700000
          - runner: windows-latest
            target: x86_64-pc-windows-msvc
            label: win32-x64
            # Seeded from Linux x86_64 with ~10% padding (PE/COFF
            # sections + MSVC runtime imports add a small overhead vs
            # ELF). TO RECALIBRATE.
            baseline_bytes: 8000000
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: "3.11"
      - uses: dtolnay/rust-toolchain@fa04a1451ff1842e2626ccb99004d0195b455a88 # stable
        with:
          toolchain: stable
          targets: ${{ matrix.target }}
      - uses: Swatinem/rust-cache@c19371144df3bb44fab255c43d04cbc2ab54d1c4 # v2.9.1
      # Use PyO3/maturin-action (same SHA as release.yml's build-python)
      # so the linux-aarch64 leg gets a working cross-toolchain via the
      # action's container. A bare `maturin build --target
      # aarch64-unknown-linux-gnu` on ubuntu-latest has no aarch64
      # sysroot/linker; the action handles that. This also harmonizes
      # the build path with release.yml.
      #
      # Build the with-feature wheel first — this is the shipped
      # artifact and the GATED build. `--features` REPLACES the
      # pyproject list, so the explicit list here is what gets built
      # regardless of what pyproject.toml carries.
      - name: Build wheel (with default-embedder feature; shipped artifact)
        uses: PyO3/maturin-action@e83996d129638aa358a18fbd1dfb82f0b0fb5d3b # v1.51.0
        with:
          target: ${{ matrix.target }}
          args: --release --out dist-feature -i python3.11 --features pyo3/extension-module,default-embedder
          manylinux: ${{ matrix.manylinux || 'auto' }}
          working-directory: src/python
      # No-feature wheel: informational only. Recorded to detect
      # accidental dependency creep on the minimal-deps tree.
      - name: Build wheel (no default-embedder feature; informational)
        uses: PyO3/maturin-action@e83996d129638aa358a18fbd1dfb82f0b0fb5d3b # v1.51.0
        with:
          target: ${{ matrix.target }}
          args: --release --out dist-nofeature -i python3.11 --features pyo3/extension-module
          manylinux: ${{ matrix.manylinux || 'auto' }}
          working-directory: src/python
      - name: Assert wheel-size gate
        shell: bash
        working-directory: src/python
        run: |
          set -euo pipefail
          BASELINE=${{ matrix.baseline_bytes }}
          BUDGET=$((20 * 1024 * 1024)) # 20 MB, per EMB-3
          FEAT=$(stat -c%s dist-feature/*.whl 2>/dev/null || stat -f%z dist-feature/*.whl)
          NOFEAT=$(stat -c%s dist-nofeature/*.whl 2>/dev/null || stat -f%z dist-nofeature/*.whl)
          DELTA=$(( FEAT - BASELINE ))
          FEATDELTA=$(( FEAT - NOFEAT ))
          echo "::notice title=wheel-size (${{ matrix.label }})::with-feature=${FEAT}B baseline=${BASELINE}B delta=${DELTA}B; no-feature=${NOFEAT}B (informational)"
          {
            echo "## Wheel-size gate (${{ matrix.label }})"
            echo ""
            echo "| metric | value |"
            echo "| --- | --- |"
            echo "| with-feature wheel (shipped, GATED) | ${FEAT} B |"
            echo "| baseline | ${BASELINE} B |"
            echo "| delta vs baseline | ${DELTA} B |"
            echo "| budget (blocking) | ${BUDGET} B |"
            echo "| no-feature wheel | ${NOFEAT} B (informational only) |"
            echo "| with-feature delta vs no-feature | ${FEATDELTA} B (informational only) |"
          } >> "$GITHUB_STEP_SUMMARY"
          if [ "$DELTA" -gt "$BUDGET" ]; then
            echo "::error title=wheel-size regression::with-feature wheel grew ${DELTA} B vs baseline ${BASELINE} B (budget ${BUDGET} B)"
            exit 1
          fi

  # Docs-only fast-path md gate. Runs ONLY when the diff is markdown-only (the
  # heavy `verify` job — which runs scripts/agent-verify.sh -> agent-lint-md.sh —
  # is the md gate on every non-docs diff, so this avoids double-linting). Uses
  # the SAME .markdownlint-cli2.jsonc config as local + CI, so the real markdown
  # gate is preserved on the fast path (this is NOT a silent `paths-ignore` drop).
  markdownlint:
    needs: changes
    if: needs.changes.outputs.docs_only == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6.4.0
        with:
          node-version: "22"
      - name: Install markdown tooling (markdownlint-cli2)
        run: npm ci
      - name: markdownlint-cli2 (repo markdown; same config as local + verify)
        run: ./node_modules/.bin/markdownlint-cli2
      - name: markdownlint docs/** (mirrors agent-lint-md.sh docs leg)
        run: bash scripts/agent-lint-docs.sh
      - name: dev/plans/*.md status frontmatter (T3/8+9, mirrors agent-lint-md.sh leg)
        run: bash scripts/lint-plans-status.sh
      - name: master §6 findings register — duplicate-id gate (T1c, mirrors agent-lint-md.sh leg)
        run: bash scripts/lint-findings.sh

  # status-board-currency-enforcement item 3 — the non-bypassable CI backstop.
  # `preflight.sh --landing` (item 2) is the PREVENT gate at land time, but it is
  # a local, invocable check; this job is the DETECT gate that catches anything
  # that slipped preflight or predates it (the exact 4-day drift the incident
  # exhibited: a board that kept saying "not landed" after the merge commit was
  # already on origin/main). Reuses scripts/check-board-currency.sh — the SAME
  # script preflight.sh calls — so the two homes cannot diverge (see that
  # script's header for the full predicate). Intentionally NOT gated on
  # docs_only: a board can drift behind a non-docs-only push just as easily.
  # fetch-depth 0 is required: the predicate walks full reachable git history
  # for `merge(0.8.z): Slice N` commits, which a shallow (depth-1) checkout
  # would hide entirely.
  board-currency:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0
      - name: Board/git-ancestry drift check (status-board-currency-enforcement item 3)
        run: bash scripts/check-board-currency.sh --tip HEAD

  # DOC-HYGIENE-2 T1b — the always-on ledger-integrity backstop.
  # `preflight.sh --landing` is the PREVENT gate at land time; this job is the
  # DETECT gate for whatever slips it. Reuses scripts/check-ledgers.sh — the
  # SAME script preflight calls — so the two homes cannot diverge (see that
  # script's header for the predicate: sidecar == max(seq), and seq contiguous).
  #
  # Deliberately carries NO `if:` condition. A docs_only-gated job never fires on
  # a code push, and the measured incident (steward-ledger.jsonl.seq frozen at 80
  # against max(seq) 98 for 19 commits / four days) spanned both docs and code
  # pushes; the sidecar is tracked, so any clone taken in that window would have
  # minted colliding seq numbers. Default (depth-1) checkout is sufficient: the
  # predicate reads working-tree files only and walks no history.
  ledger-integrity:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - name: Ledger sidecar/seq integrity (DOC-HYGIENE-2 T1b)
        run: bash scripts/check-ledgers.sh

  # DOC-HYGIENE-2 T1e — the always-on governed-surface pin backstop.
  # `preflight.sh --landing` is the PREVENT gate at land time; this job is the
  # DETECT gate for whatever slips it. Reuses scripts/check-governed-surface-pin.sh
  # — the SAME script preflight calls — so the two homes cannot diverge (see that
  # script's header for the predicate: content hash + member lists + counts +
  # REQ-054, against scripts/governed-surface-pin.json).
  #
  # Deliberately carries NO `if:` condition and is NOT on the docs_only fast path:
  # a governed-surface change is BY DEFINITION a code change, so a docs_only gate
  # would make this job silently absent on exactly the pushes it exists to catch.
  # Default (depth-1) checkout is sufficient: the predicate reads working-tree
  # files only and walks no history.
  governed-surface-pin:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - name: Governed-surface pin vs the AC-079 pre-sign (DOC-HYGIENE-2 T1e)
        run: bash scripts/check-governed-surface-pin.sh

  # mkdocs --strict is the broader CI gate beyond agent-verify (per AGENTS.md §3).
  # Intentionally NOT gated on docs_only: it must run for docs/** changes (the
  # fast path) AND alongside code changes, exactly as before.
  docs:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6.3.0
        with:
          python-version: "3.12"
      - run: python3 -m pip install --upgrade pip mkdocs
      - run: mkdocs build --strict
#!/usr/bin/env bash
# preflight.sh — orchestrator-side gate, run BEFORE spawning an implementer.
#
# Codifies the checks whose absence has cost real slices:
#   * agent-worktree-stale-base-trap — a worktree cut from a stale base (main had
#     advanced ~206 commits) silently lost two slices. The --worktree check below
#     fails loudly when a worktree's HEAD is neither current main nor a descendant
#     of it.
#   * dependency-not-actually-CLOSED — spawning a slice whose declared dependency
#     never closed. The --expect-closed check greps the plan for the CLOSED block.
#   * landing-in-the-primary-checkout — TC-RUBRIC-5 requires release orchestration
#     and all landing git-writes to run in a dedicated linked worktree. --landing
#     HARD-fails when invoked from the primary checkout.
#
# Witness-first (orchestration.md §1.5): every check derives from the repo on disk,
# never from belief. Emits a one-line JSON summary; exits non-zero on any HARD fail.
#
# Usage:
#   scripts/preflight.sh                              # general repo health (run anytime)
#   scripts/preflight.sh --worktree /tmp/fdb-slice-5-... # + stale-base guard on a freshly cut WT
#   scripts/preflight.sh --expect-closed 5 --plan dev/plans/plan-0.8.6.md
#   scripts/preflight.sh --landing                    # TC-RUBRIC-5: refuse to land in the primary checkout
#   scripts/preflight.sh --worktree <wt> --expect-closed 5 --plan <plan> --min-disk-gb 15
#
# --landing composes with every other flag and is inert unless passed: without it
# the script behaves exactly as it did before the flag existed.
#
# Exit codes: 0 = all HARD checks pass (WARN/INFO may print); 1 = a HARD check failed.

set -euo pipefail

# Resolve this script's own directory BEFORE the toplevel cd below, so the
# board-currency check (§7) can find its sibling script regardless of which
# repo/worktree `cd` below lands us in (BASH_SOURCE is a file path, not
# affected by cwd, but resolving it AFTER a cd elsewhere would be needless
# fragility for no benefit).
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "$(git rev-parse --show-toplevel)"
CANON="$(pwd)"

WT=""
EXPECT_CLOSED=""
PLAN=""
MIN_DISK_GB=10
LANDING=0

while [ $# -gt 0 ]; do
  case "$1" in
    --landing)       LANDING=1; shift ;;
    --worktree)      WT="${2:?--worktree needs a path}"; shift 2 ;;
    --expect-closed) EXPECT_CLOSED="${2:?--expect-closed needs a slice id}"; shift 2 ;;
    --plan)          PLAN="${2:?--plan needs a file}"; shift 2 ;;
    --min-disk-gb)   MIN_DISK_GB="${2:?--min-disk-gb needs a number}"; shift 2 ;;
    *) printf 'preflight: unknown arg %q\n' "$1" >&2; exit 2 ;;
  esac
done

HARD_FAILS=()
WARNS=()

hard() { HARD_FAILS+=("$1"); printf 'HARD  %s\n' "$1" >&2; }
warn() { WARNS+=("$1");      printf 'WARN  %s\n' "$1" >&2; }
info() { printf 'INFO  %s\n' "$1" >&2; }
ok()   { printf 'ok    %s\n' "$1" >&2; }

# Resolve an existing directory to its absolute, symlink-resolved path. Uses
# cd+pwd -P rather than `readlink -f` so this works on macOS too. Prints nothing
# (and returns non-zero) if the path is not a reachable directory.
abs_dir() { ( cd "$1" 2>/dev/null && pwd -P ); }

MAIN_SHA="$(git rev-parse main)"

# --- 1. Canonical repo is not mid-operation -------------------------------------
GITDIR="$(git rev-parse --git-dir)"
if [ -d "$GITDIR/rebase-merge" ] || [ -d "$GITDIR/rebase-apply" ]; then
  hard "canonical repo is mid-rebase — finish or abort before spawning"
elif [ -f "$GITDIR/MERGE_HEAD" ]; then
  hard "canonical repo is mid-merge — finish or abort before spawning"
elif [ -f "$GITDIR/CHERRY_PICK_HEAD" ]; then
  hard "canonical repo is mid-cherry-pick — finish or abort before spawning"
else
  ok "canonical repo is not mid-merge/rebase/cherry-pick"
fi

# --- 2. Tracked source is clean (dev/ docs churn is expected, so only gate src/) -
DIRTY_SRC="$(git status --porcelain -- src/ scripts/ mkdocs.yml 2>/dev/null || true)"
if [ -n "$DIRTY_SRC" ]; then
  warn "tracked source dirty on canonical main (commit/stash before a worktree inherits a stale base):"
  printf '%s\n' "$DIRTY_SRC" | sed 's/^/        /' >&2
else
  ok "tracked source (src/ scripts/ mkdocs.yml) is clean"
fi

# --- 3. Disk headroom (worktrees + per-worktree target/ are not free) ------------
WT_PARENT="${WT:+$(dirname "$WT")}"; WT_PARENT="${WT_PARENT:-/tmp}"
FREE_GB="$(df -BG --output=avail "$WT_PARENT" 2>/dev/null | tail -1 | tr -dc '0-9')"
if [ -n "$FREE_GB" ] && [ "$FREE_GB" -lt "$MIN_DISK_GB" ]; then
  hard "only ${FREE_GB}G free on $WT_PARENT (need >= ${MIN_DISK_GB}G; prune stale worktrees)"
else
  ok "disk headroom on $WT_PARENT: ${FREE_GB:-?}G free (>= ${MIN_DISK_GB}G)"
fi

# --- 4. Worktree stale-base guard (the load-bearing check) -----------------------
if [ -n "$WT" ]; then
  if [ ! -d "$WT" ]; then
    hard "worktree path does not exist: $WT"
  elif [ "$(git -C "$WT" rev-parse --show-toplevel 2>/dev/null || echo MISSING)" != "$WT" ]; then
    hard "not a git worktree rooted at: $WT"
  else
    WT_HEAD="$(git -C "$WT" rev-parse HEAD)"
    if [ "$WT_HEAD" = "$MAIN_SHA" ]; then
      ok "worktree HEAD == current main ($MAIN_SHA) — freshly cut, no stale base"
    elif [ "$(git merge-base "$MAIN_SHA" "$WT_HEAD")" = "$MAIN_SHA" ]; then
      warn "worktree has advanced past main (main is an ancestor) — OK if it carries this slice's commits"
    else
      hard "STALE BASE: worktree HEAD ($WT_HEAD) is not current main and main is not its ancestor."
      hard "  -> re-create the worktree off \$(git rev-parse main). See agent-worktree-stale-base-trap."
    fi
    # maturin/pip -e from a worktree rebinds the shared .venv to the worktree tree.
    info "reminder: do NOT 'maturin develop' / 'pip install -e' from a worktree — build on the MAIN tree only."
  fi
fi

# --- 5. Dependency-CLOSED gate ---------------------------------------------------
if [ -n "$EXPECT_CLOSED" ]; then
  if [ -z "$PLAN" ]; then
    hard "--expect-closed $EXPECT_CLOSED given without --plan <file>"
  elif [ ! -f "$PLAN" ]; then
    hard "plan file not found: $PLAN"
  elif grep -qiE "(Slice|Phase)[^A-Za-z0-9]*${EXPECT_CLOSED}[^0-9].*CLOSED|CLOSED.*(Slice|Phase)[^A-Za-z0-9]*${EXPECT_CLOSED}([^0-9]|$)" "$PLAN"; then
    ok "dependency Slice/Phase $EXPECT_CLOSED has a CLOSED witness in $PLAN"
  else
    hard "dependency Slice/Phase $EXPECT_CLOSED has NO 'CLOSED' block in $PLAN — do not spawn dependents"
  fi
fi

# --- 6. Landing-mode guard (TC-RUBRIC-5) -----------------------------------------
# TC-RUBRIC-5 (HITL-ADOPTED 2026-07-11): release orchestration and ALL landing
# git-writes run in a dedicated linked worktree, never in the primary checkout.
#
# primary checkout <=> --git-dir and --git-common-dir name the SAME directory
# (a linked worktree's git-dir is <common>/worktrees/<name>).
#
# Both paths are canonicalized before comparing. git returns these relative or
# absolute depending on cwd and version: from a subdirectory, git 2.43 returns an
# ABSOLUTE --git-dir but a RELATIVE '../.git' --git-common-dir. Today the `cd` to
# the toplevel above normalizes that away (both read '.git' there), so a raw
# string compare would happen to work — but only by accident of that cd. Measured:
# with the toplevel cd removed, a raw compare run from a subdirectory of the
# primary checkout FAILS OPEN (exit 0, "cleared for landing"), while the
# canonicalized compare below still correctly HARD-fails. Canonicalizing makes
# this check self-sufficient rather than dependent on cwd, git version, and the
# ordering of an unrelated line.
if [ "$LANDING" -eq 1 ]; then
  GITDIR_ABS="$(abs_dir "$(git rev-parse --git-dir)" || true)"
  COMMONDIR_ABS="$(abs_dir "$(git rev-parse --git-common-dir)" || true)"
  if [ -z "$GITDIR_ABS" ] || [ -z "$COMMONDIR_ABS" ]; then
    hard "--landing: cannot resolve git-dir/git-common-dir — refusing to certify this tree for landing"
  elif [ "$GITDIR_ABS" = "$COMMONDIR_ABS" ]; then
    hard "TC-RUBRIC-5: --landing invoked in the PRIMARY checkout ($CANON) — landing git-writes are forbidden here."
    hard "  -> re-run from a dedicated linked worktree: git worktree add <path> <branch>, then run this from <path>."
  else
    ok "TC-RUBRIC-5: running in a linked worktree ($CANON) — cleared for landing git-writes"
  fi
fi

# --- 7. Board-currency gate (status-board-currency-enforcement design, item 2) --
# Refuse a land that would leave dev/plans/runs/STATUS-0.8.z.md stale. The
# incident: a slice's merge commit reached origin/main and the board kept saying
# "not landed" for four days — nobody's explicit job to update it at land time
# (an ownership seam between the orchestrator, who owns in-flight rows, and the
# Steward, who lands). See dev/design/status-board-currency-enforcement.md and
# orchestration.md §12.5 for the seam-ownership contract this gate enforces
# mechanically.
#
# The predicate lives in scripts/check-board-currency.sh (see that file's header
# for the full statement) so preflight and the CI drift job (item 3) share ONE
# implementation and cannot diverge. --landing-only: mid-build the board
# legitimately reads "in flight", so this must never run outside a land (that is
# precommit's false-positive trap the design doc rejects).
if [ "$LANDING" -eq 1 ]; then
  BOARD_CHECK_OUT="$(bash "$SELF_DIR/check-board-currency.sh" --tip HEAD 2>&1)" || BOARD_CHECK_RC=$?
  BOARD_CHECK_RC="${BOARD_CHECK_RC:-0}"
  if [ "$BOARD_CHECK_RC" -ne 0 ]; then
    while IFS= read -r line; do
      case "$line" in
        STALE*) hard "board-currency: $line" ;;
        *)      info "board-currency: $line" ;;
      esac
    done <<<"$BOARD_CHECK_OUT"
  else
    ok "board-currency: live STATUS-0.8.z.md board(s) match git ancestry for this tip"
  fi
fi

# --- 8. Ledger-integrity gate (DOC-HYGIENE-2 T1b) --------------------------------
# Refuse a land that would ship a `*.jsonl.seq` sidecar disagreeing with its
# ledger. The incident: 19 consecutive commits (f22e4947 -> 3264114a, four days)
# shipped dev/steward/steward-ledger.jsonl.seq frozen at 80 while max(seq) in
# the ledger had reached 98. The sidecar is TRACKED and is the only thing an
# appender reads to pick the next seq, so every clone taken in that window would
# have minted colliding seq numbers.
#
# The predicate lives in scripts/check-ledgers.sh (see that file's header for
# the full statement — exactly two checks: sidecar == max(seq), and seq
# contiguous) so preflight and the always-on CI job share ONE implementation and
# cannot diverge, exactly as §7 does for board-currency.
#
# --landing-only, mirroring §7's structure. The ledger invariant is in fact true
# at all times (unlike a board, which legitimately reads "in flight" mid-build),
# so an unconditional run would also be sound; it is kept behind --landing so
# preflight's non-landing path stays exactly as lean as it was, and the CI job —
# which is deliberately NOT docs_only-gated — is what covers every non-landing
# push.
if [ "$LANDING" -eq 1 ]; then
  LEDGER_CHECK_OUT="$(bash "$SELF_DIR/check-ledgers.sh" 2>&1)" || LEDGER_CHECK_RC=$?
  LEDGER_CHECK_RC="${LEDGER_CHECK_RC:-0}"
  if [ "$LEDGER_CHECK_RC" -ne 0 ]; then
    LEDGER_SAW_BROKEN=0
    while IFS= read -r line; do
      case "$line" in
        BROKEN*) hard "ledger-integrity: $line"; LEDGER_SAW_BROKEN=1 ;;
        *)       info "ledger-integrity: $line" ;;
      esac
    done <<<"$LEDGER_CHECK_OUT"
    # Anti-fail-open: a non-zero rc with no BROKEN line means the checker itself
    # could not run (exit 2 = usage/env, e.g. python3 absent) — that must still
    # block the land, never degrade into INFO lines and a green summary.
    if [ "$LEDGER_SAW_BROKEN" -eq 0 ]; then
      hard "ledger-integrity: check-ledgers.sh exited $LEDGER_CHECK_RC without reporting a specific defect — refusing to certify this tree for landing"
    fi
  else
    ok "ledger-integrity: every *.jsonl.seq sidecar agrees with its ledger and every seq run is contiguous"
  fi
fi

# --- 9. Governed-surface pin gate (DOC-HYGIENE-2 T1e) ----------------------------
# Refuse a land that would ship a governed surface the HITL has not signed. The
# HITL PRE-SIGNED the accumulated delta of 0.8.20 Slices 5d+10b+15b+15d (AC-079)
# pinned to the exact content of src/conformance/governed-surface-allowlist.json
# as of 427d2712 — 30 allowlist members, recovery_denylist unchanged at the five
# REQ-054 names. This gate makes that pin mechanical.
#
# The predicate lives in scripts/check-governed-surface-pin.sh (see that file's
# header) so preflight and the always-on CI job share ONE implementation and
# cannot diverge, exactly as §7 and §8 do. --landing-only, mirroring their
# structure: the CI job — deliberately NOT docs_only-gated — covers every
# non-landing push.
#
# Tripping this is CORRECT BEHAVIOUR, not a bug: Slices 20/25/30 are expected to
# trip it, and that is exactly what routes a changed surface back to the HITL
# instead of letting it land under a pre-sign that never covered it.
if [ "$LANDING" -eq 1 ]; then
  SURFACE_CHECK_OUT="$(bash "$SELF_DIR/check-governed-surface-pin.sh" 2>&1)" || SURFACE_CHECK_RC=$?
  SURFACE_CHECK_RC="${SURFACE_CHECK_RC:-0}"
  if [ "$SURFACE_CHECK_RC" -ne 0 ]; then
    SURFACE_SAW_FAIL=0
    while IFS= read -r line; do
      case "$line" in
        FAIL*) hard "governed-surface-pin: $line"; SURFACE_SAW_FAIL=1 ;;
        *)     info "governed-surface-pin: $line" ;;
      esac
    done <<<"$SURFACE_CHECK_OUT"
    # Anti-fail-open, as in §8: a non-zero rc with no FAIL line means the checker
    # itself could not run (exit 2 = usage/env, e.g. python3 absent or an
    # unreadable pin) — that must still block the land.
    if [ "$SURFACE_SAW_FAIL" -eq 0 ]; then
      hard "governed-surface-pin: check-governed-surface-pin.sh exited $SURFACE_CHECK_RC without reporting a specific defect — refusing to certify this tree for landing"
    fi
  else
    ok "governed-surface-pin: the governed surface matches the AC-079 pre-signed pin"
  fi
fi

# --- Summary (JSON, last line) ---------------------------------------------------
json_arr() { local out="" x; for x in "$@"; do out="${out:+$out,}\"$(printf '%s' "$x" | sed 's/\\/\\\\/g; s/"/\\"/g')\""; done; printf '[%s]' "$out"; }

STATUS=$([ ${#HARD_FAILS[@]} -eq 0 ] && echo pass || echo fail)
printf '{"preflight":"%s","main_sha":"%s","worktree":"%s","hard_fails":%s,"warnings":%s}\n' \
  "$STATUS" "$MAIN_SHA" "${WT:-}" "$(json_arr "${HARD_FAILS[@]+"${HARD_FAILS[@]}"}")" "$(json_arr "${WARNS[@]+"${WARNS[@]}"}")"

[ "$STATUS" = pass ]

exec
/bin/bash -lc "nl -ba scripts/check-governed-surface-pin.sh | sed -n '135,170p'" in /home/coreyt/projects/fathomdb-worktrees/dh2-t1c
 succeeded in 0ms:
