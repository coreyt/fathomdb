   991	# asserts is a boundary that erodes. NOTE the implementer keeps Edit/Write: it
   992	# is the seat that writes source, and the guard must never obstruct it.
   993	declare -a SEAT_NAME_TOOLS=(
   994	  "orchestrator|Read, Bash, Grep, Glob, Agent, Task"
   995	  "steward|Read, Bash, Grep, Glob, Agent, Task"
   996	  "implementer|Read, Edit, Write, Bash, Grep, Glob"
   997	)
   998	for spec in "${SEAT_NAME_TOOLS[@]}"; do
   999	  seat="${spec%%|*}"
  1000	  want_tools="${spec#*|}"
  1001	  fm "$AGENTS_DIR/$seat.md" name
  1002	  if [ "$FM_RC" -eq 0 ] && [ "$FM_OUT" = "$seat" ]; then
  1003	    pass "arm 66 ($seat): name: is still '$seat'"
  1004	  else
  1005	    fail "arm 66 ($seat): name: changed — got '$FM_OUT' (rc=$FM_RC, err: $FM_ERR)"
  1006	  fi
