   807	expect_deny "arm 63: 'git -C <dir> checkout -- src/**' is DENIED (the -C VALUE is not the subcommand) (RED before fix-2)"
   808	run_hook "$(payload Bash '' 'git -C /home/x/wt restore src/rust/lib.rs' steward)"
   809	expect_deny "arm 63b: 'git -C <dir> restore src/**' is DENIED (RED before fix-2)"
   810	run_hook "$(payload Bash '' 'git -c core.editor=true checkout -- src/rust/lib.rs' orchestrator)"
   811	expect_deny "arm 63c: 'git -c <cfg> checkout -- src/**' is DENIED (RED before fix-2)"
