    78	# ---------------------------------------------------------------------------
    79	# payload <tool_name> <file_path> <command> [agent_type] [agent_id]
    80	#   Emits a PreToolUse stdin payload with the field set the real harness sends
    81	#   (session_id / cwd / permission_mode / hook_event_name / tool_use_id are
    82	#   included so the hook is exercised against realistic, not minimal, input).
    83	#   An EMPTY agent_type/agent_id argument means the KEY IS OMITTED entirely —
    84	#   that is the documented main-thread shape, and omission (not empty-string)
    85	#   is what the hook must handle.
    86	# ---------------------------------------------------------------------------
    87	payload() {
    88	  python3 - "$@" <<'PY'
    89	import json, sys
    90	tool, file_path, command = sys.argv[1], sys.argv[2], sys.argv[3]
    91	agent_type = sys.argv[4] if len(sys.argv) > 4 else ""
    92	agent_id = sys.argv[5] if len(sys.argv) > 5 else ""
