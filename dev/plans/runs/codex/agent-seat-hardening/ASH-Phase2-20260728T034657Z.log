  1008	  if [ "$FM_RC" -eq 0 ] && [ "$FM_OUT" = "$want_tools" ]; then
  1009	    pass "arm 66 ($seat): tools: is unchanged ('$want_tools')"
  1010	  else
  1011	    fail "arm 66 ($seat): tools: CHANGED — want '$want_tools', got '$FM_OUT' (rc=$FM_RC, err: $FM_ERR)"
  1012	  fi
  1013	done
  1014	
  1015	# arms 67/68 — each COORDINATING seat declares a PreToolUse hook that resolves
  1016	# to this repo's seat-path-guard.sh. Loop body is shared; the labels are per
  1017	# seat so a half-wired state names which half.
  1018	SEAT_ARM_IDS=("orchestrator|arm 67" "steward|arm 68")
  1019	for spec in "${SEAT_ARM_IDS[@]}"; do
  1020	  seat="${spec%%|*}"
  1021	  arm="${spec#*|}"
  1022	  f="$AGENTS_DIR/$seat.md"
  1023	
  1024	  fm "$f" pretool-commands
  1025	  cmds="$FM_OUT"
