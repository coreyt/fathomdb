    94	    "session_id": "11111111-2222-3333-4444-555555555555",
    95	    "prompt_id": "prompt-1",
    96	    "transcript_path": "/home/nobody/.claude/projects/x/y.jsonl",
    97	    "cwd": "/home/nobody/repo",
    98	    "permission_mode": "default",
    99	    "hook_event_name": "PreToolUse",
   100	    "tool_name": tool,
   101	    "tool_use_id": "toolu_01",
   102	    "effort": "medium",
   103	}
