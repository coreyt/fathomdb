   826	expect_deny "arm 64: 'cp -t src/rust <file>' is DENIED (the destination came from the option) (RED before fix-2)"
   827	run_hook "$(payload Bash '' 'cp --target-directory=src/rust dev/plans/x.md' orchestrator)"
   828	expect_deny "arm 64b: 'cp --target-directory=src/rust <file>' is DENIED (RED before fix-2)"
