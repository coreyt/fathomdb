+import re
+import sys
+
+import yaml
+
+path, query = sys.argv[1], sys.argv[2]
+rest = sys.argv[3:]
+raw = open(path, encoding="utf-8").read()
+if not raw.startswith("---\n"):
+    sys.stderr.write("no opening frontmatter delimiter\n")
+    sys.exit(3)
+end = raw.find("\n---\n", 3)
+if end < 0:
+    sys.stderr.write("unterminated frontmatter block\n")
+    sys.exit(3)
