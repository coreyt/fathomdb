  1032	    [ -n "$line" ] || continue
  1033	    resolved="$(resolve_hook_cmd "$line")"
  1034	    case "$resolved" in
  1035	      *seat-path-guard.sh*) matched="$resolved" ;;
  1036	    esac
  1037	  done <<EOF
  1038	$cmds
  1039	EOF
  1040	
  1041	  # Deliberately NO short-circuit below: when the seat is unwired, arms 70/71/72
  1042	  # must each go red on their own terms rather than being skipped. A skipped arm
  1043	  # is an arm nobody has ever seen fail.
  1044	  if [ -n "$matched" ]; then
  1045	    pass "$arm ($seat): declares a PreToolUse hook whose command names seat-path-guard.sh"
  1046	  elif [ -z "$cmds" ]; then
  1047	    fail "$arm ($seat): declares NO PreToolUse command hook — the guard is not wired for this seat"
  1048	  else
  1049	    fail "$arm ($seat): PreToolUse hooks exist but none resolves to seat-path-guard.sh; got: $(printf '%s' "$cmds" | tr '\n' ' ')"
  1050	  fi
  1051	
  1052	  # arm 70 — the wiring points at a file that EXISTS and is EXECUTABLE, and is
  1053	  # the very hook this suite exercises. A frontmatter entry naming a missing
  1054	  # script is accepted by the harness and simply never guards anything: the
  1055	  # static assertion above would be green while the seat ran unguarded.
  1056	  if [ -n "$matched" ] && [ "$matched" = "$HOOK" ]; then
  1057	    pass "arm 70 ($seat): the wired command IS this suite's hook ($HOOK)"
  1058	  else
  1059	    fail "arm 70 ($seat): wired command resolves to '${matched:-<nothing>}', not the hook under test '$HOOK'"
  1060	  fi
  1061	  if [ -n "$matched" ] && [ -f "$matched" ] && [ -x "$matched" ]; then
  1062	    pass "arm 70 ($seat): the wired command exists and is executable"
  1063	  else
  1064	    fail "arm 70 ($seat): the wired command is missing or not executable: '${matched:-<nothing>}' — the wiring is inert"
  1065	  fi
  1066	
  1067	  # arm 71 — the matcher covers all three write verbs. Bash is the load-bearing
  1068	  # one (see the header: 76 and 193 Bash calls, ZERO Edit/Write, on the two
  1069	  # observed orchestrator sessions), so a matcher of "Edit|Write" would wire a
  1070	  # guard onto the path the seats do not use.
  1071	  fm "$f" matcher-covers Edit Write Bash
  1072	  if [ "$FM_RC" -eq 0 ] && [ "$FM_OUT" = "COVERS" ]; then
  1073	    pass "arm 71 ($seat): the PreToolUse matcher covers Edit, Write AND Bash"
  1074	  else
  1075	    fail "arm 71 ($seat): matcher does not cover all write verbs — got '$FM_OUT' (rc=$FM_RC, err: $FM_ERR)"
  1076	  fi
  1077	
  1078	  # arm 72 — type: command, and the path is expressed via ${CLAUDE_PROJECT_DIR}
  1079	  # rather than a literal absolute path, which would work on exactly one
  1080	  # machine and fail open (silently) on every other clone.
  1081	  fm "$f" pretool-types
  1082	  if [ "$FM_RC" -eq 0 ] && [ -n "$FM_OUT" ] && [ -z "$(printf '%s' "$FM_OUT" | grep -v '^command$' || true)" ]; then
