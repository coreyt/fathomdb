  1100	fm "$AGENTS_DIR/implementer.md" has-hooks
  1101	if [ "$FM_RC" -eq 0 ] && [ "$FM_OUT" = "no" ]; then
  1102	  pass "arm 69 (implementer): declares NO hooks — the seat the guard must never block stays unhooked"
  1103	else
  1104	  fail "arm 69 (implementer): declares a hooks: block ('$FM_OUT') — the implementer must never carry the seat guard (rc=$FM_RC, err: $FM_ERR)"
  1105	fi
  1106	
  1107	if [ "$FAILED" -gt 0 ]; then
  1108	  printf '\n%d test(s) failed\n' "$FAILED" >&2
  1109	  exit 1
  1110	fi
  1111	printf '\nAll seat-path-guard tests passed\n'

exec
