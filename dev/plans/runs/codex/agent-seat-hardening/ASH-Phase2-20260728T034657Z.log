   834	expect_allow "arm 64e: an ordinary 'cp' between allowed paths is ALLOWED (already green)"
   835	
   836	# ================== ARMS 65-72 — PHASE-2 WIRING (TC-85 / seq-127) ============
   837	# Every arm above proves the hook BEHAVES correctly when something runs it.
   838	# None of them proves anything ever runs it. That gap is what shipped in Phase 1
   839	# ("deliberately UNWIRED") and these arms close it: the guard is wired through
   840	# AGENT FRONTMATTER — a `hooks:` block in .claude/agents/{orchestrator,steward}
   841	# .md — which fires for that seat's own tool calls when it is spawned as a
   842	# subagent, and for a main thread launched as `claude --agent <seat>`, and is
   843	# torn down when the subagent finishes (it does not leak to siblings or to the
   844	# parent). settings.json is ruled out permanently; arm 16 holds that boundary.
   845	#
   846	# WHY THESE ASSERT ON PARSED YAML, NOT ON A SUBSTRING
   847	#   `grep -q seat-path-guard .claude/agents/steward.md` is satisfied by the
   848	#   PROSE in that file, by a commented-out block, or by a `hooks:` block nested
   849	#   under the wrong event key. Only a parse can tell "wired" from "mentioned".
   850	#   The one thing a parse still cannot tell you is whether the command it names
   851	#   is a real program — a wiring that points at a missing or non-executable file
   852	#   is silently inert, which is the false green that matters most here — so arm
   853	#   70 stats the resolved path.
   854	#
   855	# OBSERVED RED (run against the unwired files, before the frontmatter existed):
   856	#   arms 67, 68, 70, 71 and 72 FAILED for BOTH coordinating seats — "declares NO
   857	#   PreToolUse command hook", "the wiring is inert", "MISSING:Edit,Write,Bash" —
   858	#   12 test(s) failed, rc=1, 123 passed. Arms 65/66/69 were green then and must
   859	#   stay green: they are the "nothing else moved" controls, so they carry no
   860	#   RED witness of their own and are not evidence of wiring.
   861	
   862	# ---------------------------------------------------------------------------
   863	# fm <file> <query> [args...] — parse an agent file's YAML frontmatter and
   864	#   answer one structured question about it. Sets FM_OUT / FM_RC / FM_ERR.
   865	#   Queries:
   866	#     parse             -> "OK" iff the frontmatter block is well-formed YAML
   867	#     name              -> the `name:` scalar
   868	#     tools             -> the `tools:` scalar, verbatim
   869	#     has-hooks         -> "yes" / "no" (is the `hooks:` key present at all)
   870	#     pretool-commands  -> one line per hooks.PreToolUse[*].hooks[*].command
   871	#     pretool-types     -> one line per hooks.PreToolUse[*].hooks[*].type
   872	#     matcher-covers V.. -> "COVERS" iff every PreToolUse matcher-group taken
   873	#                          together fullmatches each verb V (regex semantics,
   874	#                          the same shape the harness applies)
   875	# ---------------------------------------------------------------------------
   876	fm() {
   877	  local f="$1"
   878	  shift
   879	  set +e
   880	  FM_OUT="$(python3 - "$f" "$@" 2>"$TMPROOT/fm.err" <<'PY'
   881	import re
   882	import sys
   883	
   884	import yaml
   885	
   886	path, query = sys.argv[1], sys.argv[2]
   887	rest = sys.argv[3:]
   888	raw = open(path, encoding="utf-8").read()
   889	if not raw.startswith("---\n"):
   890	    sys.stderr.write("no opening frontmatter delimiter\n")
   891	    sys.exit(3)
   892	end = raw.find("\n---\n", 3)
   893	if end < 0:
   894	    sys.stderr.write("unterminated frontmatter block\n")
   895	    sys.exit(3)
   896	try:
   897	    fm = yaml.safe_load(raw[4:end + 1])
   898	except Exception as exc:  # malformed YAML must be loud, never a silent pass
   899	    sys.stderr.write("frontmatter is not valid YAML: %s\n" % exc)
   900	    sys.exit(3)
   901	if not isinstance(fm, dict):
   902	    sys.stderr.write("frontmatter is not a mapping\n")
   903	    sys.exit(3)
   904	
   905	
   906	def pretool_groups():
   907	    hooks = fm.get("hooks")
   908	    if not isinstance(hooks, dict):
   909	        return []
   910	    groups = hooks.get("PreToolUse")
   911	    if not isinstance(groups, list):
   912	        return []
   913	    return [g for g in groups if isinstance(g, dict)]
   914	
   915	
   916	def entries():
   917	    for g in pretool_groups():
   918	        for h in g.get("hooks") or []:
   919	            if isinstance(h, dict):
   920	                yield g, h
   921	
   922	
   923	if query == "parse":
   924	    sys.stdout.write("OK")
   925	elif query in ("name", "tools"):
   926	    v = fm.get(query)
   927	    sys.stdout.write("" if v is None else str(v))
   928	elif query == "has-hooks":
   929	    sys.stdout.write("yes" if "hooks" in fm else "no")
   930	elif query == "pretool-commands":
   931	    for _, h in entries():
   932	        if h.get("type") == "command" and h.get("command"):
   933	            sys.stdout.write(str(h["command"]) + "\n")
   934	elif query == "pretool-types":
   935	    for _, h in entries():
   936	        sys.stdout.write(str(h.get("type")) + "\n")
   937	elif query == "matcher-covers":
   938	    matchers = [str(g.get("matcher", "")) for g in pretool_groups()]
   939	    missing = []
   940	    for verb in rest:
   941	        hit = False
   942	        for m in matchers:
   943	            try:
   944	                if re.fullmatch(m, verb):
   945	                    hit = True
   946	                    break
   947	            except re.error:
   948	                pass
   949	        if not hit:
   950	            missing.append(verb)
   951	    sys.stdout.write("COVERS" if not missing else "MISSING:" + ",".join(missing))
   952	else:
   953	    sys.stderr.write("unknown query: %s\n" % query)
   954	    sys.exit(4)
   955	PY
   956	)"
   957	  FM_RC=$?
   958	  set -e
   959	  FM_ERR="$(cat "$TMPROOT/fm.err" 2>/dev/null || true)"
   960	  rm -f "$TMPROOT/fm.err"
   961	}
   962	
   963	# resolve_hook_cmd <command> -> the command with ${CLAUDE_PROJECT_DIR} expanded
   964	# to this checkout. The frontmatter must use that variable rather than a literal
   965	# absolute path (arm 72), so resolution is what turns the declaration into a
   966	# path we can stat.
   967	resolve_hook_cmd() {
   968	  local c="$1"
   969	  c="${c//\$\{CLAUDE_PROJECT_DIR\}/$REPO_ROOT}"
   970	  c="${c//\$CLAUDE_PROJECT_DIR/$REPO_ROOT}"
   971	  printf '%s' "$c"
   972	}
   973	
   974	AGENTS_DIR="$REPO_ROOT/.claude/agents"
   975	
   976	# arm 65 — the frontmatter of every seat file still parses. A `hooks:` block is
   977	# the first nested structure any of these files has carried; a botched indent
   978	# would make the WHOLE file's frontmatter unreadable to the harness, silently
   979	# demoting the seat, and every other arm here would still pass.
