  1089	    pass "arm 72 ($seat): the hook path is anchored on \$CLAUDE_PROJECT_DIR (portable across clones)"
  1090	  else
  1091	    fail "arm 72 ($seat): the hook path is not anchored on \$CLAUDE_PROJECT_DIR — a literal path only works in one checkout; got: $(printf '%s' "$FM_OUT" | tr '\n' ' ')"
