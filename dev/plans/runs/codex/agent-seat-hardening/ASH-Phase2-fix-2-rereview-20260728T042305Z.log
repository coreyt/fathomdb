  1495	# # That is not the algorithm the harness runs, and it is not even the same  #
  1496	# # LANGUAGE. Per the documented semantics (code.claude.com/docs/en/         #
  1497	# # agent-sdk/hooks#matchers) the harness has TWO paths:                     #
  1498	# #   * a matcher made only of letters, digits, `_`, `-`, spaces, `,` and    #
  1499	# #     `|` is compared as an EXACT STRING, with `|` or `,` separating       #
  1500	# #     alternatives and surrounding whitespace ignored — so `Edit|Write`    #
  1501	# #     and `Edit, Write` are LISTS, matched by equality, not by regex;      #
  1502	# #   * a matcher containing ANY other character is an UNANCHORED regular    #
  1503	# #     expression, evaluated by JavaScript's engine at runtime.             #
  1504	# # Python's oracle therefore disagreed with the harness twice over: it      #
  1505	# # anchored (fullmatch) what the harness leaves unanchored, and it parsed   #
  1506	# # with a different regex dialect. The concrete false green codex gave:     #
  1507	# # `(?P<tool>Edit)|Write|Bash` — Python accepts the named group and reports #
  1508	# # all three verbs covered, so arms 67/70/71/72 stayed green, while         #
  1509	# # JavaScript REJECTS `(?P<...>)` outright, so the guard would not reliably #
  1510	# # attach at runtime. The suite would have been asserting a wiring that did #
  1511	# # not exist. Reachability was ZERO — the shipped matcher is the plain      #
  1512	# # `Edit|Write|Bash` — so this is a latent false green, fixed for the same  #
  1513	# # reason the Slice-30 BOM finding was: the entire purpose of this suite is #
  1514	# # to stop a wiring claim that is not true.                                 #
  1515	# #                                                                          #
  1516	# # WHY NOT EMULATE JAVASCRIPT. The obvious repair — make the Python oracle  #
  1517	# # behave like JS (unanchored search, JS dialect) — is reimplementing       #
  1518	# # another language's regex parser inside a shell test. The mismatch would  #
  1519	# # not go away, it would just move to whichever construct the two engines   #
  1520	# # next disagree about (`\d` in classes, lookbehind, `\u{...}`, unicode     #
  1521	# # property escapes...), and each move is a fresh silent false green.       #
  1522	# #                                                                          #
  1523	# # THE FIX: refuse the ambiguity instead of modelling it. A guard-carrying  #
  1524	# # matcher must be a SIMPLE TOOL-NAME LIST — one or more names of           #
  1525	# # [A-Za-z0-9_] separated by `|` or `,`, with optional surrounding spaces.  #
  1526	# # That is exactly the harness's EXACT-STRING path, and on that path the    #
  1527	# # harness itself decides by SET MEMBERSHIP. So the oracle is no longer an  #
  1528	# # approximation of a regex engine; it is the harness's own algorithm, and  #
  1529	# # the answer cannot depend on which engine reads it. Anything else — named #
  1530	# # groups, lookaround, character classes, `.*`, quantifiers, anchors,       #
  1531	# # parens — FAILS LOUDLY as NOT-SIMPLE.                                     #
  1532	# #                                                                          #
  1533	# # THE JUDGEMENT CALLS, stated so they are reviewable rather than implied:  #
  1534	# #  (1) `(Edit|Write|Bash)` is REJECTED (73c), not accepted by stripping    #
  1535	# #      the outer parens. Stripping would mean the oracle re-classifies as  #
  1536	# #      a list something the harness classifies as a regex — inventing a    #
  1537	# #      transformation the harness does not perform, which is the very      #
  1538	# #      false-green class being closed here.                                #
  1539	# #  (2) `*`, `""` and an ABSENT matcher key are REJECTED (73o, 73p) even    #
  1540	# #      though the docs say each matches EVERY event and would therefore    #
  1541	# #      genuinely cover the write verbs. They are a third special case,     #
  1542	# #      taken before either path above, and they rest wholly on that        #
  1543	# #      special case: handed to any regex engine a bare `*` is a syntax     #
  1544	# #      error. A security guard's wiring must NAME the verbs it claims, so  #
  1545	# #      that coverage can be read off the matcher by a human reviewer.      #
  1546	# #      This is a deliberate tightening; nothing shipped uses these forms.  #
  1547	# #  (3) HYPHENS are excluded from the name charset even though the docs put #
  1548	# #      `-` in the exact-match set, because that membership is gated on a   #
  1549	# #      Claude Code runtime of v2.1.195 or later — on an older runtime the  #
  1550	# #      same matcher is a regex. A matcher whose meaning depends on the     #
  1551	# #      reader's version is the ambiguity this block exists to refuse. No   #
  1552	# #      built-in tool name contains a hyphen, so nothing is lost.           #
  1553	# ############################################################################
  1554	
  1555	# --- 73k: CODEX'S EXACT FIXTURE. Python's re accepts `(?P<tool>...)`; JS does
  1556	# not. Pre-fix-2 this file reported COVERS and the whole suite stayed rc=0.
  1557	fx namedgroup <<'YAML'
  1558	hooks:
  1559	  PreToolUse:
  1560	    - matcher: "(?P<tool>Edit)|Write|Bash"
  1561	      hooks:
  1562	        - type: command
  1563	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1564	YAML
  1565	gw_reject namedgroup 1 "'(?P<tool>Edit)|Write|Bash'" "the reproduced [P2]: a Python-only named group '(?P<tool>Edit)|Write|Bash' is REJECTED — pre-fix-2 Python read it as covering all three verbs while JS would refuse to compile it"
  1566	
  1567	# --- 73l: lookahead. Parsed by both engines here, which is the point: it is
  1568	# rejected for being a regex at all, not for being an incompatible one.
  1569	fx lookahead <<'YAML'
  1570	hooks:
  1571	  PreToolUse:
  1572	    - matcher: "(?!Read)(Edit|Write|Bash)"
  1573	      hooks:
  1574	        - type: command
  1575	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1576	YAML
  1577	gw_reject lookahead 1 "'(?!Read)(Edit|Write|Bash)'" "a lookahead matcher '(?!Read)(Edit|Write|Bash)' is REJECTED — the rule is 'is this a tool-name list', not 'does some engine happen to agree today'"
  1578	
  1579	# --- 73m: anchors. The harness's regex path is UNANCHORED, so '^...$' is a
  1580	# matcher whose author is reasoning about a different matching mode than the
  1581	# one that will run. Rejected rather than second-guessed.
  1582	fx anchored <<'YAML'
  1583	hooks:
  1584	  PreToolUse:
  1585	    - matcher: "^(Edit|Write|Bash)$"
  1586	      hooks:
  1587	        - type: command
  1588	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1589	YAML
  1590	gw_reject anchored 1 "'^(Edit|Write|Bash)\$'" "an anchored matcher '^(Edit|Write|Bash)\$' is REJECTED — anchoring is exactly the axis the old fullmatch() oracle got wrong"
  1591	
  1592	# --- 73n: a character class, i.e. a matcher that covers by INFERENCE rather
  1593	# than by naming. '[EW].*' would catch Edit and Write and also NotebookEdit,
  1594	# and a reader cannot tell which verbs are guarded without running it.
  1595	fx charclass <<'YAML'
  1596	hooks:
  1597	  PreToolUse:
  1598	    - matcher: "[EW].*|Bash"
  1599	      hooks:
  1600	        - type: command
  1601	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1602	YAML
  1603	gw_reject charclass 1 "'[EW].*|Bash'" "a character-class matcher '[EW].*|Bash' is REJECTED — a guard must name the verbs it guards, not imply them"
  1604	
  1605	# --- 73o: the documented universal wildcard. It really does match every event.
  1606	# Rejected anyway, per judgement call (2) above.
  1607	fx star <<'YAML'
  1608	hooks:
  1609	  PreToolUse:
  1610	    - matcher: "*"
  1611	      hooks:
  1612	        - type: command
  1613	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1614	YAML
  1615	gw_reject star 1 "'*'" "the wildcard matcher '*' is REJECTED even though it documentedly matches every event — a guard's wiring must enumerate the verbs it claims, and '*' is a pre-regex special case, not a pattern"
  1616	
  1617	# --- 73p: the matcher key ABSENT entirely (the same semantics as ""). This is
  1618	# the easiest one to produce by accident — delete a line — and it is the one
  1619	# where a permissive oracle would silently report full coverage.
  1620	fx nomatcher <<'YAML'
  1621	hooks:
  1622	  PreToolUse:
  1623	    - hooks:
  1624	        - type: command
  1625	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1626	YAML
  1627	gw_reject nomatcher 1 "''" "an ABSENT matcher key is REJECTED — it matches every event, so a permissive oracle would call it full coverage, and a deleted line would silently become an unreadable wiring"
  1628	
  1629	# --- 73q: the COMMA list. Documented as equivalent to the '|' list, with
  1630	# surrounding whitespace ignored ('Write, Edit' matches exactly those two
  1631	# tools), so it must COVER — and it must do so through the set-membership path,
  1632	# never as a regex, where a bare ',' would be a literal character and match
  1633	# nothing at all. This is the positive control on the separator rule.
  1634	fx commalist <<'YAML'
  1635	hooks:
  1636	  PreToolUse:
  1637	    - matcher: "Edit, Write, Bash"
  1638	      hooks:
  1639	        - type: command
  1640	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1641	YAML
  1642	gw_case commalist 1 COVERS "matcher 'Edit, Write, Bash' COVERS — ',' is a documented alternative separator and surrounding whitespace is ignored (as a regex this would have matched nothing)"
  1643	
  1644	# arm 69 — the IMPLEMENTER declares no hooks at all. This is the complement of
  1645	# arms 67/68 and the reason frontmatter was chosen over settings.json: the seat
  1646	# that legitimately writes src/** and tests/** must be reachable by NO copy of
  1647	# this guard. Asserted as "the hooks: key is absent", not "no PreToolUse hook",
  1648	# so that wiring the implementer to any other event also trips it.
  1649	fm "$AGENTS_DIR/implementer.md" has-hooks
  1650	if [ "$FM_RC" -eq 0 ] && [ "$FM_OUT" = "no" ]; then
  1651	  pass "arm 69 (implementer): declares NO hooks — the seat the guard must never block stays unhooked"
  1652	else
  1653	  fail "arm 69 (implementer): declares a hooks: block ('$FM_OUT') — the implementer must never carry the seat guard (rc=$FM_RC, err: $FM_ERR)"
  1654	fi
  1655	
  1656	if [ "$FAILED" -gt 0 ]; then
  1657	  printf '\n%d test(s) failed\n' "$FAILED" >&2
  1658	  exit 1
  1659	fi
  1660	printf '\nAll seat-path-guard tests passed\n'

