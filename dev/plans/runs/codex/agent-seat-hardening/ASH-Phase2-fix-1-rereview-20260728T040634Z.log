  1264	# # orchestrator.md gave rc=0 with 135/135 passing.                           #
  1265	# ############################################################################
  1266	
  1267	# fx <name> — write a synthetic agent file whose hooks: block is read from
  1268	# stdin, and echo nothing. The fixture lives in TMPROOT and is removed with it;
  1269	# no tracked file is touched.
  1270	fx() {
  1271	  local p="$TMPROOT/fx-$1.md"
  1272	  {
  1273	    printf '%s\n' '---' 'name: fixture' 'tools: Read'
  1274	    cat
  1275	    printf '%s\n' '---' '' 'body'
  1276	  } >"$p"
  1277	}
  1278	
  1279	# gw_case <name> <want-count> <want-coverage> <desc>
  1280	gw_case() {
  1281	  local name="$1" want_count="$2" want_cov="$3" desc="$4"
  1282	  read_guard_wiring "$TMPROOT/fx-$name.md"
  1283	  if [ "$GW_RC" -eq 0 ] && [ "$GW_COUNT" = "$want_count" ] && [ "$GW_COVERAGE" = "$want_cov" ]; then
  1284	    pass "arm 73$name: $desc"
  1285	  else
  1286	    fail "arm 73$name: $desc — got COUNT=$GW_COUNT COVERAGE='$GW_COVERAGE' (want COUNT=$want_count COVERAGE='$want_cov'); rc=$GW_RC, err: $GW_ERR"
  1287	  fi
  1288	}
  1289	
  1290	# --- 73a: THE REPRODUCED ATTACK. Guard on Read; an unrelated (and NON-EXISTENT)
  1291	# command holds Edit|Write|Bash. Aggregate arms saw "a matcher covers the write
  1292	# verbs" and "a command names the guard" and passed. Bound arms must see that
  1293	# the guard's OWN matcher covers nothing.
  1294	fx attack <<'YAML'
  1295	hooks:
  1296	  PreToolUse:
  1297	    - matcher: "Read"
  1298	      hooks:
  1299	        - type: command
  1300	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1301	    - matcher: "Edit|Write|Bash"
  1302	      hooks:
  1303	        - type: command
  1304	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/some-other-thing.sh"
  1305	YAML
  1306	gw_case attack 1 "MISSING:Edit,Write,Bash" "the guard attached to 'Read' while ANOTHER command holds 'Edit|Write|Bash' does NOT cover the write path (the reproduced [P1]: pre-fix this file kept the suite at rc=0, 135 pass)"
  1307	
