  1332	  PreToolUse:
  1333	    - matcher: "Edit|Write|Bash|Read"
  1334	      hooks:
  1335	        - type: command
  1336	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1337	YAML
  1338	gw_case superset 1 COVERS "matcher 'Edit|Write|Bash|Read' COVERS (a superset is still coverage)"
  1339	
  1340	# --- 73e: the guard split across TWO entries. Coverage is the UNION over
  1341	# guard-carrying entries, so this is legitimate wiring and must pass.
  1342	fx split <<'YAML'
