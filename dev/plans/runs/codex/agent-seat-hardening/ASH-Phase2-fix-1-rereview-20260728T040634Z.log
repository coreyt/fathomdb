  1367	
  1368	fx bashonly <<'YAML'
  1369	hooks:
  1370	  PreToolUse:
  1371	    - matcher: "Bash"
  1372	      hooks:
  1373	        - type: command
  1374	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1375	YAML
  1376	gw_case bashonly 1 "MISSING:Edit,Write" "matcher 'Bash' alone leaves Edit and Write uncovered"
  1377	
  1378	# --- 73h: no guard-carrying entry at all, though PreToolUse hooks exist. The
  1379	# unwired state arms 67/68 must catch.
