  1394	  PreToolUse:
  1395	    - matcher: "Edit|Write|Bash"
  1396	      hooks:
  1397	        - type: command
  1398	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/nope/seat-path-guard.sh"
  1399	YAML
  1400	read_guard_wiring "$TMPROOT/fx-missing.md"
  1401	if [ "$GW_RC" -eq 0 ] && [ "$GW_COUNT" = 1 ] && [ "$GW_COVERAGE" = COVERS ] &&
  1402	  [ -n "$GW_INERT" ] && [ -n "$GW_WRONG_TARGET" ] && [ -z "$GW_UNANCHORED" ]; then
