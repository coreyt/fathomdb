  1347	        - type: command
  1348	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1349	    - matcher: "Bash"
  1350	      hooks:
  1351	        - type: command
  1352	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/seat-path-guard.sh"
  1353	YAML
  1354	gw_case split 2 COVERS "the guard split across two entries ('Edit|Write' + 'Bash') COVERS by union"
  1355	
