  1381	hooks:
  1382	  PreToolUse:
  1383	    - matcher: "Edit|Write|Bash"
  1384	      hooks:
  1385	        - type: command
  1386	          command: "${CLAUDE_PROJECT_DIR}/.claude/hooks/some-other-thing.sh"
  1387	YAML
  1388	gw_case unwired 0 "MISSING:Edit,Write,Bash" "a PreToolUse hook that is NOT the guard yields ZERO guard-carrying entries"
  1389	
  1390	# --- 73i: the guard wired to a path that does not exist. Coverage is perfect;
  1391	# the wiring is inert. Arm 70's stat is what has to fire, bound to this entry.
  1392	fx missing <<'YAML'
