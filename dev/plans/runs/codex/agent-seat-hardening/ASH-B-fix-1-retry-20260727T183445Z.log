  # redirection for scanning purposes, so the fold is lossless here. It runs
504
  # before the `||` fold too: in valid shell a `>|` can never be half of a `||`.
505
  stripped="${stripped//>|/>}"
506
  stripped="${stripped//&&/$'\n'}"
507
  stripped="${stripped//||/$'\n'}"
508
  stripped="${stripped//;/$'\n'}"
509
  stripped="${stripped//|/$'\n'}"
510
  stripped="${stripped//&/$'\n'}"
511
  stripped="${stripped//(/$'\n'}"
512
  stripped="${stripped//)/$'\n'}"
513

514
  while IFS= read -r line || [ -n "$line" ]; do
515
    [ -n "$line" ] || continue
516
    scan_simple_command "$line"
517
  done <<<"$stripped"
518
}
