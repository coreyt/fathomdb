# --------------------------------------------------------------------------
227
strip_heredocs() {
228
  local line delim="" trimmed
229
  while IFS= read -r line || [ -n "$line" ]; do
230
    if [ -n "$delim" ]; then
231
      trimmed="${line#"${line%%[![:space:]]*}"}"
232
      trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
233
      if [ "$trimmed" = "$delim" ]; then delim=""; fi
234
      continue
235
    fi
236
    if [[ "$line" =~ \<\<-?[[:space:]]*[\'\"]?([A-Za-z_][A-Za-z0-9_]*)[\'\"]? ]]; then
237
      delim="${BASH_REMATCH[1]}"
238
    fi
239
    printf '%s\n' "$line"
240
  done

